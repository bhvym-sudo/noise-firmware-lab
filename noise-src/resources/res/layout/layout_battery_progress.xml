<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/container"
    android:background="@drawable/circle_battery"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">
    <com.google.android.material.imageview.ShapeableImageView
        android:id="@+id/backProgress"
        android:layout_width="52dp"
        android:layout_height="52dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:shapeAppearance="@style/ShapeAppearance.App.CircleImageView"/>
    <com.google.android.material.progressindicator.CircularProgressIndicator
        android:id="@+id/batteryStatus"
        android:saveEnabled="false"
        android:layout_width="52dp"
        android:layout_height="52dp"
        android:progress="0"
        android:indeterminate="false"
        app:indicatorColor="#4b906f"
        app:indicatorSize="42dp"
        app:layout_constraintBottom_toBottomOf="@+id/backProgress"
        app:layout_constraintEnd_toEndOf="@+id/backProgress"
        app:layout_constraintStart_toStartOf="@+id/backProgress"
        app:layout_constraintTop_toTopOf="@+id/backProgress"
        app:trackColor="#d9d9d9"
        app:trackThickness="1.5dp"/>
    <TextView
        android:textColor="#604a47"
        android:id="@+id/tvBattery"
        android:saveEnabled="false"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="@+id/batteryStatus"
        app:layout_constraintEnd_toEndOf="@+id/batteryStatus"
        app:layout_constraintStart_toStartOf="@+id/batteryStatus"
        app:layout_constraintTop_toTopOf="@+id/batteryStatus"
        style="@style/H6"/>
</androidx.constraintlayout.widget.ConstraintLayout>
