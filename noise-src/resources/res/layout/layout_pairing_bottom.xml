<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <com.noise.audio.customviews.NoiseButtonView
        android:enabled="false"
        android:textSize="16sp"
        android:textColor="@color/black"
        android:gravity="center"
        android:id="@+id/btnContinue"
        android:background="@drawable/round_corner_action_pairing"
        android:layout_width="match_parent"
        android:layout_height="68dp"
        android:layout_marginLeft="12dp"
        android:layout_marginRight="12dp"
        android:layout_marginBottom="30dp"
        android:text="@string/text_setup_this_device"
        android:textAllCaps="true"
        android:layout_marginHorizontal="12dp"
        app:layout_constraintBottom_toTopOf="@+id/textNotConnecting"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:textAllCaps="true"
        style="@style/RobotoMonoRegular"/>
    <TextView
        android:textColor="#212426"
        android:id="@+id/textNotConnecting"
        android:paddingLeft="4dp"
        android:paddingTop="2dp"
        android:paddingRight="4dp"
        android:paddingBottom="2dp"
        android:visibility="invisible"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/dimen_4dp"
        android:text="@string/text_device_still_not_connecting"
        android:textAllCaps="true"
        android:paddingHorizontal="4dp"
        android:paddingVertical="2dp"
        app:layout_constraintBottom_toTopOf="@+id/tvGetHelp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        style="@style/RobotoMonoRegular"/>
    <TextView
        android:textColor="#212427"
        android:id="@+id/tvGetHelp"
        android:padding="@dimen/dimen_4dp"
        android:paddingLeft="4dp"
        android:paddingTop="2dp"
        android:paddingRight="4dp"
        android:paddingBottom="2dp"
        android:visibility="invisible"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="34dp"
        android:text="@string/text_get_help"
        android:textAllCaps="true"
        android:paddingHorizontal="4dp"
        android:paddingVertical="2dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        style="@style/RobotoMonoMedium"/>
</androidx.constraintlayout.widget.ConstraintLayout>
