<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/bg_different_setting_layout"
    android:padding="4dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <include
        android:id="@+id/lytOffSetting"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/lytHeadTrackingSetting"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        layout="@layout/item_setting_layout"/>
    <include
        android:id="@+id/lytHeadTrackingSetting"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/lytFixedSetting"
        app:layout_constraintStart_toEndOf="@+id/lytOffSetting"
        app:layout_constraintTop_toTopOf="parent"
        layout="@layout/item_setting_layout"/>
    <include
        android:id="@+id/lytFixedSetting"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/lytHeadTrackingSetting"
        app:layout_constraintTop_toTopOf="parent"
        layout="@layout/item_setting_layout"/>
</androidx.constraintlayout.widget.ConstraintLayout>
