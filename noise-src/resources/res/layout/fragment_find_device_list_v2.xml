<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:tag="layout/fragment_find_device_list_v2_0"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/scanContent"
        android:tag="binding_1"
        android:background="@color/white"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <com.airbnb.lottie.LottieAnimationView
            android:id="@+id/animBack"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop"
            android:elevation="-4dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:lottie_autoPlay="true"
            app:lottie_loop="true"
            app:lottie_rawRes="@raw/anim_scanning_ripple_white"/>
        <ImageView
            android:id="@+id/ivBack"
            android:padding="@dimen/dimen_8dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="0x7f080244"
            android:layout_marginStart="20dp"
            app:layout_constraintBottom_toBottomOf="@+id/tvScanning"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="@+id/tvScanning"/>
        <TextView
            android:textSize="24sp"
            android:textStyle="normal"
            android:textColor="#43555e"
            android:gravity="center_horizontal"
            android:id="@+id/tvScanning"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:text="@string/text_scanning"
            android:lineSpacingExtra="3sp"
            android:textAllCaps="true"
            android:letterSpacing="-0.01"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            style="@style/ClashDisplayVariableSemiBold"/>
        <TextView
            android:textSize="12sp"
            android:textColor="#4c5252"
            android:gravity="center_horizontal"
            android:id="@+id/tvDeviceCount"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:letterSpacing="0.02"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tvScanning"
            style="@style/RobotoMonoRegular"/>
        <include
            android:id="@+id/toastPill"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tvDeviceCount"
            layout="@layout/layout_toast_pill"/>
        <TextView
            android:textSize="14sp"
            android:textColor="#42454a"
            android:ellipsize="end"
            android:gravity="center_horizontal"
            android:id="@+id/noiseTextView"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginLeft="32dp"
            android:layout_marginTop="8dp"
            android:layout_marginRight="32dp"
            android:maxLines="5"
            android:textAllCaps="true"
            android:letterSpacing="0.02"
            android:layout_marginHorizontal="32dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tvScanning"
            style="@style/RobotoMonoRegular"/>
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:id="@+id/layoutSignalStrength"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="44dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/toastPill">
            <TextView
                android:textSize="12sp"
                android:textColor="#4c5252"
                android:gravity="center"
                android:id="@+id/tvSignalStrength"
                android:layout_width="wrap_content"
                android:layout_height="16dp"
                android:text="@string/text_signal_strength"
                style="@style/RobotoMonoRegular"/>
            <FrameLayout
                android:layout_width="13dp"
                android:layout_height="16dp"
                android:layout_marginStart="6dp">
                <ImageView
                    android:id="@+id/ivSignalStrength"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_margin="1dp"
                    android:scaleType="fitCenter"
                    android:contentDescription="@string/text_signal_strength"/>
            </FrameLayout>
        </LinearLayout>
        <ImageView
            android:id="@+id/imgLogo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/noise_white_logo"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <androidx.constraintlayout.widget.Barrier
            android:id="@+id/barrierAboveViewPager"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:barrierDirection="bottom"
            app:constraint_referenced_ids="layoutSignalStrength,noiseTextView"/>
        <androidx.viewpager2.widget.ViewPager2
            android:id="@+id/rvDevices"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            app:layout_constraintBottom_toTopOf="@+id/bottomInfoGroup"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/barrierAboveViewPager"/>
        <LinearLayout
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:id="@+id/bottomInfoGroup"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:layout_constraintBottom_toTopOf="@+id/continueButton"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent">
            <TextView
                android:textSize="24sp"
                android:textColor="#43555e"
                android:gravity="center_horizontal"
                android:id="@+id/tvDeviceName"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="32dp"
                android:layout_marginRight="32dp"
                android:maxLines="2"
                android:lineSpacingExtra="3sp"
                android:textAllCaps="true"
                android:letterSpacing="-0.01"
                android:layout_marginHorizontal="32dp"
                style="@style/ClashDisplayVariableSemiBold"/>
            <TextView
                android:textSize="12sp"
                android:textColor="#212426"
                android:gravity="center"
                android:id="@+id/tvMac"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="@dimen/dimen_16dp"
                android:layout_marginTop="4dp"
                android:layout_marginRight="@dimen/dimen_16dp"
                android:layout_marginHorizontal="@dimen/dimen_16dp"
                style="@style/RobotoMonoRegular"/>
            <com.google.android.material.tabs.TabLayout
                android:id="@+id/tabLayout"
                android:background="@android:color/transparent"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="2dp"
                android:layout_marginTop="57dp"
                app:tabBackground="@drawable/tab_selector"
                app:tabGravity="center"
                app:tabIndicatorFullWidth="false"
                app:tabIndicatorHeight="0dp"/>
        </LinearLayout>
        <com.noise.audio.customviews.NoiseButtonView
            android:textSize="14sp"
            android:textColor="@color/white"
            android:gravity="center"
            android:id="@+id/continueButton"
            android:background="@drawable/round_corner_continue_button"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginLeft="16dp"
            android:layout_marginRight="16dp"
            android:layout_marginBottom="80dp"
            android:text="@string/text_connect"
            android:textAllCaps="true"
            android:elevation="0dp"
            android:stateListAnimator="@null"
            android:backgroundTint="@null"
            android:layout_marginHorizontal="16dp"
            app:backgroundTint="@null"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:textAllCaps="true"
            style="@style/RobotoMonoRegular"/>
        <TextView
            android:textSize="12sp"
            android:textColor="#212426"
            android:gravity="center"
            android:id="@+id/tvCantFindLabel"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/text_cant_find_your_device"
            android:textAllCaps="true"
            android:letterSpacing="0.02"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/continueButton"
            style="@style/RobotoMonoRegular"/>
        <TextView
            android:textSize="12sp"
            android:textColor="#212427"
            android:gravity="center"
            android:id="@+id/tvScanAgainLink"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/text_scan_again"
            android:textAllCaps="true"
            android:letterSpacing="0.02"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tvCantFindLabel"
            style="@style/RobotoMonoMedium"/>
        <include
            android:id="@+id/progressBar"
            android:visibility="gone"
            layout="@layout/default_loader"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <include
        android:id="@+id/noDeviceFound"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        layout="@layout/layout_no_device_found"/>
</FrameLayout>
