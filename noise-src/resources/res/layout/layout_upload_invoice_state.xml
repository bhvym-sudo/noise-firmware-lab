<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <TextView
        android:textSize="@dimen/text_14sp"
        android:textColor="#42454a"
        android:id="@+id/tvUploadInvoice"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="@string/text_upload_invoice"
        android:textAllCaps="true"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/RobotoMonoRegular"/>
    <com.google.android.material.imageview.ShapeableImageView
        android:id="@+id/ivUploadIcon"
        android:layout_width="64dp"
        android:layout_height="64dp"
        android:layout_marginTop="8dp"
        android:src="@drawable/ic_upload_icon"
        android:scaleType="centerCrop"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tvUploadInvoice"
        app:shapeAppearanceOverlay="@style/ShapeAppearanceOverlay.App.CornerSize16dp"/>
    <TextView
        android:textSize="@dimen/text_12sp"
        android:textColor="#898e95"
        android:id="@+id/tvSupportFileType"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="@string/text_supported_file_types_npdf_jpg_png_up_to_5mb"
        android:textDirection="locale"
        android:layout_marginStart="8dp"
        app:layout_constraintBottom_toBottomOf="@+id/ivUploadIcon"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/ivUploadIcon"
        app:layout_constraintTop_toTopOf="@+id/ivUploadIcon"
        style="@style/RobotoMonoRegular"/>
    <TextView
        android:textSize="14sp"
        android:textColor="#302f2d"
        android:ellipsize="end"
        android:id="@+id/tvInvoiceName"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dimen_16dp"
        android:maxLines="2"
        android:layout_marginStart="8dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/ivUploadIcon"
        app:layout_constraintTop_toTopOf="@+id/ivUploadIcon"
        style="@style/ClashDisplayVariableMedium"/>
    <TextView
        android:textSize="12sp"
        android:textColor="#898e95"
        android:id="@+id/tvFileType"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:layout_marginStart="8dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/ivUploadIcon"
        app:layout_constraintTop_toBottomOf="@+id/tvInvoiceName"
        style="@style/RobotoMonoRegular"/>
    <TextView
        android:textSize="@dimen/text_14sp"
        android:textColor="#090909"
        android:id="@+id/tvDonthaveInvoice"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="@string/text_don_t_have_an_invoice"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/ivUploadIcon"
        style="@style/RobotoMonoRegular"/>
</androidx.constraintlayout.widget.ConstraintLayout>
