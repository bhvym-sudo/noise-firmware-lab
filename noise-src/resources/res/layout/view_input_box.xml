<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <TextView
        android:textSize="14sp"
        android:textColor="#42454a"
        android:id="@+id/text_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textAllCaps="true"
        android:letterSpacing="0.02"
        style="@style/RobotoMonoRegular"/>
    <LinearLayout
        android:gravity="center"
        android:background="@drawable/back_card_v2"
        android:padding="16dp"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:layout_marginTop="8dp">
        <EditText
            android:textSize="22sp"
            android:textColor="@color/text_color_default"
            android:textColorHint="@color/hint_color_default"
            android:gravity="center_vertical"
            android:id="@+id/edit_text"
            android:background="@color/transparent"
            android:layout_width="0dp"
            android:layout_height="64dp"
            android:hint="@string/text_start_typing"
            android:maxLength="50"
            android:layout_weight="1"
            android:textCursorDrawable="@drawable/custom_cursor"
            android:letterSpacing="-0.01"
            style="@style/ClashDisplayVariableMedium"/>
    </LinearLayout>
</LinearLayout>
