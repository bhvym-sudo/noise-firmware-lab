<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.core.widget.NestedScrollView
        android:id="@+id/scrollViewMain"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <LinearLayout
            android:orientation="vertical"
            android:paddingBottom="112dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <include
                android:id="@+id/lytHeader"
                layout="@layout/layout_settings_header"/>
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardProfile"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="16dp"
                android:layout_marginTop="16dp"
                android:layout_marginRight="16dp"
                android:layout_marginHorizontal="16dp"
                app:cardBackgroundColor="#f7f7f7"
                app:cardCornerRadius="18dp"
                app:cardElevation="0dp"
                app:strokeColor="@color/transparent"
                app:strokeWidth="0dp">
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:paddingLeft="16dp"
                    android:paddingTop="14dp"
                    android:paddingRight="16dp"
                    android:paddingBottom="14dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingHorizontal="16dp"
                    android:paddingVertical="14dp">
                    <FrameLayout
                        android:id="@+id/flProfileAvatar"
                        android:background="@drawable/ic_ring_v2"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent">
                        <ImageView
                            android:id="@+id/ivProfileImage"
                            android:padding="1dp"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:src="@drawable/ic_sign_in_card_icon"
                            android:scaleType="centerCrop"/>
                        <TextView
                            android:textSize="18sp"
                            android:textColor="#43555e"
                            android:layout_gravity="center"
                            android:id="@+id/tvProfileInitial"
                            android:visibility="gone"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="A"
                            style="@style/ClashDisplayVariableSemiBold"/>
                    </FrameLayout>
                    <TextView
                        android:textSize="16sp"
                        android:textColor="#43555e"
                        android:ellipsize="end"
                        android:id="@+id/tvProfileName"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:maxLines="1"
                        android:textDirection="locale"
                        android:layout_marginStart="12dp"
                        android:layout_marginEnd="8dp"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toStartOf="@+id/ivProfileArrow"
                        app:layout_constraintStart_toEndOf="@+id/flProfileAvatar"
                        app:layout_constraintTop_toTopOf="parent"
                        style="@style/ClashDisplayVariableMedium"/>
                    <ImageView
                        android:id="@+id/ivProfileArrow"
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:src="@drawable/ic_right_blue_arrow"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        app:tint="#54656d"/>
                </androidx.constraintlayout.widget.ConstraintLayout>
            </com.google.android.material.card.MaterialCardView>
            <TextView
                android:textSize="14sp"
                android:textColor="#42454a"
                android:id="@+id/tvDeviceSection"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="32dp"
                android:text="@string/text_device_section"
                android:textAllCaps="true"
                android:layout_marginStart="34dp"
                style="@style/RobotoMonoRegular"/>
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardDevice"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="16dp"
                android:layout_marginTop="8dp"
                android:layout_marginRight="16dp"
                android:layout_marginHorizontal="16dp"
                app:cardBackgroundColor="#f7f7f7"
                app:cardCornerRadius="18dp"
                app:cardElevation="0dp"
                app:strokeColor="@color/transparent"
                app:strokeWidth="0dp">
                <LinearLayout
                    android:orientation="vertical"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <include
                        android:id="@+id/itemHelpSupport"
                        layout="@layout/item_settings_list_row"/>
                    <include
                        android:id="@+id/itemFirmwareUpdate"
                        layout="@layout/item_settings_list_row"/>
                    <include
                        android:id="@+id/itemReviewAndEarn"
                        layout="@layout/item_settings_list_row"/>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
            <TextView
                android:textSize="14sp"
                android:textColor="#42454a"
                android:id="@+id/tvAppSection"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="32dp"
                android:text="@string/text_app_section"
                android:textAllCaps="true"
                android:layout_marginStart="34dp"
                style="@style/RobotoMonoRegular"/>
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardApp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="16dp"
                android:layout_marginTop="8dp"
                android:layout_marginRight="16dp"
                android:layout_marginHorizontal="16dp"
                app:cardBackgroundColor="#f7f7f7"
                app:cardCornerRadius="18dp"
                app:cardElevation="0dp"
                app:strokeColor="@color/transparent"
                app:strokeWidth="0dp">
                <LinearLayout
                    android:orientation="vertical"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <include
                        android:id="@+id/itemAppLanguage"
                        layout="@layout/item_settings_list_row"/>
                    <include
                        android:id="@+id/itemBackgroundProtection"
                        layout="@layout/item_settings_list_row"/>
                    <include
                        android:id="@+id/itemManagePermissions"
                        layout="@layout/item_settings_list_row"/>
                    <include
                        android:id="@+id/itemAppUpdate"
                        layout="@layout/item_settings_list_row"/>
                    <include
                        android:id="@+id/itemRequestFeature"
                        android:visibility="gone"
                        android:layout_width="match_parent"
                        android:layout_height="72dp"
                        layout="@layout/item_settings_list_row"/>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
            <TextView
                android:textSize="@dimen/text_14sp"
                android:textStyle="bold"
                android:textColor="#bb1515"
                android:gravity="center"
                android:id="@+id/tvForgetDevice"
                android:background="@drawable/back_forgot_device"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginLeft="16dp"
                android:layout_marginTop="12dp"
                android:layout_marginRight="16dp"
                android:text="@string/text_forget_this_device"
                android:textAllCaps="true"
                android:layout_marginHorizontal="16dp"
                style="@style/RobotoMonoMedium"/>
            <LinearLayout
                android:gravity="center"
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="36dp">
                <TextView
                    android:textSize="12sp"
                    android:textColor="#232726"
                    android:id="@+id/tvPrivacyPolicy"
                    android:padding="6dp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/text_privacy_policy"
                    android:textAllCaps="true"
                    style="@style/RobotoMonoMedium"/>
                <View
                    android:layout_width="24dp"
                    android:layout_height="0dp"/>
                <TextView
                    android:textSize="12sp"
                    android:textColor="#232726"
                    android:id="@+id/tvTermsCondition"
                    android:padding="6dp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/text_terms_and_conditions"
                    android:textAllCaps="true"
                    style="@style/RobotoMonoMedium"/>
            </LinearLayout>
            <TextView
                android:textSize="12sp"
                android:textColor="#9ca0a6"
                android:gravity="center"
                android:id="@+id/tvAppVersion"
                android:padding="6dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                style="@style/RobotoMonoRegular"/>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
    <include
        android:id="@+id/progressBar"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        layout="@layout/default_loader"/>
</androidx.constraintlayout.widget.ConstraintLayout>
