<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layoutDirection="ltr">
    <ImageView
        android:id="@+id/imvBudsBg"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:src="@drawable/ic_home_buds_bg_img"
        app:layout_constraintDimensionRatio="1:1"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <View
        android:id="@+id/view2"
        android:layout_width="1dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <ImageView
        android:id="@+id/imvDevice"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="@+id/imvBudsBg"
        app:layout_constraintDimensionRatio="1:1"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/imvBudsBg"
        app:layout_constraintWidth_percent="0.73"/>
    <TextView
        android:textSize="34dp"
        android:textStyle="normal"
        android:textColor="#54656d"
        android:ellipsize="end"
        android:gravity="center"
        android:id="@+id/tvName"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="78dp"
        android:layout_marginLeft="@dimen/dimen_16dp"
        android:layout_marginRight="@dimen/dimen_16dp"
        android:maxLines="2"
        android:minLines="2"
        android:letterSpacing="0.01"
        android:layout_marginHorizontal="@dimen/dimen_16dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/imvBudsBg"
        style="@style/ClashDisplayVariableMedium"/>
    <TextView
        android:textSize="14sp"
        android:textColor="#ffffff"
        android:gravity="center"
        android:id="@+id/tvReconnect"
        android:background="@drawable/bg_reconnect_button"
        android:visibility="gone"
        android:layout_width="212dp"
        android:layout_height="52dp"
        android:layout_marginLeft="@dimen/dimen_16dp"
        android:layout_marginRight="@dimen/dimen_16dp"
        android:text="@string/text_reconnect"
        android:textAllCaps="true"
        android:backgroundTint="#000000"
        android:layout_marginHorizontal="@dimen/dimen_16dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        style="@style/RobotoMonoRegular"/>
    <ImageView
        android:id="@+id/imvLeftBud"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:adjustViewBounds="true"
        android:layout_marginEnd="24dp"
        app:layout_constraintBottom_toBottomOf="@+id/imvBudsBg"
        app:layout_constraintEnd_toStartOf="@+id/view2"
        app:layout_constraintTop_toTopOf="@+id/imvBudsBg"
        app:layout_constraintWidth_percent="0.28"/>
    <ImageView
        android:id="@+id/imvRightBud"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:adjustViewBounds="true"
        android:layout_marginStart="@dimen/dimen_24dp"
        app:layout_constraintBottom_toBottomOf="@+id/imvBudsBg"
        app:layout_constraintHorizontal_bias="0.5"
        app:layout_constraintStart_toEndOf="@+id/view2"
        app:layout_constraintTop_toTopOf="@+id/imvBudsBg"
        app:layout_constraintWidth_percent="0.28"/>
    <LinearLayout
        android:gravity="center"
        android:orientation="horizontal"
        android:id="@+id/lytBattery"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:layoutDirection="ltr"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/imvBudsBg">
        <include
            android:id="@+id/lytLeftBattery"
            android:visibility="invisible"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="@dimen/dimen_8dp"
            layout="@layout/layout_battery_progress"/>
        <include
            android:id="@+id/lytCaseBattery"
            android:visibility="gone"
            android:layout_width="50dp"
            android:layout_height="52dp"
            layout="@layout/layout_case_battery_progress"/>
        <include
            android:id="@+id/lytCaseBattery2"
            android:visibility="gone"
            android:layout_width="88dp"
            android:layout_height="52dp"
            layout="@layout/layout_case_battery_progress_2"/>
        <include
            android:id="@+id/lytRightBattery"
            android:visibility="invisible"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/dimen_8dp"
            layout="@layout/layout_battery_progress"/>
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
