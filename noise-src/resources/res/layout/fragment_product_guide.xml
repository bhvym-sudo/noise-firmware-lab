<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:paddingBottom="24dp"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:paddingStart="12dp"
    android:paddingEnd="12dp">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:id="@+id/lytContent"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginBottom="24dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <TextView
            android:textSize="@dimen/text_24sp"
            android:textStyle="bold"
            android:textColor="#43555e"
            android:id="@+id/text_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="@string/text_product_tips"
            android:textAllCaps="true"
            android:textAlignment="center"
            android:layout_marginEnd="8dp"
            app:layout_constraintEnd_toStartOf="@+id/lytAssetsIndicator"
            app:layout_constraintStart_toEndOf="@+id/img_back"
            app:layout_constraintTop_toTopOf="parent"
            style="@style/ClashDisplayVariableMedium"/>
        <include
            android:id="@+id/lytAssetsIndicator"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintBottom_toBottomOf="@+id/text_title"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@+id/text_title"
            layout="@layout/layout_assets_download_indicator"/>
        <ImageView
            android:id="@+id/img_back"
            android:padding="2dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:src="@drawable/ic_navigation_back_icon"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:tint="@color/back_arrow_color"/>
        <androidx.viewpager2.widget.ViewPager2
            android:id="@+id/pager"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="16dp"
            android:layout_marginVertical="16dp"
            app:layout_constraintDimensionRatio="H,1:1"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/text_title"/>
        <com.google.android.material.tabs.TabLayout
            android:id="@+id/tabLayout"
            android:background="@android:color/transparent"
            android:visibility="visible"
            android:layout_width="wrap_content"
            android:layout_height="2dp"
            android:layout_marginTop="12dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/pager"
            app:tabBackground="@drawable/tab_selector"
            app:tabGravity="center"
            app:tabIndicatorFullWidth="false"
            app:tabIndicatorHeight="0dp"/>
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recycler_view"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tabLayout"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="48dp"
        app:layout_constraintTop_toBottomOf="@+id/lytContent">
        <com.noise.audio.customviews.NoiseImageButton
            android:id="@+id/btn_noise_control"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            app:drawable="0x7f08030f"
            app:layout_constraintEnd_toStartOf="@+id/btn_music_control"
            app:layout_constraintHorizontal_bias="0.5"
            app:layout_constraintHorizontal_chainStyle="spread_inside"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:selected="false"
            app:selected_drawable="0x7f080310"
            app:show_title="true"
            app:text="@string/text_noise_control_2"/>
        <com.noise.audio.customviews.NoiseImageButton
            android:id="@+id/btn_music_control"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            app:drawable="0x7f0802fa"
            app:layout_constraintEnd_toStartOf="@+id/btn_assistant"
            app:layout_constraintHorizontal_bias="0.5"
            app:layout_constraintStart_toEndOf="@+id/btn_noise_control"
            app:layout_constraintTop_toTopOf="@+id/btn_noise_control"
            app:selected="false"
            app:selected_drawable="0x7f0802fc"
            app:show_title="true"
            app:text="@string/text_music_control_2"/>
        <com.noise.audio.customviews.NoiseImageButton
            android:id="@+id/btn_assistant"
            android:visibility="gone"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            app:drawable="0x7f08023a"
            app:layout_constraintEnd_toStartOf="@+id/btn_phone_call"
            app:layout_constraintHorizontal_bias="0.5"
            app:layout_constraintStart_toEndOf="@+id/btn_music_control"
            app:layout_constraintTop_toTopOf="@+id/btn_music_control"
            app:selected="false"
            app:selected_drawable="0x7f08023b"
            app:show_title="true"
            app:text="@string/text_assistant_2"/>
        <com.noise.audio.customviews.NoiseImageButton
            android:id="@+id/btn_phone_call"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            app:drawable="0x7f080323"
            app:layout_constraintEnd_toStartOf="@+id/btn_charging_buds"
            app:layout_constraintHorizontal_bias="0.5"
            app:layout_constraintStart_toEndOf="@+id/btn_assistant"
            app:layout_constraintTop_toTopOf="@+id/btn_music_control"
            app:selected="false"
            app:selected_drawable="0x7f080324"
            app:show_title="true"
            app:text="@string/text_phone_call_2"/>
        <com.noise.audio.customviews.NoiseImageButton
            android:id="@+id/btn_charging_buds"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            app:drawable="0x7f08026b"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_bias="0.5"
            app:layout_constraintStart_toEndOf="@+id/btn_phone_call"
            app:layout_constraintTop_toTopOf="@+id/btn_phone_call"
            app:selected="false"
            app:selected_drawable="0x7f08026c"
            app:show_title="true"
            app:text="@string/text_charging_2"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
