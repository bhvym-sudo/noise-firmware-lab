<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:padding="16dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <ImageView
        android:id="@+id/ivAction"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_marginTop="2dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textSize="16sp"
        android:textColor="#54656d"
        android:id="@+id/tvTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        app:layout_constraintBottom_toTopOf="@+id/tvCommandName"
        app:layout_constraintStart_toEndOf="@+id/ivAction"
        app:layout_constraintTop_toTopOf="@+id/ivAction"
        style="@style/ClashDisplayVariableMedium"/>
    <TextView
        android:textSize="12sp"
        android:textColor="#879399"
        android:ellipsize="end"
        android:id="@+id/tvCommandName"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:singleLine="true"
        android:textAllCaps="true"
        android:textDirection="locale"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="8dp"
        app:layout_constraintBottom_toBottomOf="@+id/ivAction"
        app:layout_constraintEnd_toStartOf="@+id/imvNext"
        app:layout_constraintStart_toEndOf="@+id/ivAction"
        app:layout_constraintTop_toBottomOf="@+id/tvTitle"
        style="@style/RobotoMonoRegular"/>
    <ImageView
        android:id="@+id/imvNext"
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:src="@drawable/ic_right_blue_arrow"
        android:layout_marginEnd="16dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:tint="#54656d"/>
</androidx.constraintlayout.widget.ConstraintLayout>
