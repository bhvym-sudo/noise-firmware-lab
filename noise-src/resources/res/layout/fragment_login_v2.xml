<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="#061313"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ImageView
        android:id="@+id/bgImage1"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:src="0x7f0802e9"
        android:scaleType="centerCrop"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <ImageView
        android:id="@+id/bgImage2"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:src="0x7f0802e8"
        android:scaleType="centerCrop"
        android:alpha="0"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <ImageView
        android:id="@+id/bottomGradient"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:src="0x7f0802e7"
        android:scaleType="fitXY"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>
    <TextView
        android:textSize="36sp"
        android:textColor="@color/white"
        android:gravity="center"
        android:id="@+id/textCreateAccount3"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="@string/text_experience"
        android:alpha="0.65"
        android:textAllCaps="true"
        app:layout_constraintBottom_toTopOf="@+id/textCreateAccount2"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        style="@style/ClashDisplayVariableSemiBold"/>
    <TextView
        android:textSize="36sp"
        android:textColor="@color/white"
        android:gravity="center"
        android:id="@+id/textCreateAccount2"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="@string/text_pure_audio"
        android:alpha="0.8"
        android:textAllCaps="true"
        app:layout_constraintBottom_toTopOf="@+id/textCreateAccount"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        style="@style/ClashDisplayVariableSemiBold"/>
    <TextView
        android:textSize="36sp"
        android:textColor="@color/white"
        android:gravity="center"
        android:id="@+id/textCreateAccount"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginBottom="30dp"
        android:text="@string/text_your_way"
        android:textAllCaps="true"
        app:layout_constraintBottom_toTopOf="@+id/tvLoginWith"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        style="@style/ClashDisplayVariableSemiBold"/>
    <TextView
        android:textSize="14sp"
        android:textColor="#ffffff"
        android:id="@+id/tvLoginWith"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="30dp"
        android:layout_marginBottom="14dp"
        android:text="@string/text_login_with"
        android:alpha="0.8"
        app:layout_constraintBottom_toTopOf="@+id/imageGoogleLogin"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        style="@style/ClashDisplayVariableMedium"/>
    <ImageView
        android:id="@+id/imageGoogleLogin"
        android:background="@drawable/google_and_email_icon_bg"
        android:paddingLeft="50dp"
        android:paddingTop="18dp"
        android:paddingRight="50dp"
        android:paddingBottom="18dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="14dp"
        android:src="@drawable/ic_goggle_icon"
        android:contentDescription="Google login"
        android:layout_marginEnd="12dp"
        android:paddingHorizontal="50dp"
        android:paddingVertical="18dp"
        app:layout_constraintBottom_toTopOf="@+id/textOr"
        app:layout_constraintEnd_toStartOf="@+id/imageEmailLogin"
        app:layout_constraintHorizontal_chainStyle="packed"
        app:layout_constraintStart_toStartOf="parent"/>
    <ImageView
        android:id="@+id/imageEmailLogin"
        android:background="@drawable/google_and_email_icon_bg"
        android:paddingLeft="50dp"
        android:paddingTop="20dp"
        android:paddingRight="50dp"
        android:paddingBottom="20dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="14dp"
        android:src="@drawable/ic_email_icon"
        android:contentDescription="Email login"
        android:paddingHorizontal="50dp"
        android:paddingVertical="20dp"
        app:layout_constraintBottom_toTopOf="@+id/textOr"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/imageGoogleLogin"/>
    <TextView
        android:textSize="14sp"
        android:textColor="#ffffff"
        android:id="@+id/textOr"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="30dp"
        android:text="@string/text_or"
        android:alpha="0.8"
        app:layout_constraintBottom_toTopOf="@+id/btn_continue"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        style="@style/ClashDisplayVariableMedium"/>
    <com.noise.audio.customviews.NoiseContinueButton2
        android:id="@+id/btn_continue"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="30dp"
        android:layout_marginStart="20dp"
        app:layout_constraintBottom_toTopOf="@+id/tvPrivacyText"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>
    <com.google.android.material.checkbox.MaterialCheckBox
        android:id="@+id/chbx"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="28dp"
        app:buttonIconTint="@color/checkbox_login_icon_tint"
        app:buttonTint="@color/checkbox_login_tint"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/tvPrivacyText"
        app:layout_constraintHorizontal_chainStyle="packed"
        app:layout_constraintStart_toStartOf="parent"/>
    <TextView
        android:textSize="10sp"
        android:textColor="#b2ffffff"
        android:id="@+id/tvPrivacyText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/text_i_have_read_and_accept_the_terms_of_service_privacy_policy"
        android:textAllCaps="false"
        app:layout_constraintBottom_toBottomOf="@+id/chbx"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/chbx"
        app:layout_constraintTop_toTopOf="@+id/chbx"
        style="@style/RobotoMonoRegular"/>
    <include
        android:id="@+id/lytLanguageSwitch"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/dimen_16dp"
        android:layout_marginRight="@dimen/dimen_16dp"
        android:layout_marginBottom="42dp"
        android:layout_marginHorizontal="@dimen/dimen_16dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        layout="@layout/layout_language_switch"/>
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@+id/lytLanguageSelector"
        android:background="@drawable/bg_language_selector_pill"
        android:paddingLeft="12dp"
        android:paddingTop="8dp"
        android:paddingRight="12dp"
        android:paddingBottom="8dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="48dp"
        android:layout_marginStart="16dp"
        android:elevation="4dp"
        android:paddingHorizontal="12dp"
        android:paddingVertical="8dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <ImageView
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:src="@drawable/ic_language_white"
            android:importantForAccessibility="no"/>
        <TextView
            android:textSize="14sp"
            android:textColor="@color/white"
            android:id="@+id/tvLanguageCode"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/clash_display_medium"
            android:layout_marginStart="6dp"/>
        <ImageView
            android:id="@+id/ivLanguageArrow"
            android:layout_width="10dp"
            android:layout_height="10dp"
            android:src="@drawable/ic_arrow_up_white"
            android:importantForAccessibility="no"
            android:layout_marginStart="4dp"/>
    </LinearLayout>
    <include
        android:id="@+id/progressBar"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        layout="@layout/default_loader"/>
</androidx.constraintlayout.widget.ConstraintLayout>
