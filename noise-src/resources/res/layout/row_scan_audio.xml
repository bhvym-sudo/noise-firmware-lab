<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="0x7f08013a"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.noise.audio.customviews.NoiseTextView
        android:textSize="14sp"
        android:textStyle="normal"
        android:textColor="@color/device_text_color"
        android:gravity="center_horizontal"
        android:id="@+id/tvDeviceFound"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="67dp"
        android:text="@string/text_device_found"
        android:textAllCaps="true"
        android:letterSpacing="0.06"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <com.noise.audio.customviews.NoiseTextView
        android:textSize="33sp"
        android:textColor="@color/title_color"
        android:gravity="center_horizontal"
        android:id="@+id/noiseTextView"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginLeft="32dp"
        android:layout_marginTop="16dp"
        android:layout_marginRight="32dp"
        android:maxLines="2"
        android:lineSpacingExtra="3sp"
        android:textAllCaps="true"
        android:letterSpacing="-0.01"
        android:layout_marginHorizontal="32dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tvDeviceFound"/>
    <TextView
        android:textColor="@color/black"
        android:id="@+id/tvMac"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dimen_8dp"
        app:layout_constraintEnd_toEndOf="@+id/noiseTextView"
        app:layout_constraintStart_toStartOf="@+id/noiseTextView"
        app:layout_constraintTop_toBottomOf="@+id/noiseTextView"
        style="@style/RobotoMonoRegular"/>
    <ImageView
        android:id="@+id/imvEarBuds"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="0x7f080093"
        android:adjustViewBounds="true"
        app:layout_constraintBottom_toTopOf="@+id/continue_button"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/noiseTextView"/>
    <com.noise.audio.customviews.NoiseButtonView
        android:textSize="16sp"
        android:textColor="@color/white"
        android:gravity="center"
        android:id="@+id/continue_button"
        android:background="@drawable/round_corner_continue_button"
        android:layout_width="match_parent"
        android:layout_height="68dp"
        android:layout_marginLeft="14dp"
        android:layout_marginRight="14dp"
        android:layout_marginBottom="26dp"
        android:text="@string/text_select_device"
        android:textAllCaps="true"
        android:layout_marginHorizontal="14dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:textAllCaps="true"/>
</androidx.constraintlayout.widget.ConstraintLayout>
