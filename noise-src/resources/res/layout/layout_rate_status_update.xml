<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:tag="layout/layout_rate_status_update_0"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <ImageView
        android:id="@+id/ivRUpload"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dimen_20dp"
        android:src="@drawable/ic_rate_checked_circle"
        app:layout_constraintEnd_toEndOf="@+id/tvReviewUpload"
        app:layout_constraintStart_toStartOf="@+id/tvReviewUpload"
        app:layout_constraintTop_toTopOf="parent"/>
    <View
        android:id="@+id/divider1"
        android:background="@drawable/line_with_green_round_edge"
        android:layout_width="0dp"
        android:layout_height="2dp"
        android:layout_marginLeft="@dimen/dimen_4dp"
        android:layout_marginRight="@dimen/dimen_4dp"
        android:layout_marginHorizontal="@dimen/dimen_4dp"
        app:layout_constraintBottom_toBottomOf="@+id/ivRUpload"
        app:layout_constraintEnd_toStartOf="@+id/ivVReview"
        app:layout_constraintStart_toEndOf="@+id/ivRUpload"
        app:layout_constraintTop_toTopOf="@+id/ivRUpload"/>
    <TextView
        android:textSize="@dimen/text_12sp"
        android:textColor="@color/rate_earn_green"
        android:gravity="center_horizontal"
        android:id="@+id/tvReviewUpload"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="@string/text_review_nuploaded"
        android:lineSpacingExtra="0sp"
        android:layout_marginStart="@dimen/dimen_16dp"
        android:letterSpacing="-0.03"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/ivRUpload"
        style="@style/RobotoMonoRegular"/>
    <ImageView
        android:id="@+id/ivVReview"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dimen_20dp"
        android:src="@drawable/rate_and_earn_uncheck_circle"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textSize="@dimen/text_12sp"
        android:textColor="@color/guide_title_color"
        android:gravity="center_horizontal"
        android:id="@+id/tvVerify"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="@string/text_verifying_nreview"
        android:lineSpacingExtra="0sp"
        android:letterSpacing="-0.03"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="@+id/ivVReview"
        app:layout_constraintStart_toStartOf="@+id/ivVReview"
        app:layout_constraintTop_toBottomOf="@+id/ivVReview"
        style="@style/RobotoMonoRegular"/>
    <View
        android:id="@+id/divider2"
        android:background="@drawable/line_with_round_edge"
        android:layout_width="0dp"
        android:layout_height="2dp"
        android:layout_marginLeft="@dimen/dimen_4dp"
        android:layout_marginRight="@dimen/dimen_4dp"
        android:layout_marginHorizontal="@dimen/dimen_4dp"
        app:layout_constraintBottom_toBottomOf="@+id/ivVReview"
        app:layout_constraintEnd_toStartOf="@+id/ivRAdded"
        app:layout_constraintStart_toEndOf="@+id/ivVReview"
        app:layout_constraintTop_toTopOf="@+id/ivVReview"/>
    <ImageView
        android:id="@+id/ivRAdded"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dimen_20dp"
        android:src="@drawable/rate_and_earn_uncheck_circle"
        app:layout_constraintEnd_toEndOf="@+id/tvRewardAdded"
        app:layout_constraintStart_toStartOf="@+id/tvRewardAdded"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textSize="@dimen/text_12sp"
        android:textColor="@color/guide_title_color"
        android:gravity="center_horizontal"
        android:id="@+id/tvRewardAdded"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="@string/text_rewards_nunlocked"
        android:lineSpacingExtra="0sp"
        android:layout_marginEnd="@dimen/dimen_16dp"
        android:letterSpacing="-0.03"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/ivRAdded"
        style="@style/RobotoMonoRegular"/>
</androidx.constraintlayout.widget.ConstraintLayout>
