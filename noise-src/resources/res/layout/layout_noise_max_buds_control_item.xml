<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <TextView
        android:textSize="10sp"
        android:textColor="@android:color/white"
        android:gravity="start"
        android:id="@+id/tvDisableMessage"
        android:background="@drawable/bg_bt_disabled"
        android:paddingLeft="12dp"
        android:paddingTop="24dp"
        android:paddingRight="12dp"
        android:paddingBottom="6dp"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="-18dp"
        android:text="@string/text_single_bud_anc_disable_message"
        android:paddingHorizontal="12dp"
        app:layout_constraintEnd_toEndOf="@+id/constraintLayout8"
        app:layout_constraintStart_toStartOf="@+id/constraintLayout8"
        app:layout_constraintTop_toBottomOf="@+id/constraintLayout8"
        style="@style/RobotoMonoRegular"/>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/constraintLayout8"
        android:background="@drawable/back_card_v2"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <TextView
            android:textSize="16sp"
            android:textStyle="normal"
            android:textColor="@color/card_title_color"
            android:id="@+id/tvTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="24dp"
            android:layout_marginTop="@dimen/dimen_16dp"
            android:layout_marginRight="24dp"
            android:text="@string/text_noise_cancellation"
            android:lineSpacingExtra="4sp"
            android:letterSpacing="-0.01"
            android:layout_marginHorizontal="24dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            style="@style/ClashDisplayVariableMedium"/>
        <include
            android:id="@+id/lytAncState"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="24dp"
            android:layout_marginTop="@dimen/dimen_24dp"
            android:layout_marginRight="24dp"
            android:layout_marginBottom="@dimen/dimen_24dp"
            android:layout_marginHorizontal="24dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tvTitle"
            layout="@layout/layout_max_buds_anc_state"/>
        <include
            android:id="@+id/lytAncLevel"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="32dp"
            android:layout_marginRight="32dp"
            android:layout_marginBottom="@dimen/dimen_20dp"
            android:layout_marginHorizontal="32dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/lytAncState"
            layout="@layout/layout_anc_level"/>
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
