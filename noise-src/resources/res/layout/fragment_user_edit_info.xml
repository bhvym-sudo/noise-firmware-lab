<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/title_color"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <TextView
        android:textSize="24sp"
        android:textColor="@color/white"
        android:id="@+id/text_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="32dp"
        android:text="@string/text_edit_profile"
        android:letterSpacing="-0.01"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:textAllCaps="true"
        style="@style/ClashDisplayVariableMedium"/>
    <ImageView
        android:id="@+id/img_close"
        android:padding="@dimen/dimen_8dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="0x7f080282"
        android:layout_marginEnd="@dimen/dimen_8dp"
        app:layout_constraintBottom_toBottomOf="@+id/text_title"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@+id/text_title"/>
    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="32dp"
        android:layout_marginBottom="@dimen/dimen_12dp"
        android:layout_marginStart="@dimen/dimen_12dp"
        android:layout_marginEnd="@dimen/dimen_12dp"
        app:cardBackgroundColor="@color/white"
        app:cardCornerRadius="30dp"
        app:cardElevation="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/text_title">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <ScrollView
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_marginBottom="8dp"
                app:layout_constraintBottom_toTopOf="@+id/text_save_adjustment"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent">
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <TextView
                        android:textSize="14sp"
                        android:textColor="#42454a"
                        android:id="@+id/textYourName"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="@dimen/dimen_32dp"
                        android:layout_marginTop="@dimen/dimen_56dp"
                        android:layout_marginRight="@dimen/dimen_32dp"
                        android:text="@string/your_name"
                        android:textAllCaps="true"
                        android:letterSpacing="0.02"
                        android:layout_marginHorizontal="@dimen/dimen_32dp"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        style="@style/RobotoMonoRegular"/>
                    <EditText
                        android:textSize="26sp"
                        android:textColor="#302f2d"
                        android:textColorHint="#66302f2d"
                        android:id="@+id/etName"
                        android:background="@color/transparent"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="@dimen/dimen_32dp"
                        android:layout_marginTop="16dp"
                        android:layout_marginRight="@dimen/dimen_32dp"
                        android:hint="@string/text_hint_start_typing"
                        android:singleLine="true"
                        android:maxLength="50"
                        android:digits="@string/character_name"
                        android:inputType="textCapWords"
                        android:textCursorDrawable="@drawable/custom_cursor"
                        android:layout_marginHorizontal="@dimen/dimen_32dp"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@+id/textYourName"
                        style="@style/ClashDisplayVariableMedium"/>
                    <TextView
                        android:textSize="14sp"
                        android:textColor="#42454a"
                        android:id="@+id/texttView1"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="@dimen/dimen_32dp"
                        android:layout_marginTop="@dimen/dimen_48dp"
                        android:layout_marginRight="@dimen/dimen_32dp"
                        android:text="@string/text_date_of_birth"
                        android:textAllCaps="true"
                        android:fontFamily="@font/roboto_mono_regular"
                        android:letterSpacing="0.02"
                        android:layout_marginHorizontal="@dimen/dimen_32dp"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@+id/etName"/>
                    <EditText
                        android:textSize="26sp"
                        android:textColor="#302f2d"
                        android:textColorHint="#66302f2d"
                        android:id="@+id/editTextDOB"
                        android:background="@color/transparent"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="@dimen/dimen_32dp"
                        android:layout_marginTop="16dp"
                        android:layout_marginRight="@dimen/dimen_32dp"
                        android:hint="@string/hint_dd_mm_yy"
                        android:maxLength="10"
                        android:inputType="number"
                        android:textCursorDrawable="@drawable/custom_cursor"
                        android:layout_marginHorizontal="@dimen/dimen_32dp"
                        app:hide_clear="true"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@+id/texttView1"
                        app:title="@string/enter_your_date_of_birth"
                        style="@style/ClashDisplayVariableMedium"/>
                    <TextView
                        android:textSize="14sp"
                        android:textColor="#42454a"
                        android:id="@+id/textView2"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="@dimen/dimen_32dp"
                        android:layout_marginTop="@dimen/dimen_48dp"
                        android:layout_marginRight="@dimen/dimen_32dp"
                        android:text="@string/your_email"
                        android:textAllCaps="true"
                        android:fontFamily="@font/roboto_mono_regular"
                        android:letterSpacing="0.02"
                        android:layout_marginHorizontal="@dimen/dimen_32dp"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@+id/editTextDOB"/>
                    <TextView
                        android:textSize="26sp"
                        android:textColor="#33302f2d"
                        android:textColorHint="#33302f2d"
                        android:ellipsize="end"
                        android:id="@+id/input_email"
                        android:background="@color/transparent"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="@dimen/dimen_32dp"
                        android:layout_marginTop="16dp"
                        android:layout_marginRight="@dimen/dimen_32dp"
                        android:singleLine="true"
                        android:textCursorDrawable="@drawable/custom_cursor"
                        android:layout_marginHorizontal="@dimen/dimen_32dp"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@+id/textView2"
                        style="@style/ClashDisplayVariableMedium"/>
                </androidx.constraintlayout.widget.ConstraintLayout>
            </ScrollView>
            <com.noise.audio.customviews.NoiseTextView
                android:textSize="14sp"
                android:textColor="@color/dark_color"
                android:gravity="center"
                android:id="@+id/text_save_adjustment"
                android:background="@drawable/round_corner_action_bg"
                android:padding="20dp"
                android:layout_width="0dp"
                android:layout_height="70dp"
                android:layout_margin="@dimen/dimen_20dp"
                android:text="@string/text_save_adjustments"
                android:textAllCaps="true"
                android:fontFamily="@font/clash_display_medium"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.cardview.widget.CardView>
    <include
        android:id="@+id/progressBar"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        layout="@layout/default_loader"/>
</androidx.constraintlayout.widget.ConstraintLayout>
