<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <View
        android:id="@+id/line"
        android:background="#dde3e5"
        android:layout_width="0dp"
        android:layout_height="2dp"
        android:layout_marginStart="@dimen/dimen_4dp"
        android:layout_marginEnd="@dimen/dimen_4dp"
        app:layout_constraintBottom_toBottomOf="@+id/btnHeadTrackingCircle"
        app:layout_constraintEnd_toEndOf="@+id/btnFixedCircle"
        app:layout_constraintStart_toStartOf="@+id/btnOffCircle"
        app:layout_constraintTop_toTopOf="@+id/btnHeadTrackingCircle"/>
    <View
        android:id="@+id/viewOff"
        android:background="@drawable/circle_white"
        android:layout_width="54dp"
        android:layout_height="54dp"
        android:layout_marginEnd="7dp"
        app:layout_constraintBottom_toBottomOf="@+id/btnOffCircle"
        app:layout_constraintEnd_toEndOf="@+id/btnOffCircle"
        app:layout_constraintStart_toStartOf="@+id/btnOffCircle"
        app:layout_constraintTop_toTopOf="@+id/btnOffCircle"/>
    <ImageButton
        android:id="@+id/btnOffCircle"
        android:background="@color/transparent"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@drawable/bg_anc_off_circle"
        android:layout_marginStart="8dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <ImageView
        android:id="@+id/imvOff"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@drawable/ic_head_tracking_off_unselected"
        app:layout_constraintBottom_toBottomOf="@+id/viewOff"
        app:layout_constraintEnd_toEndOf="@+id/viewOff"
        app:layout_constraintStart_toStartOf="@+id/viewOff"
        app:layout_constraintTop_toTopOf="@+id/viewOff"/>
    <TextView
        android:textSize="12sp"
        android:textStyle="normal"
        android:textColor="#879399"
        android:gravity="center_horizontal"
        android:id="@+id/tvOff"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dimen_8dp"
        android:text="@string/text_off"
        android:letterSpacing="0.06"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="@+id/viewOff"
        app:layout_constraintStart_toStartOf="@+id/viewOff"
        app:layout_constraintTop_toBottomOf="@+id/viewOff"
        style="@style/RobotoMonoRegular"/>
    <View
        android:id="@+id/viewHeadTracking"
        android:background="@drawable/circle_white"
        android:padding="@dimen/dimen_2dp"
        android:layout_width="54dp"
        android:layout_height="54dp"
        android:layout_marginStart="-2dp"
        app:layout_constraintBottom_toBottomOf="@+id/btnHeadTrackingCircle"
        app:layout_constraintEnd_toEndOf="@+id/btnHeadTrackingCircle"
        app:layout_constraintStart_toStartOf="@+id/btnHeadTrackingCircle"
        app:layout_constraintTop_toTopOf="@+id/btnHeadTrackingCircle"/>
    <ImageView
        android:id="@+id/imvHeadTracking"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@drawable/ic_head_tracking_unselected"
        app:layout_constraintBottom_toBottomOf="@+id/viewHeadTracking"
        app:layout_constraintEnd_toEndOf="@+id/viewHeadTracking"
        app:layout_constraintStart_toStartOf="@+id/viewHeadTracking"
        app:layout_constraintTop_toTopOf="@+id/viewHeadTracking"/>
    <ImageButton
        android:id="@+id/btnHeadTrackingCircle"
        android:background="@color/transparent"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@drawable/bg_transparency_circle"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textSize="12sp"
        android:textStyle="normal"
        android:textColor="#879399"
        android:gravity="center_horizontal"
        android:id="@+id/tvHeadTracking"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dimen_8dp"
        android:text="@string/text_head_tracking"
        android:letterSpacing="0.06"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="@+id/viewHeadTracking"
        app:layout_constraintStart_toStartOf="@+id/viewHeadTracking"
        app:layout_constraintTop_toBottomOf="@+id/viewHeadTracking"
        style="@style/RobotoMonoRegular"/>
    <View
        android:id="@+id/viewFixedCircle"
        android:background="@drawable/circle_white"
        android:layout_width="54dp"
        android:layout_height="54dp"
        android:layout_marginStart="7dp"
        app:layout_constraintBottom_toBottomOf="@+id/btnFixedCircle"
        app:layout_constraintEnd_toEndOf="@+id/btnFixedCircle"
        app:layout_constraintStart_toStartOf="@+id/btnFixedCircle"
        app:layout_constraintTop_toTopOf="@+id/btnFixedCircle"/>
    <ImageButton
        android:id="@+id/btnFixedCircle"
        android:background="@color/transparent"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@drawable/bg_anc_off_circle"
        android:rotation="-180"
        android:layout_marginEnd="8dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <ImageView
        android:id="@+id/imvFixed"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@drawable/ic_head_tracking_unselected"
        app:layout_constraintBottom_toBottomOf="@+id/viewFixedCircle"
        app:layout_constraintEnd_toEndOf="@+id/viewFixedCircle"
        app:layout_constraintStart_toStartOf="@+id/viewFixedCircle"
        app:layout_constraintTop_toTopOf="@+id/viewFixedCircle"/>
    <TextView
        android:textSize="12sp"
        android:textStyle="normal"
        android:textColor="#879399"
        android:gravity="center_horizontal"
        android:id="@+id/tvFixed"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dimen_8dp"
        android:text="@string/text_fixed"
        android:letterSpacing="0.06"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="@+id/viewFixedCircle"
        app:layout_constraintStart_toStartOf="@+id/viewFixedCircle"
        app:layout_constraintTop_toBottomOf="@+id/viewFixedCircle"
        style="@style/RobotoMonoRegular"/>
</androidx.constraintlayout.widget.ConstraintLayout>
