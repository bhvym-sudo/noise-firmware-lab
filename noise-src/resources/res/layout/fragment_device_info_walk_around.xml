<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:tag="layout/fragment_device_info_walk_around_0"
    android:background="#ededed"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.viewpager2.widget.ViewPager2
        android:id="@+id/vpSlider"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toTopOf="@+id/tabLayout"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textColor="@color/white"
        android:id="@+id/btnSkip"
        android:background="@drawable/back_modal_skip"
        android:paddingLeft="8dp"
        android:paddingTop="2dp"
        android:paddingRight="8dp"
        android:paddingBottom="2dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:text="@string/text_skip"
        android:textAllCaps="true"
        android:fontFamily="@font/roboto_mono_regular"
        android:layout_marginEnd="16dp"
        android:letterSpacing="0.06"
        android:paddingHorizontal="8dp"
        android:paddingVertical="2dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/H6"/>
    <com.google.android.material.tabs.TabLayout
        android:layout_gravity="end"
        android:id="@+id/tabLayout"
        android:background="@android:color/transparent"
        android:visibility="visible"
        android:layout_width="wrap_content"
        android:layout_height="6dp"
        android:layout_marginTop="@dimen/dimen_8dp"
        android:layout_marginBottom="12dp"
        app:layout_constraintBottom_toTopOf="@+id/bCustomise"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:tabBackground="@drawable/tab_selector"
        app:tabGravity="center"
        app:tabIndicatorHeight="0dp"
        app:tabPaddingEnd="8dp"
        app:tabPaddingStart="8dp"/>
    <com.noise.audio.customviews.NoiseButtonView
        android:id="@+id/bCustomise"
        android:background="@drawable/round_corner_continue_button"
        android:layout_width="0dp"
        android:layout_height="56dp"
        android:layout_marginLeft="@dimen/dimen_16dp"
        android:layout_marginRight="@dimen/dimen_16dp"
        android:layout_marginBottom="16dp"
        android:text="@string/text_continue"
        android:fontFamily="@font/roboto_mono_regular"
        android:layout_marginHorizontal="@dimen/dimen_16dp"
        app:backgroundTint="@null"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        style="@style/PrimaryButtonStyle"/>
    <include
        android:id="@+id/progressBar"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        layout="@layout/default_loader"/>
</androidx.constraintlayout.widget.ConstraintLayout>
