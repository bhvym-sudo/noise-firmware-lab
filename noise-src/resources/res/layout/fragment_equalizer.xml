<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="@color/transparent"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="12dp"
        app:cardBackgroundColor="@color/white"
        app:cardCornerRadius="30dp"
        app:cardElevation="0dp">
        <LinearLayout
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingTop="40dp"
            android:paddingBottom="20dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="18dp"
            android:paddingEnd="18dp">
            <TextView
                android:textSize="@dimen/text_size_22"
                android:textColor="#4c5252"
                android:gravity="center_horizontal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/text_equalizer"
                android:textAllCaps="true"
                android:letterSpacing="-0.01"
                style="@style/ClashDisplayVariableMedium"/>
            <LinearLayout
                android:id="@+id/pgView"
                android:layout_width="match_parent"
                android:layout_height="280dp"
                android:layout_marginTop="@dimen/_30sdp">
                <com.noise.audio.customviews.CustomProgressBar
                    android:id="@+id/progress_bass"
                    android:layout_width="80dp"
                    android:layout_height="match_parent"
                    app:equalizerType="BASS"
                    app:maxProgress="12"
                    app:progress="0"/>
                <Space
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"/>
                <com.noise.audio.customviews.CustomProgressBar
                    android:id="@+id/progress_mid"
                    android:layout_width="80dp"
                    android:layout_height="match_parent"
                    app:equalizerType="MID"
                    app:maxProgress="12"
                    app:progress="0"/>
                <Space
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"/>
                <com.noise.audio.customviews.CustomProgressBar
                    android:id="@+id/progress_treble"
                    android:layout_width="80dp"
                    android:layout_height="match_parent"
                    app:equalizerType="TREBLE"
                    app:maxProgress="12"
                    app:progress="0"/>
            </LinearLayout>
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_30sdp">
                <com.noise.audio.customviews.NoiseImageButton
                    android:id="@+id/pop_equalizer"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:drawable="0x7f0803ae"
                    app:selected="false"
                    app:selected_drawable="0x7f080329"
                    app:text="@string/text_default"/>
                <Space
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"/>
                <com.noise.audio.customviews.NoiseImageButton
                    android:id="@+id/jazz_equalizer"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:drawable="0x7f0803ad"
                    app:selected="false"
                    app:selected_drawable="0x7f0802d5"
                    app:text="@string/text_jazz"/>
                <Space
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"/>
                <com.noise.audio.customviews.NoiseImageButton
                    android:id="@+id/club_equalizer"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:drawable="0x7f0803a9"
                    app:selected="false"
                    app:selected_drawable="0x7f080278"
                    app:text="@string/text_club"/>
                <Space
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"/>
                <com.noise.audio.customviews.NoiseImageButton
                    android:id="@+id/rock_equalizer"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:drawable="0x7f0803b0"
                    app:selected="false"
                    app:selected_drawable="0x7f080353"
                    app:text="@string/text_rock"/>
                <Space
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"/>
                <com.noise.audio.customviews.NoiseImageButton
                    android:id="@+id/custom_equalizer"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:drawable="0x7f0803aa"
                    app:selected="false"
                    app:selected_drawable="0x7f0803ab"
                    app:text="@string/text_custom"/>
            </LinearLayout>
            <TextView
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="@color/dark_color"
                android:gravity="center"
                android:id="@+id/text_save_adjustment"
                android:background="@drawable/round_corner_action_bg"
                android:padding="20dp"
                android:layout_width="match_parent"
                android:layout_height="70dp"
                android:layout_marginTop="@dimen/_40sdp"
                android:text="@string/text_save_adjustments"
                android:textAllCaps="true"
                style="@style/ClashDisplayVariableRegular"/>
        </LinearLayout>
        <include
            android:id="@+id/progressBar"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            layout="@layout/default_loader"/>
        <androidx.constraintlayout.widget.Group
            android:id="@+id/group"
            android:visibility="invisible"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:constraint_referenced_ids="pgView,progress_bass,progress_mid,progress_treble,jazz_equalizer,club_equalizer,rock_equalizer, pop_equalizer,custom_equalizer"/>
    </androidx.cardview.widget.CardView>
</LinearLayout>
