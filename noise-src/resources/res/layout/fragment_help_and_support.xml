<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:tag="layout/fragment_help_and_support_0"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/appbar_lyt"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <com.google.android.material.appbar.CollapsingToolbarLayout
            android:id="@+id/collapsingToolbar"
            android:background="@color/white"
            android:layout_width="match_parent"
            android:layout_height="?attr/collapsingToolbarLayoutMediumSize"
            app:collapsedTitleTextAppearance="@style/CollapsedToolbarTitle"
            app:contentScrim="@color/white"
            app:expandedTitleMarginStart="24dp"
            app:expandedTitleTextAppearance="@style/ExpandedToolbarTitle"
            app:layout_scrollFlags="snap|exitUntilCollapsed|scroll"
            app:maxLines="2"
            app:statusBarScrim="@color/white"
            app:title="@string/text_help_support_title"
            style="?attr/collapsingToolbarLayoutMediumStyle">
            <com.google.android.material.appbar.MaterialToolbar
                android:id="@+id/toolbar"
                android:background="@color/white"
                android:layout_width="match_parent"
                android:layout_height="?attr/actionBarSize"
                android:elevation="0dp"
                app:layout_collapseMode="pin"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:navigationIcon="0x7f080244"/>
        </com.google.android.material.appbar.CollapsingToolbarLayout>
    </com.google.android.material.appbar.AppBarLayout>
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">
        <LinearLayout
            android:orientation="vertical"
            android:tag="binding_1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="16dp"
            android:layout_marginRight="16dp"
            android:layout_marginHorizontal="16dp">
            <TextView
                android:textSize="12sp"
                android:textColor="#4c5252"
                android:id="@+id/tvSubtitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/text_dedicated_assistance_for_your_noise_audio_experience"
                style="@style/RobotoMonoRegular"/>
            <com.google.android.flexbox.FlexboxLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                app:alignItems="flex_start"
                app:flexDirection="row"
                app:flexWrap="wrap"
                app:justifyContent="flex_start">
                <TextView
                    android:textSize="14sp"
                    android:textColor="#ffffff"
                    android:gravity="center_vertical"
                    android:id="@+id/btnCallUs"
                    android:background="@drawable/btn_primary_aud_bg_selector_8"
                    android:layout_width="wrap_content"
                    android:layout_height="44dp"
                    android:layout_marginTop="8dp"
                    android:text="@string/text_call_us"
                    android:drawablePadding="8dp"
                    android:textAllCaps="true"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    app:drawableStartCompat="@drawable/ic_help_call"
                    app:drawableTint="#ffffff"
                    style="@style/RobotoMonoRegular"/>
                <Space
                    android:layout_width="12dp"
                    android:layout_height="1dp"/>
                <TextView
                    android:textSize="14sp"
                    android:textColor="#ffffff"
                    android:gravity="center_vertical"
                    android:id="@+id/btnMailUs"
                    android:background="@drawable/btn_primary_aud_bg_selector_8"
                    android:layout_width="wrap_content"
                    android:layout_height="44dp"
                    android:layout_marginTop="8dp"
                    android:text="@string/text_mail_us"
                    android:drawablePadding="8dp"
                    android:textAllCaps="true"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    app:drawableStartCompat="@drawable/ic_help_mail"
                    app:drawableTint="#ffffff"
                    style="@style/RobotoMonoRegular"/>
            </com.google.android.flexbox.FlexboxLayout>
            <include
                android:id="@+id/lytWarrantyCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="32dp"
                layout="@layout/layout_help_warranty_item"/>
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/lytGroup"
                android:background="@drawable/back_card_v2"
                android:paddingTop="0dp"
                android:paddingBottom="0dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp">
                <LinearLayout
                    android:orientation="vertical"
                    android:id="@+id/linearRows"
                    android:tag="binding_2"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent">
                    <include
                        android:id="@+id/rowAiAssistant"
                        android:visibility="gone"
                        android:layout_width="match_parent"
                        android:layout_height="72dp"
                        layout="@layout/layout_help_group_row"/>
                    <include
                        android:id="@+id/rowProductGuide"
                        layout="@layout/layout_help_group_row"/>
                    <include
                        android:id="@+id/rowFaq"
                        layout="@layout/layout_help_group_row"/>
                    <include
                        android:id="@+id/rowFeedback"
                        android:visibility="gone"
                        android:layout_width="match_parent"
                        android:layout_height="72dp"
                        layout="@layout/layout_help_group_row"/>
                    <include
                        android:id="@+id/rowReportBug"
                        layout="@layout/layout_help_group_row"/>
                </LinearLayout>
            </androidx.constraintlayout.widget.ConstraintLayout>
            <TextView
                android:textSize="12sp"
                android:textColor="#54656d"
                android:gravity="center"
                android:id="@+id/tvOtherQuery"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="@string/text_for_any_other_query"
                style="@style/RobotoMonoRegular"/>
            <TextView
                android:textSize="12sp"
                android:textColor="#54656d"
                android:gravity="center"
                android:layout_gravity="center_horizontal"
                android:id="@+id/tvClickHere"
                android:paddingTop="4dp"
                android:paddingBottom="4dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="24dp"
                android:text="@string/text_click_here"
                android:paddingVertical="4dp"
                style="@style/RobotoMonoMedium"/>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</androidx.coordinatorlayout.widget.CoordinatorLayout>
