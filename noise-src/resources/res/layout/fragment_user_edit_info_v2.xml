<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/white"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.core.widget.NestedScrollView
        android:id="@+id/scrollContent"
        android:paddingBottom="24dp"
        android:clipToPadding="false"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        android:overScrollMode="never"
        app:layout_constraintBottom_toTopOf="@+id/btnUpdateProfile"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <ImageView
                android:id="@+id/imgBack"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="0x7f080244"
                android:layout_marginStart="20dp"
                app:layout_constraintBottom_toBottomOf="@+id/textTitle"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="@+id/textTitle"/>
            <TextView
                android:textSize="24sp"
                android:textColor="#43555e"
                android:id="@+id/textTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/text_edit_profile"
                android:textAllCaps="true"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                style="@style/ClashDisplayVariableSemiBold"/>
            <FrameLayout
                android:id="@+id/lytAvatar"
                android:background="@drawable/back_circle_avatar_v2"
                android:layout_width="124dp"
                android:layout_height="124dp"
                android:layout_marginTop="64dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent">
                <com.google.android.material.imageview.ShapeableImageView
                    android:id="@+id/ivAvatar"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="centerCrop"
                    app:shapeAppearance="@style/ShapeAppearance.App.CircleImageView"/>
                <ImageView
                    android:layout_gravity="center"
                    android:id="@+id/ivAvatarPlaceholder"
                    android:padding="44dp"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:src="@drawable/ic_profile_camera"
                    app:tint="#5b6b73"/>
                <com.google.android.material.imageview.ShapeableImageView
                    android:id="@+id/ivEditLayer"
                    android:background="#80000000"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:src="@drawable/ic_edit_profile_2"
                    android:scaleType="centerCrop"
                    app:contentPadding="46dp"
                    app:shapeAppearance="@style/ShapeAppearance.App.CircleImageView"/>
            </FrameLayout>
            <TextView
                android:textSize="14sp"
                android:textColor="#42454a"
                android:id="@+id/tvNameLabel"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="48dp"
                android:text="@string/text_name"
                android:textAllCaps="true"
                android:layout_marginStart="20dp"
                android:layout_marginEnd="20dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/lytAvatar"
                style="@style/RobotoMonoRegular"/>
            <EditText
                android:textSize="21sp"
                android:textColor="#3a434e"
                android:textColorHint="#993a434e"
                android:gravity="center_vertical"
                android:id="@+id/etName"
                android:background="@drawable/back_profile_v2_input"
                android:paddingLeft="16dp"
                android:paddingRight="16dp"
                android:layout_width="0dp"
                android:layout_height="64dp"
                android:layout_marginTop="12dp"
                android:hint="@string/text_enter_name"
                android:singleLine="true"
                android:maxLength="50"
                android:inputType="textCapWords"
                android:textCursorDrawable="@drawable/custom_cursor"
                android:layout_marginStart="16dp"
                android:layout_marginEnd="16dp"
                android:paddingHorizontal="16dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/tvNameLabel"
                style="@style/ClashDisplayVariableMedium"/>
            <TextView
                android:textSize="14sp"
                android:textColor="#42454a"
                android:id="@+id/tvDobLabel"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="32dp"
                android:text="@string/text_date_of_birth"
                android:textAllCaps="true"
                android:layout_marginStart="20dp"
                android:layout_marginEnd="20dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/etName"
                style="@style/RobotoMonoRegular"/>
            <TextView
                android:textSize="21sp"
                android:textColor="#3a434e"
                android:textColorHint="#993a434e"
                android:gravity="center_vertical"
                android:id="@+id/etDob"
                android:background="@drawable/back_profile_v2_input"
                android:paddingLeft="16dp"
                android:paddingRight="16dp"
                android:layout_width="0dp"
                android:layout_height="64dp"
                android:layout_marginTop="12dp"
                android:layout_marginBottom="24dp"
                android:hint="@string/hint_dd_mm_yy"
                android:maxLength="10"
                android:textCursorDrawable="@drawable/custom_cursor"
                android:layout_marginStart="16dp"
                android:layout_marginEnd="16dp"
                android:paddingHorizontal="16dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/tvDobLabel"
                style="@style/ClashDisplayVariableMedium"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.core.widget.NestedScrollView>
    <TextView
        android:textSize="14sp"
        android:textColor="#ffffff"
        android:gravity="center"
        android:id="@+id/btnUpdateProfile"
        android:background="@drawable/back_profile_v2_update"
        android:layout_width="0dp"
        android:layout_height="56dp"
        android:layout_marginBottom="42dp"
        android:text="@string/text_update_profile"
        android:textAllCaps="true"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        style="@style/RobotoMonoRegular"/>
    <include
        android:id="@+id/progressBar"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        layout="@layout/default_loader"/>
</androidx.constraintlayout.widget.ConstraintLayout>
