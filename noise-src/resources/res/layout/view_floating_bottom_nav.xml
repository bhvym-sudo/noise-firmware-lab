<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto">
    <com.google.android.material.card.MaterialCardView
        android:layout_gravity="center"
        android:layout_width="wrap_content"
        android:layout_height="64dp"
        android:foregroundGravity="center"
        app:cardBackgroundColor="@color/transparent"
        app:cardCornerRadius="32dp">
        <LinearLayout
            android:gravity="center"
            android:orientation="horizontal"
            android:background="@drawable/back_stroke_nav"
            android:paddingLeft="2dp"
            android:paddingTop="2dp"
            android:paddingRight="2dp"
            android:paddingBottom="2dp"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:paddingHorizontal="2dp"
            android:paddingVertical="2dp">
            <LinearLayout
                android:gravity="center"
                android:orientation="vertical"
                android:id="@+id/item_device"
                android:clickable="true"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:minWidth="96dp"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                style="@style/Widget.AppCompat.Button.Borderless">
                <ImageView
                    android:id="@+id/iv_device"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/ic_tab_home"/>
                <TextView
                    android:textSize="10sp"
                    android:textColor="#232726"
                    android:id="@+id/tv_device"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/text_home"
                    style="@style/ClashDisplayVariableMedium"/>
            </LinearLayout>
            <LinearLayout
                android:gravity="center"
                android:orientation="vertical"
                android:id="@+id/item_ai"
                android:clickable="true"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:minWidth="96dp"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                style="@style/Widget.AppCompat.Button.Borderless">
                <ImageView
                    android:id="@+id/iv_ai"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="0x7f080383"/>
                <TextView
                    android:textSize="10sp"
                    android:textColor="#232726"
                    android:id="@+id/tv_ai"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/text_ai"
                    style="@style/ClashDisplayVariableMedium"/>
            </LinearLayout>
            <LinearLayout
                android:gravity="center"
                android:orientation="vertical"
                android:id="@+id/item_settings"
                android:clickable="true"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:minWidth="96dp"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                style="@style/Widget.AppCompat.Button.Borderless">
                <ImageView
                    android:id="@+id/iv_settings"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/ic_tab_settings"/>
                <TextView
                    android:textSize="10sp"
                    android:textColor="#232726"
                    android:id="@+id/tv_settings"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/text_settings"
                    style="@style/ClashDisplayVariableMedium"/>
            </LinearLayout>
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>
</merge>
