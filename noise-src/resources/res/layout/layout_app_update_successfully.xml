<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:paddingBottom="12dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:background="@drawable/app_update_available_bottom_sheet_bg"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="12dp">
        <TextView
            android:textSize="24sp"
            android:textStyle="bold"
            android:textColor="#43555e"
            android:gravity="center"
            android:id="@+id/tvTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:textAllCaps="true"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            style="@style/ClashDisplayVariableMedium"/>
        <TextView
            android:textSize="12sp"
            android:textColor="#3a414e"
            android:gravity="center"
            android:id="@+id/tvVersion"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textAllCaps="true"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tvTitle"
            style="@style/RobotoMonoRegular"/>
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/lytWhatsNewContainer"
            android:background="@drawable/whats_new_desc_bg"
            android:padding="16dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:layout_marginStart="20dp"
            android:layout_marginEnd="20dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tvVersion">
            <TextView
                android:textSize="13sp"
                android:textColor="#3a414e"
                android:id="@+id/tvWhatsNewTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/text_what_s_new"
                android:textAllCaps="true"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                style="@style/RobotoMonoRegular"/>
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvWhatsNew"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:nestedScrollingEnabled="false"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/tvWhatsNewTitle"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:id="@+id/lytStatus"
            android:background="@drawable/whats_new_desc_bg"
            android:padding="6dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/lytWhatsNewContainer">
            <ImageView
                android:id="@+id/viewStatusDot"
                android:background="0x7f080315"
                android:layout_width="12dp"
                android:layout_height="12dp"/>
            <TextView
                android:textSize="12sp"
                android:textColor="#43555e"
                android:id="@+id/tvStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/text_update_complete"
                android:textAllCaps="true"
                android:layout_marginStart="8dp"
                style="@style/RobotoMonoRegular"/>
        </LinearLayout>
        <TextView
            android:textSize="@dimen/text_14sp"
            android:textColor="#ffffff"
            android:gravity="center"
            android:id="@+id/btnClose"
            android:background="@drawable/update_app_button_bg"
            android:paddingTop="24dp"
            android:paddingBottom="24dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:layout_marginBottom="32dp"
            android:text="@string/text_close"
            android:textAllCaps="true"
            android:layout_marginStart="20dp"
            android:layout_marginEnd="20dp"
            android:backgroundTint="#131414"
            android:paddingVertical="24dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/lytStatus"
            style="@style/RobotoMonoRegular"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</LinearLayout>
