<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:gravity="bottom"
    android:orientation="vertical"
    android:paddingBottom="12dp"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:paddingStart="12dp"
    android:paddingEnd="12dp">
    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardBackgroundColor="@color/white"
        app:cardCornerRadius="30dp"
        app:cardElevation="0dp">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:gravity="center"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <TextView
                android:textSize="24sp"
                android:textColor="#3e4243"
                android:gravity="center"
                android:id="@+id/text_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="40dp"
                android:text="@string/text_find_my_device"
                android:textAllCaps="true"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:textAllCaps="true"
                style="@style/ClashDisplayVariableMedium"/>
            <TextView
                android:textSize="12sp"
                android:textColor="#3a414e"
                android:gravity="center"
                android:id="@+id/text_sub_title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginLeft="@dimen/dimen_16dp"
                android:layout_marginTop="16dp"
                android:layout_marginRight="@dimen/dimen_16dp"
                android:text="@string/text_find_my_earbuds_sub_title"
                android:textAllCaps="true"
                android:layout_marginHorizontal="@dimen/dimen_16dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/text_title"
                app:textAllCaps="true"
                style="@style/RobotoMonoRegular"/>
            <com.airbnb.lottie.LottieAnimationView
                android:id="@+id/animFindMyDeviceLeft"
                android:focusable="false"
                android:visibility="gone"
                android:clickable="false"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:adjustViewBounds="true"
                app:layout_constraintBottom_toBottomOf="@+id/btn_left_play"
                app:layout_constraintEnd_toEndOf="@+id/btn_left_play"
                app:layout_constraintStart_toStartOf="@+id/btn_left_play"
                app:layout_constraintTop_toTopOf="@+id/btn_left_play"
                app:lottie_autoPlay="false"
                app:lottie_loop="false"
                app:lottie_rawRes="@raw/anim_find_my_device"/>
            <com.airbnb.lottie.LottieAnimationView
                android:id="@+id/animFindMyDeviceRight"
                android:focusable="false"
                android:visibility="gone"
                android:clickable="false"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:adjustViewBounds="true"
                app:layout_constraintBottom_toBottomOf="@+id/btn_right_play"
                app:layout_constraintEnd_toEndOf="@+id/btn_right_play"
                app:layout_constraintStart_toStartOf="@+id/btn_right_play"
                app:layout_constraintTop_toTopOf="@+id/btn_right_play"
                app:lottie_autoPlay="false"
                app:lottie_loop="false"
                app:lottie_rawRes="@raw/anim_find_my_device"/>
            <ImageView
                android:id="@+id/imvRightEarBud"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="36dp"
                app:layout_constraintEnd_toEndOf="@+id/btn_right_play"
                app:layout_constraintHorizontal_bias="0.5"
                app:layout_constraintStart_toStartOf="@+id/btn_right_play"
                app:layout_constraintTop_toBottomOf="@+id/text_sub_title"/>
            <ImageView
                android:id="@+id/imvLeftEarBud"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="36dp"
                app:layout_constraintEnd_toEndOf="@+id/btn_left_play"
                app:layout_constraintHorizontal_bias="0.5"
                app:layout_constraintStart_toStartOf="@+id/btn_left_play"
                app:layout_constraintTop_toBottomOf="@+id/text_sub_title"/>
            <ImageView
                android:textColor="@color/widget_title_color"
                android:id="@+id/btn_left_play"
                android:background="@drawable/circle_dark_color"
                android:padding="14dp"
                android:layout_width="50dp"
                android:layout_height="50dp"
                android:layout_marginTop="16dp"
                android:src="0x7f080326"
                app:layout_constraintEnd_toStartOf="@+id/btn_right_play"
                app:layout_constraintHorizontal_bias="0.5"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/imvLeftEarBud"/>
            <ImageView
                android:textColor="@color/widget_title_color"
                android:id="@+id/btn_right_play"
                android:background="@drawable/circle_dark_color"
                android:padding="14dp"
                android:layout_width="50dp"
                android:layout_height="50dp"
                android:src="0x7f080326"
                app:layout_constraintBottom_toBottomOf="@+id/btn_left_play"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintHorizontal_bias="0.5"
                app:layout_constraintStart_toEndOf="@+id/btn_left_play"
                app:layout_constraintTop_toTopOf="@+id/btn_left_play"/>
            <TextView
                android:textSize="12sp"
                android:textColor="#3a414e"
                android:gravity="center"
                android:id="@+id/text_description"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginLeft="@dimen/dimen_16dp"
                android:layout_marginTop="32dp"
                android:layout_marginRight="@dimen/dimen_16dp"
                android:text="@string/text_find_my_earbuds_description"
                android:textAllCaps="true"
                android:layout_marginStart="20dp"
                android:layout_marginEnd="20dp"
                android:layout_marginHorizontal="@dimen/dimen_16dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/btn_left_play"
                app:textAllCaps="true"
                style="@style/RobotoMonoItalic"/>
            <TextView
                android:textSize="@dimen/text_14sp"
                android:textStyle="bold"
                android:textColor="@color/dark_color"
                android:gravity="center"
                android:id="@+id/text_found_it"
                android:background="@drawable/round_corner_action_bg"
                android:padding="20dp"
                android:layout_width="match_parent"
                android:layout_height="68dp"
                android:layout_marginTop="24dp"
                android:text="@string/text_found_it"
                android:textAllCaps="true"
                android:layout_marginStart="20dp"
                android:layout_marginEnd="20dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/text_description"
                style="@style/ClashDisplayVariableMedium"/>
            <TextView
                android:textSize="@dimen/text_14sp"
                android:textStyle="bold"
                android:textColor="#090909"
                android:gravity="center"
                android:id="@+id/text_cancel"
                android:padding="20dp"
                android:layout_width="match_parent"
                android:layout_height="68dp"
                android:layout_marginBottom="10dp"
                android:text="@string/text_cancel"
                android:textAllCaps="true"
                android:layout_marginStart="20dp"
                android:layout_marginEnd="20dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/text_found_it"
                style="@style/RobotoMonoRegular"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.cardview.widget.CardView>
</LinearLayout>
