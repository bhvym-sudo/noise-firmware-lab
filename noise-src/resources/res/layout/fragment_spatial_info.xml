<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/appbar_lyt"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <com.google.android.material.appbar.CollapsingToolbarLayout
            android:id="@+id/collapsingToolbar"
            android:background="@color/white"
            android:layout_width="match_parent"
            android:layout_height="?attr/collapsingToolbarLayoutMediumSize"
            app:collapsedTitleTextAppearance="@style/CollapsedToolbarTitle"
            app:contentScrim="@color/white"
            app:expandedTitleMarginStart="24dp"
            app:expandedTitleTextAppearance="@style/ExpandedToolbarTitle"
            app:layout_scrollFlags="snap|exitUntilCollapsed|scroll"
            app:maxLines="2"
            app:statusBarScrim="@color/white"
            app:title="@string/text_spatial_audio_3"
            style="?attr/collapsingToolbarLayoutMediumStyle">
            <com.google.android.material.appbar.MaterialToolbar
                android:id="@+id/toolbar"
                android:background="@color/white"
                android:layout_width="match_parent"
                android:layout_height="?attr/actionBarSize"
                android:elevation="0dp"
                app:layout_collapseMode="pin"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:navigationIcon="0x7f080244">
                <include
                    android:layout_gravity="end"
                    android:id="@+id/lytAssetsIndicator"
                    android:visibility="gone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="16dp"
                    layout="@layout/layout_assets_download_indicator"/>
            </com.google.android.material.appbar.MaterialToolbar>
        </com.google.android.material.appbar.CollapsingToolbarLayout>
    </com.google.android.material.appbar.AppBarLayout>
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_behavior="@string/appbar_scrolling_view_behavior"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/toolbar">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <TextView
                android:textSize="14sp"
                android:textColor="#879399"
                android:id="@+id/tvMessage"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="24dp"
                android:layout_marginTop="4dp"
                android:layout_marginRight="24dp"
                android:text="@string/text_spatial_message_2"
                android:layout_marginHorizontal="24dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                style="@style/RobotoMonoRegular"/>
            <androidx.cardview.widget.CardView
                android:id="@+id/videoCv"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_marginLeft="16dp"
                android:layout_marginTop="@dimen/dimen_18dp"
                android:layout_marginRight="16dp"
                android:layout_marginHorizontal="16dp"
                app:cardCornerRadius="20dp"
                app:cardElevation="0dp"
                app:layout_constraintDimensionRatio="1:1"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/tvMessage">
                <androidx.media3.ui.PlayerView
                    android:id="@+id/videoPlayer"
                    android:background="@android:color/transparent"
                    android:visibility="invisible"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    app:resize_mode="fit"
                    app:show_buffering="never"
                    app:show_subtitle_button="false"
                    app:shutter_background_color="@android:color/transparent"
                    app:surface_type="texture_view"
                    app:use_controller="false"/>
                <ImageView
                    android:id="@+id/imgPlaceholder"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:src="@drawable/image_ai_audio"
                    android:scaleType="centerInside"/>
            </androidx.cardview.widget.CardView>
            <include
                android:id="@+id/lytSpatialAudioTrack"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="@dimen/dimen_24dp"
                android:layout_marginTop="@dimen/dimen_32dp"
                android:layout_marginRight="@dimen/dimen_24dp"
                android:layout_marginHorizontal="@dimen/dimen_24dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/videoCv"
                layout="@layout/layout_spatial_audio_tracking"/>
            <TextView
                android:textSize="@dimen/text_12sp"
                android:textColor="#879399"
                android:gravity="center"
                android:id="@+id/tvPlaying"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginLeft="34dp"
                android:layout_marginTop="@dimen/dimen_24dp"
                android:layout_marginRight="34dp"
                android:fontFamily="@font/roboto_mono_regular"
                android:letterSpacing="-0.03"
                android:layout_marginHorizontal="34dp"
                app:layout_constraintEnd_toEndOf="@+id/lytSpatialAudioTrack"
                app:layout_constraintStart_toStartOf="@+id/lytSpatialAudioTrack"
                app:layout_constraintTop_toBottomOf="@+id/lytSpatialAudioTrack"/>
            <com.google.android.material.imageview.ShapeableImageView
                android:id="@+id/imageSpatialExp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="44dp"
                android:layout_marginBottom="44dp"
                android:src="0x7f0803fa"
                android:adjustViewBounds="true"
                android:layout_marginStart="20dp"
                android:layout_marginEnd="20dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/tvPlaying"
                app:shapeAppearance="@style/ShapeAppearanceOverlay.App.CornerSize20dp"/>
            <TextView
                android:textSize="16sp"
                android:textColor="@color/white"
                android:id="@+id/textExperience"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="@string/text_experience_the_immersion_with_a_demo"
                android:layout_marginStart="24dp"
                android:layout_marginEnd="8dp"
                app:layout_constraintBottom_toBottomOf="@+id/imageSpatialExp"
                app:layout_constraintEnd_toStartOf="@+id/indicatorBarrier"
                app:layout_constraintStart_toStartOf="@+id/imageSpatialExp"
                app:layout_constraintTop_toTopOf="@+id/imageSpatialExp"
                style="@style/ClashDisplayVariableMedium"/>
            <androidx.constraintlayout.widget.Barrier
                android:id="@+id/indicatorBarrier"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:barrierDirection="start"
                app:constraint_referenced_ids="ivNext,lottieSpatialDownloading,ivSpatialFailed"/>
            <ImageView
                android:id="@+id/ivNext"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/ic_spatial_right"
                android:layout_marginEnd="24dp"
                app:layout_constraintBottom_toBottomOf="@+id/imageSpatialExp"
                app:layout_constraintEnd_toEndOf="@+id/imageSpatialExp"
                app:layout_constraintTop_toTopOf="@+id/imageSpatialExp"/>
            <com.airbnb.lottie.LottieAnimationView
                android:id="@+id/lottieSpatialDownloading"
                android:background="@drawable/bg_spatial_indicator"
                android:visibility="gone"
                android:layout_width="56dp"
                android:layout_height="34dp"
                android:layout_marginEnd="24dp"
                app:layout_constraintBottom_toBottomOf="@+id/imageSpatialExp"
                app:layout_constraintEnd_toEndOf="@+id/imageSpatialExp"
                app:layout_constraintTop_toTopOf="@+id/imageSpatialExp"
                app:lottie_autoPlay="true"
                app:lottie_loop="true"
                app:lottie_rawRes="@raw/anim_downloading"/>
            <ImageView
                android:id="@+id/ivSpatialFailed"
                android:background="@drawable/bg_spatial_indicator"
                android:padding="6dp"
                android:visibility="gone"
                android:layout_width="56dp"
                android:layout_height="34dp"
                android:src="@drawable/ic_download_failed"
                android:layout_marginEnd="24dp"
                app:layout_constraintBottom_toBottomOf="@+id/imageSpatialExp"
                app:layout_constraintEnd_toEndOf="@+id/imageSpatialExp"
                app:layout_constraintTop_toTopOf="@+id/imageSpatialExp"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.core.widget.NestedScrollView>
</androidx.coordinatorlayout.widget.CoordinatorLayout>
