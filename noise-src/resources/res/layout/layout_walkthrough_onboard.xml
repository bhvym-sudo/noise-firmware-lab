<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:fillViewport="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent">
            <ImageView
                android:id="@+id/ivWaveform"
                android:background="@drawable/wave_icon_bg"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="67dp"
                android:layout_marginStart="16dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintHorizontal_bias="0"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:srcCompat="0x7f0803a4"/>
            <TextView
                android:textSize="18sp"
                android:textStyle="normal"
                android:textColor="#ffffff"
                android:id="@+id/tvLeftText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:letterSpacing="0.06"
                app:layout_constraintBottom_toBottomOf="@+id/ivWaveform"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintHorizontal_bias="0"
                app:layout_constraintStart_toEndOf="@+id/ivWaveform"
                app:layout_constraintTop_toTopOf="@+id/ivWaveform"
                style="@style/RobotoMonoRegular"/>
            <TextView
                android:textSize="14sp"
                android:textStyle="normal"
                android:textColor="#ffffff"
                android:gravity="center"
                android:id="@+id/tvSkip"
                android:background="@drawable/skip_btn_bg"
                android:paddingTop="4dp"
                android:paddingBottom="4dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/text_skip"
                android:textAllCaps="true"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:layout_marginEnd="16dp"
                android:letterSpacing="0.06"
                app:layout_constraintBottom_toBottomOf="@+id/ivWaveform"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="@+id/ivWaveform"
                style="@style/RobotoMonoRegular"/>
            <TextView
                android:textSize="50sp"
                android:textStyle="normal"
                android:textColor="#ffffff"
                android:id="@+id/tvBottomTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="25dp"
                android:lineSpacingExtra="6sp"
                android:textAllCaps="true"
                android:layout_marginStart="12dp"
                android:letterSpacing="0.01"
                app:layout_constraintBottom_toTopOf="@+id/tvBottomDes"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"/>
            <TextView
                android:textSize="12sp"
                android:textStyle="normal"
                android:textColor="#ffffff"
                android:id="@+id/tvBottomDes"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="75dp"
                android:layout_marginStart="12dp"
                android:letterSpacing="0.06"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                style="@style/RobotoMonoRegular"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.core.widget.NestedScrollView>
</androidx.constraintlayout.widget.ConstraintLayout>
