<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:paddingTop="4dp"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:paddingEnd="16dp">
    <LinearLayout
        android:orientation="vertical"
        android:background="@drawable/bg_menu_popup"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:elevation="6dp">
        <TextView
            android:textSize="14sp"
            android:textColor="#43555e"
            android:gravity="center_vertical"
            android:id="@+id/itemSearch"
            android:background="?attr/selectableItemBackground"
            android:paddingLeft="16dp"
            android:paddingTop="14dp"
            android:paddingRight="16dp"
            android:paddingBottom="14dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/text_search_caps"
            android:drawablePadding="12dp"
            android:textAllCaps="true"
            android:paddingEnd="24dp"
            android:paddingHorizontal="16dp"
            android:paddingVertical="14dp"
            app:drawableStartCompat="@drawable/ic_search_2"
            app:drawableTint="#43555e"
            style="@style/ClashDisplayMedium"/>
        <View
            android:background="#e2e5e9"
            android:layout_width="match_parent"
            android:layout_height="1dp"/>
        <TextView
            android:textSize="14sp"
            android:textColor="#43555e"
            android:gravity="center_vertical"
            android:id="@+id/itemShare"
            android:background="?attr/selectableItemBackground"
            android:paddingLeft="16dp"
            android:paddingTop="14dp"
            android:paddingRight="16dp"
            android:paddingBottom="14dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/text_share_caps"
            android:drawablePadding="12dp"
            android:textAllCaps="true"
            android:paddingEnd="24dp"
            android:paddingHorizontal="16dp"
            android:paddingVertical="14dp"
            app:drawableStartCompat="@drawable/ic_share_transcription"
            app:drawableTint="#43555e"
            style="@style/ClashDisplayMedium"/>
        <View
            android:background="#e2e5e9"
            android:layout_width="match_parent"
            android:layout_height="1dp"/>
        <TextView
            android:textSize="14sp"
            android:textColor="#43555e"
            android:gravity="center_vertical"
            android:id="@+id/itemEdit"
            android:background="?attr/selectableItemBackground"
            android:paddingLeft="16dp"
            android:paddingTop="14dp"
            android:paddingRight="16dp"
            android:paddingBottom="14dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/text_edit_caps"
            android:drawablePadding="12dp"
            android:textAllCaps="true"
            android:paddingEnd="24dp"
            android:paddingHorizontal="16dp"
            android:paddingVertical="14dp"
            app:drawableStartCompat="@drawable/ic_edit_2"
            app:drawableTint="#43555e"
            style="@style/ClashDisplayMedium"/>
        <View
            android:background="#e2e5e9"
            android:layout_width="match_parent"
            android:layout_height="1dp"/>
        <TextView
            android:textSize="14sp"
            android:textColor="#bb1515"
            android:gravity="center_vertical"
            android:id="@+id/itemDelete"
            android:background="?attr/selectableItemBackground"
            android:paddingLeft="16dp"
            android:paddingTop="14dp"
            android:paddingRight="16dp"
            android:paddingBottom="14dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/text_delete"
            android:drawablePadding="12dp"
            android:textAllCaps="true"
            android:paddingEnd="24dp"
            android:paddingHorizontal="16dp"
            android:paddingVertical="14dp"
            app:drawableStartCompat="@drawable/ic_delete_transcription"
            app:drawableTint="#bb1515"
            style="@style/ClashDisplayMedium"/>
    </LinearLayout>
</FrameLayout>
