<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <TextView
        android:textColor="@color/home_button_text_color"
        android:gravity="center"
        android:id="@+id/tvReconnect"
        android:background="@drawable/bg_reconnect_button"
        android:layout_width="0dp"
        android:layout_height="80dp"
        android:layout_marginLeft="10dp"
        android:layout_marginRight="10dp"
        android:layout_marginBottom="10dp"
        android:text="@string/text_reconnect"
        android:textAllCaps="true"
        android:layout_marginHorizontal="10dp"
        app:layout_constraintBottom_toTopOf="@+id/img_setting"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        style="@style/RobotoMonoRegular"/>
    <androidx.constraintlayout.widget.Guideline
        android:orientation="vertical"
        android:id="@+id/guideline2"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintGuide_percent="0.5"/>
    <ImageView
        android:id="@+id/img_setting"
        android:background="@drawable/dark_circle_bg"
        android:padding="24dp"
        android:layout_width="@dimen/dimen_80dp"
        android:layout_height="@dimen/dimen_80dp"
        android:layout_marginBottom="@dimen/dimen_32dp"
        android:src="0x7f08035c"
        android:layout_marginEnd="12dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/guideline2"/>
    <ImageView
        android:id="@+id/btnProfile"
        android:background="@drawable/dark_circle_bg"
        android:padding="20dp"
        android:layout_width="@dimen/dimen_80dp"
        android:layout_height="@dimen/dimen_80dp"
        android:layout_marginBottom="@dimen/dimen_32dp"
        android:src="0x7f080300"
        android:layout_marginStart="@dimen/dimen_12dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="@+id/guideline2"/>
</androidx.constraintlayout.widget.ConstraintLayout>
