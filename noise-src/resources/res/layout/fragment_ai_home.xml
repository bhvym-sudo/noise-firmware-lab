<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="#ffffff"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ImageView
        android:id="@+id/imageBack"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:src="0x7f080097"
        android:adjustViewBounds="true"
        app:layout_constraintBottom_toBottomOf="parent"/>
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvDevices"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:layout_marginStart="16dp"
                app:layout_constraintEnd_toStartOf="@+id/lytAssetsIndicator"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
            <include
                android:id="@+id/lytAssetsIndicator"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="8dp"
                android:layout_marginRight="8dp"
                android:layout_marginHorizontal="8dp"
                app:layout_constraintBottom_toBottomOf="@+id/rvDevices"
                app:layout_constraintEnd_toStartOf="@+id/btnProfile"
                app:layout_constraintTop_toTopOf="@+id/rvDevices"
                layout="@layout/layout_assets_download_indicator"/>
            <ImageButton
                android:id="@+id/btnProfile"
                android:background="@color/transparent"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/ic_shop"
                android:layout_marginEnd="16dp"
                app:layout_constraintBottom_toBottomOf="@+id/rvDevices"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="@+id/rvDevices"/>
            <ImageView
                android:id="@+id/ivAiLogo"
                android:layout_width="64dp"
                android:layout_height="66dp"
                android:layout_marginTop="40dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/rvDevices"/>
            <TextView
                android:textSize="24sp"
                android:textColor="#54656d"
                android:gravity="center"
                android:id="@+id/textView8"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/text_noise_ai"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/ivAiLogo"
                style="@style/ClashDisplayVariableSemiBold"/>
            <TextView
                android:textSize="14sp"
                android:textColor="#879399"
                android:gravity="center"
                android:id="@+id/tvSubtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/text_how_may_i_assist_you"
                android:textAllCaps="true"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/textView8"
                style="@style/RobotoMonoRegular"/>
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/cardsContainer"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginLeft="16dp"
                android:layout_marginTop="24dp"
                android:layout_marginRight="16dp"
                android:layout_marginBottom="24dp"
                android:layout_marginHorizontal="16dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/tvSubtitle">
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardAiCompanion"
                    android:visibility="gone"
                    android:clickable="true"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:foreground="?attr/selectableItemBackground"
                    app:cardBackgroundColor="#f7f7f7"
                    app:cardCornerRadius="18dp"
                    app:strokeColor="@color/transparent"
                    app:strokeWidth="0dp">
                    <LinearLayout
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:padding="12dp"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">
                        <ImageView
                            android:layout_gravity="center"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:src="0x7f08021d"/>
                        <LinearLayout
                            android:orientation="vertical"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginLeft="16dp"
                            android:layout_marginRight="16dp"
                            android:layout_weight="1"
                            android:layout_marginHorizontal="16dp">
                            <TextView
                                android:textSize="16sp"
                                android:textColor="#4c5252"
                                android:ellipsize="end"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="@string/text_ai_companion"
                                android:maxLines="1"
                                style="@style/ClashDisplayVariableMedium"/>
                            <TextView
                                android:textSize="10sp"
                                android:textColor="#879399"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="4dp"
                                android:text="@string/text_your_own_ai_buddy_to_answer_your_questions"
                                style="@style/RobotoMonoRegular"/>
                        </LinearLayout>
                        <ImageView
                            android:layout_width="16dp"
                            android:layout_height="16dp"
                            android:src="@drawable/ic_right_blue_arrow"/>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardChatHistory"
                    android:visibility="gone"
                    android:clickable="true"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:foreground="?attr/selectableItemBackground"
                    app:cardBackgroundColor="#f7f7f7"
                    app:cardCornerRadius="18dp"
                    app:strokeColor="@color/transparent"
                    app:strokeWidth="0dp">
                    <LinearLayout
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:padding="12dp"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">
                        <ImageView
                            android:layout_gravity="center"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:src="@drawable/ic_ai_history"/>
                        <LinearLayout
                            android:orientation="vertical"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginLeft="16dp"
                            android:layout_marginRight="16dp"
                            android:layout_weight="1"
                            android:layout_marginHorizontal="16dp">
                            <TextView
                                android:textSize="16sp"
                                android:textColor="#4c5252"
                                android:ellipsize="end"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="@string/text_chat_history"
                                android:maxLines="1"
                                style="@style/ClashDisplayVariableMedium"/>
                            <TextView
                                android:textSize="10sp"
                                android:textColor="#879399"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="4dp"
                                android:text="@string/text_read_resume_your_previous_chats"
                                style="@style/RobotoMonoRegular"/>
                        </LinearLayout>
                        <ImageView
                            android:layout_width="16dp"
                            android:layout_height="16dp"
                            android:src="@drawable/ic_right_blue_arrow"/>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardOnDeviceAi"
                    android:visibility="gone"
                    android:clickable="true"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:foreground="?attr/selectableItemBackground"
                    app:cardBackgroundColor="#f7f7f7"
                    app:cardCornerRadius="18dp"
                    app:strokeColor="@color/transparent"
                    app:strokeWidth="0dp">
                    <LinearLayout
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:padding="12dp"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">
                        <ImageView
                            android:layout_gravity="center"
                            android:id="@+id/imageDevice"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:src="@drawable/ic_ai_device_ai"/>
                        <LinearLayout
                            android:orientation="vertical"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginLeft="16dp"
                            android:layout_marginRight="16dp"
                            android:layout_weight="1"
                            android:layout_marginHorizontal="16dp">
                            <TextView
                                android:textSize="16sp"
                                android:textColor="#4c5252"
                                android:ellipsize="end"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="@string/text_on_device_ai"
                                android:maxLines="1"
                                android:textDirection="locale"
                                style="@style/ClashDisplayVariableMedium"/>
                            <TextView
                                android:textSize="10sp"
                                android:textColor="#879399"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="4dp"
                                android:text="@string/text_learn_how_to_activate_voice_ai_from_your_device"
                                style="@style/RobotoMonoRegular"/>
                        </LinearLayout>
                        <FrameLayout
                            android:layout_width="32dp"
                            android:layout_height="32dp">
                            <ImageView
                                android:layout_gravity="center"
                                android:id="@+id/ivMoreOnDeviceAi"
                                android:layout_width="16dp"
                                android:layout_height="16dp"
                                android:src="@drawable/ic_right_blue_arrow"/>
                            <com.airbnb.lottie.LottieAnimationView
                                android:layout_gravity="center"
                                android:id="@+id/lottieDownloadingOnDeviceAi"
                                android:visibility="gone"
                                android:layout_width="32dp"
                                android:layout_height="32dp"
                                app:lottie_autoPlay="true"
                                app:lottie_loop="true"
                                app:lottie_rawRes="@raw/anim_downloading"/>
                            <ImageView
                                android:layout_gravity="center"
                                android:id="@+id/ivFailedOnDeviceAi"
                                android:padding="6dp"
                                android:visibility="gone"
                                android:layout_width="32dp"
                                android:layout_height="32dp"
                                android:src="@drawable/ic_download_failed"/>
                        </FrameLayout>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardAiTranscription"
                    android:visibility="gone"
                    android:clickable="true"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:foreground="?attr/selectableItemBackground"
                    app:cardBackgroundColor="#f7f7f7"
                    app:cardCornerRadius="18dp"
                    app:strokeColor="@color/transparent"
                    app:strokeWidth="0dp">
                    <LinearLayout
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:padding="12dp"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">
                        <ImageView
                            android:layout_gravity="center"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:src="@drawable/ic_ai_transcription"/>
                        <LinearLayout
                            android:orientation="vertical"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginLeft="16dp"
                            android:layout_marginRight="16dp"
                            android:layout_weight="1"
                            android:layout_marginHorizontal="16dp">
                            <TextView
                                android:textSize="16sp"
                                android:textColor="#4c5252"
                                android:ellipsize="end"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="@string/text_ai_transcription"
                                android:maxLines="1"
                                style="@style/ClashDisplayVariableMedium"/>
                            <TextView
                                android:textSize="10sp"
                                android:textColor="#879399"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="4dp"
                                android:text="@string/text_transcribe_your_meetings_discussions_at_single_tap"
                                style="@style/RobotoMonoRegular"/>
                        </LinearLayout>
                        <ImageView
                            android:layout_width="16dp"
                            android:layout_height="16dp"
                            android:src="@drawable/ic_right_blue_arrow"/>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
            </LinearLayout>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.core.widget.NestedScrollView>
    <include
        android:id="@+id/progressBar"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        layout="@layout/default_loader"/>
</androidx.constraintlayout.widget.ConstraintLayout>
