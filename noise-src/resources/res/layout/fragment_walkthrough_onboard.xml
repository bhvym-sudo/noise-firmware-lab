<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ImageView
        android:id="@+id/main"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        android:adjustViewBounds="true"
        app:layout_constraintBottom_toBottomOf="@+id/nestedScrollView"
        app:layout_constraintEnd_toEndOf="@+id/nestedScrollView"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/nestedScrollView"/>
    <androidx.core.widget.NestedScrollView
        android:id="@+id/nestedScrollView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:fillViewport="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent">
            <View
                android:id="@+id/view1"
                android:background="@drawable/wave_icon_bg"
                android:layout_width="32dp"
                android:layout_height="44dp"
                android:layout_marginTop="@dimen/dimen_28dp"
                android:layout_marginStart="16dp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
            <ImageView
                android:id="@+id/ivWaveform"
                android:background="@drawable/wave_icon_bg"
                android:padding="4dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:layout_constraintBottom_toBottomOf="@+id/view1"
                app:layout_constraintEnd_toEndOf="@+id/view1"
                app:layout_constraintStart_toStartOf="@+id/view1"
                app:layout_constraintTop_toTopOf="@+id/view1"
                app:srcCompat="0x7f0803a4"/>
            <TextView
                android:textSize="18sp"
                android:textColor="#ffffff"
                android:id="@+id/tvLeftText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:lineSpacingExtra="-4sp"
                android:layout_marginStart="8dp"
                android:letterSpacing="0.06"
                app:layout_constraintBottom_toBottomOf="@+id/ivWaveform"
                app:layout_constraintStart_toEndOf="@+id/ivWaveform"
                app:layout_constraintTop_toTopOf="@+id/ivWaveform"
                style="@style/RobotoMonoRegular"/>
            <TextView
                android:textSize="14sp"
                android:textStyle="normal"
                android:textColor="#ffffff"
                android:gravity="center"
                android:id="@+id/tvSkip"
                android:background="@drawable/skip_btn_bg"
                android:paddingTop="4dp"
                android:paddingBottom="4dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/text_skip"
                android:textAllCaps="true"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:layout_marginEnd="16dp"
                android:letterSpacing="0.06"
                app:layout_constraintBottom_toBottomOf="@+id/ivWaveform"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="@+id/ivWaveform"
                style="@style/RobotoMonoRegular"/>
            <TextView
                android:textSize="50sp"
                android:textStyle="normal"
                android:textColor="#ffffff"
                android:id="@+id/tvBottomTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="16dp"
                android:layout_marginRight="16dp"
                android:layout_marginBottom="@dimen/dimen_24dp"
                android:lineSpacingExtra="-18sp"
                android:textAllCaps="true"
                android:letterSpacing="-0.01"
                android:layout_marginHorizontal="16dp"
                app:layout_constraintBottom_toTopOf="@+id/tvBottomDes"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                style="@style/ClashDisplayVariableMedium"/>
            <TextView
                android:textSize="12sp"
                android:textStyle="normal"
                android:textColor="#ffffff"
                android:id="@+id/tvBottomDes"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="74dp"
                android:textAllCaps="true"
                android:layout_marginStart="16dp"
                android:layout_marginEnd="86dp"
                android:letterSpacing="0.06"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                style="@style/RobotoMonoRegular"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.core.widget.NestedScrollView>
</androidx.constraintlayout.widget.ConstraintLayout>
