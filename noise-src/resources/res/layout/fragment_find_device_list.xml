<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:tag="layout/fragment_find_device_list_0"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.airbnb.lottie.LottieAnimationView
        android:id="@+id/animBack"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        android:elevation="-4dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:lottie_autoPlay="true"
        app:lottie_loop="true"
        app:lottie_rawRes="@raw/anim_scanning_ripple_white"/>
    <ImageView
        android:id="@+id/ivBack"
        android:padding="@dimen/dimen_8dp"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="32dp"
        android:src="0x7f080244"
        android:layout_marginStart="20dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textSize="33sp"
        android:textStyle="normal"
        android:textColor="@color/title_color"
        android:gravity="center_horizontal"
        android:id="@+id/tvScanning"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="32dp"
        android:text="@string/text_scanning_uppercase"
        android:lineSpacingExtra="3sp"
        android:letterSpacing="-0.01"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/ClashDisplayVariableSemiBold"/>
    <TextView
        android:textSize="14sp"
        android:textColor="@color/device_text_color"
        android:gravity="center_horizontal"
        android:id="@+id/noiseTextView"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginLeft="32dp"
        android:layout_marginTop="20dp"
        android:layout_marginRight="32dp"
        android:text="@string/text_double_press_power_button_to_make_device_discoverable"
        android:textAllCaps="true"
        android:letterSpacing="0.06"
        android:layout_marginHorizontal="32dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tvScanning"
        style="@style/RobotoMonoRegular"/>
    <ImageView
        android:id="@+id/imgLogo"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@drawable/noise_white_logo"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textSize="14sp"
        android:textColor="#242f36"
        android:gravity="center_horizontal"
        android:id="@+id/tvDeviceFound"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="32dp"
        android:text="@string/text_device_found"
        android:textAllCaps="true"
        android:letterSpacing="0.06"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/RobotoMonoRegular"/>
    <TextView
        android:textSize="32sp"
        android:textColor="@color/title_color"
        android:gravity="center_horizontal"
        android:id="@+id/tvDeviceName"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginLeft="32dp"
        android:layout_marginTop="8dp"
        android:layout_marginRight="32dp"
        android:maxLines="2"
        android:lineSpacingExtra="3sp"
        android:textAllCaps="true"
        android:letterSpacing="-0.01"
        android:layout_marginHorizontal="32dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tvDeviceFound"
        style="@style/ClashDisplayVariableSemiBold"/>
    <TextView
        android:textSize="12sp"
        android:textColor="@color/device_text_color"
        android:id="@+id/tvMac"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tvDeviceName"
        style="@style/RobotoMonoRegular"/>
    <androidx.viewpager2.widget.ViewPager2
        android:id="@+id/rvDevices"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintBottom_toTopOf="@+id/tabLayout"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tvMac"/>
    <com.google.android.material.tabs.TabLayout
        android:id="@+id/tabLayout"
        android:background="@android:color/transparent"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="2dp"
        android:layout_marginBottom="34dp"
        app:layout_constraintBottom_toTopOf="@+id/continue_button"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:tabBackground="@drawable/tab_selector"
        app:tabGravity="center"
        app:tabIndicatorFullWidth="false"
        app:tabIndicatorHeight="0dp"/>
    <com.noise.audio.customviews.NoiseButtonView
        android:textSize="16sp"
        android:textColor="@color/white"
        android:gravity="center"
        android:id="@+id/continue_button"
        android:background="@drawable/round_corner_continue_button"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="68dp"
        android:layout_marginLeft="14dp"
        android:layout_marginRight="14dp"
        android:layout_marginBottom="26dp"
        android:text="@string/text_select_device"
        android:textAllCaps="true"
        android:layout_marginHorizontal="14dp"
        app:layout_constraintBottom_toTopOf="@+id/tvTroubleShoot"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:textAllCaps="true"/>
    <TextView
        android:textSize="12sp"
        android:textStyle="normal"
        android:textColor="#212426"
        android:gravity="center_horizontal"
        android:id="@+id/tvTroubleShoot"
        android:visibility="invisible"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/text_can_t_find_your_device"
        android:textAllCaps="true"
        android:letterSpacing="0.02"
        app:layout_constraintBottom_toTopOf="@+id/tvScanAgain"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        style="@style/RobotoMonoRegular"/>
    <TextView
        android:textSize="12sp"
        android:textStyle="normal"
        android:textColor="#212426"
        android:gravity="center_horizontal"
        android:id="@+id/tvScanAgain"
        android:padding="@dimen/dimen_4dp"
        android:visibility="invisible"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="24dp"
        android:text="@string/text_scan_again"
        android:textAllCaps="true"
        android:letterSpacing="0.02"
        app:layout_constraintBottom_toTopOf="@+id/tvNoiseWarning"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        style="@style/RobotoMonoMedium"/>
    <TextView
        android:textSize="@dimen/text_10sp"
        android:textColor="#b3212426"
        android:gravity="center"
        android:id="@+id/tvNoiseWarning"
        android:visibility="visible"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/dimen_30dp"
        android:layout_marginRight="@dimen/dimen_30dp"
        android:layout_marginBottom="@dimen/dimen_24dp"
        android:text="@string/text_noise_audio_app_only_supports_master_series_nother_noise_earbuds_do_not_need_an_app"
        android:textAllCaps="true"
        android:letterSpacing="0.02"
        android:layout_marginHorizontal="@dimen/dimen_30dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        style="@style/RobotoMonoRegular"/>
    <include
        android:id="@+id/progressBar"
        android:visibility="gone"
        layout="@layout/default_loader"/>
</androidx.constraintlayout.widget.ConstraintLayout>
