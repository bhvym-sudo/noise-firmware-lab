<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <ImageView
        android:id="@+id/vSelectorBG"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:src="@drawable/bg_language_item_selected"
        app:layout_constraintBottom_toBottomOf="@+id/tvLangSubtitle"
        app:layout_constraintEnd_toEndOf="@+id/tvLangTitle"
        app:layout_constraintStart_toStartOf="@+id/tvLangTitle"
        app:layout_constraintTop_toTopOf="@+id/tvLangTitle"/>
    <TextView
        android:textSize="14sp"
        android:textColor="#ffffff"
        android:ellipsize="end"
        android:id="@+id/tvLangTitle"
        android:paddingLeft="14dp"
        android:paddingTop="12dp"
        android:paddingRight="14dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:singleLine="true"
        android:textAllCaps="true"
        android:fontFamily="@font/clash_display_medium"
        android:textDirection="locale"
        android:paddingHorizontal="14dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textSize="14sp"
        android:textColor="#b3ffffff"
        android:ellipsize="end"
        android:id="@+id/tvLangSubtitle"
        android:paddingLeft="14dp"
        android:paddingRight="14dp"
        android:paddingBottom="12dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:singleLine="true"
        android:textAllCaps="true"
        android:fontFamily="@font/clash_display_medium"
        android:textDirection="locale"
        android:paddingHorizontal="14dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tvLangTitle"/>
</androidx.constraintlayout.widget.ConstraintLayout>
