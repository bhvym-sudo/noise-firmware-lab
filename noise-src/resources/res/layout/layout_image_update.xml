<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:tag="layout/layout_image_update_0"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ImageView
        android:id="@+id/imageBack"
        android:layout_width="wrap_content"
        android:layout_height="0dp"
        android:src="0x7f080334"
        android:adjustViewBounds="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <ImageView
        android:id="@+id/ivProfileImg"
        android:padding="10dp"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_margin="52dp"
        android:src="@drawable/ic_default_profile_image"
        android:scaleType="centerCrop"
        app:layout_constraintBottom_toBottomOf="@+id/imageBack"
        app:layout_constraintDimensionRatio="1:1"
        app:layout_constraintEnd_toEndOf="@+id/imageBack"
        app:layout_constraintStart_toStartOf="@+id/imageBack"
        app:layout_constraintTop_toTopOf="@+id/imageBack"
        app:shapeAppearance="@style/ShapeAppearance.App.CircleImageView"/>
    <include
        android:id="@+id/lytUpdate"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="24dp"
        app:layout_constraintBottom_toBottomOf="@+id/ivProfileImg"
        app:layout_constraintEnd_toEndOf="@+id/ivProfileImg"
        app:layout_constraintStart_toStartOf="@+id/ivProfileImg"
        layout="@layout/layout_upload"/>
</androidx.constraintlayout.widget.ConstraintLayout>
