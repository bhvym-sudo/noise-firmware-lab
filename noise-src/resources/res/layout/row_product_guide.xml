<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <TextView
        android:textSize="@dimen/text_size_22"
        android:textColor="@color/guide_title_color"
        android:id="@+id/text_tab_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="58dp"
        android:layout_marginRight="58dp"
        android:textAllCaps="true"
        android:letterSpacing="-0.01"
        android:layout_marginHorizontal="58dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/ClashDisplayVariableMedium"/>
    <TextView
        android:textSize="@dimen/text_size_12"
        android:textColor="#898e95"
        android:gravity="center"
        android:id="@+id/text_tab_sub_title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginLeft="8dp"
        android:layout_marginTop="8dp"
        android:layout_marginRight="8dp"
        android:textAllCaps="true"
        android:letterSpacing="-0.03"
        android:layout_marginHorizontal="8dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/text_tab_title"
        style="@style/RobotoMonoRegular"/>
</androidx.constraintlayout.widget.ConstraintLayout>
