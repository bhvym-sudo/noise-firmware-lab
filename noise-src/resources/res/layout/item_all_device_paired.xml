<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="wrap_content"
    android:layout_height="match_parent">
    <ImageView
        android:id="@+id/imvDevice"
        android:padding="@dimen/dimen_20dp"
        android:layout_width="wrap_content"
        android:layout_height="0dp"
        android:adjustViewBounds="true"
        app:layout_constraintBottom_toTopOf="@+id/btnViewDevice"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_chainStyle="packed"/>
    <ImageView
        android:padding="6dp"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:src="@drawable/ic_dots_three"
        app:layout_constraintBottom_toBottomOf="@+id/btnViewDevice"
        app:layout_constraintEnd_toEndOf="@+id/btnViewDevice"
        app:layout_constraintStart_toStartOf="@+id/btnViewDevice"
        app:layout_constraintTop_toTopOf="@+id/btnViewDevice"/>
    <ImageView
        android:id="@+id/btnViewDevice"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:src="@drawable/back_active_paired_device"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/imvDevice"/>
</androidx.constraintlayout.widget.ConstraintLayout>
