<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/white"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ImageView
        android:id="@+id/ivBack"
        android:padding="16dp"
        android:layout_width="46dp"
        android:layout_height="46dp"
        android:layout_marginTop="6dp"
        android:src="0x7f080244"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <com.google.android.material.materialswitch.MaterialSwitch
        android:id="@+id/switchMaster"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="@dimen/dimen_16dp"
        app:layout_constraintBottom_toBottomOf="@+id/ivBack"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@+id/ivBack"
        app:thumbTint="@color/white"
        app:trackDecorationTint="@color/custom_switch_track_color"
        app:trackTint="@color/custom_switch_track_color"
        style="@style/Widget.Material3.CompoundButton.MaterialSwitch"/>
    <TextView
        android:textSize="34sp"
        android:textColor="#43555e"
        android:id="@+id/textTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="20dp"
        android:layout_marginRight="20dp"
        android:text="@string/text_touch_controls"
        android:textAllCaps="true"
        android:layout_marginHorizontal="20dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/ivBack"
        style="@style/ClashDisplayVariableSemiBold"/>
    <TextView
        android:textSize="12sp"
        android:textColor="#879399"
        android:id="@+id/textMessage"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="16dp"
        android:layout_marginTop="16dp"
        android:layout_marginRight="16dp"
        android:text="@string/text_touch_gesture_message_2"
        android:layout_marginHorizontal="16dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/textTitle"
        style="@style/RobotoMonoMedium"/>
    <androidx.core.widget.NestedScrollView
        android:id="@+id/scrollViewMain"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="16dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/textTitle">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:paddingBottom="24dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <ImageView
                android:id="@+id/ivBudLeft"
                android:layout_width="match_parent"
                android:layout_height="200dp"
                android:src="0x7f0803d4"
                android:scaleType="fitCenter"
                android:alpha="1"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
            <ImageView
                android:id="@+id/ivBudRight"
                android:layout_width="match_parent"
                android:layout_height="200dp"
                android:src="0x7f0803d5"
                android:scaleType="fitCenter"
                android:alpha="0.35"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
            <ImageView
                android:id="@+id/ivBridge"
                android:layout_width="match_parent"
                android:layout_height="200dp"
                android:src="0x7f0803d3"
                android:scaleType="fitCenter"
                android:alpha="0"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
            <LinearLayout
                android:orientation="horizontal"
                android:id="@+id/lytTabs"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/ivBudLeft">
                <include
                    android:id="@+id/btnLeft"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    layout="@layout/layout_touch_buttons"/>
                <include
                    android:id="@+id/btnRight"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    layout="@layout/layout_touch_buttons"/>
                <include
                    android:id="@+id/btnCBridge"
                    android:visibility="gone"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    layout="@layout/layout_touch_buttons"/>
            </LinearLayout>
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/lytControls"
                android:background="@drawable/back_modal_light_white"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="16dp"
                android:layout_marginTop="16dp"
                android:layout_marginRight="16dp"
                android:layout_marginHorizontal="16dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/barrierRows">
                <include
                    android:id="@+id/lytTapOnce"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    layout="@layout/item_gesture"/>
                <View
                    android:id="@+id/dividerTapOnce"
                    android:background="#4d879399"
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginStart="80dp"/>
                <include
                    android:id="@+id/lytTapTwice"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    layout="@layout/item_gesture"/>
                <View
                    android:id="@+id/dividerTapTwice"
                    android:background="#4d879399"
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginStart="80dp"/>
                <include
                    android:id="@+id/lytTapThrice"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    layout="@layout/item_gesture"/>
                <View
                    android:id="@+id/dividerTapThrice"
                    android:background="#4d879399"
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginStart="80dp"/>
                <include
                    android:id="@+id/lytTapFourTimes"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    layout="@layout/item_gesture"/>
                <View
                    android:id="@+id/dividerTapFour"
                    android:background="#4d879399"
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginStart="80dp"/>
                <include
                    android:id="@+id/lytTapHold"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    layout="@layout/item_gesture"/>
                <View
                    android:id="@+id/dividerTapHold"
                    android:background="#4d879399"
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginStart="80dp"/>
                <include
                    android:id="@+id/lytTapDoubleHold"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    layout="@layout/item_gesture"/>
            </LinearLayout>
            <TextView
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="#bb1515"
                android:gravity="center"
                android:id="@+id/btnResetAll"
                android:background="@drawable/back_forgot_device"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="24dp"
                android:text="@string/text_reset_all"
                android:textAllCaps="true"
                android:layout_marginStart="16dp"
                android:layout_marginEnd="16dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/lytControls"
                style="@style/RobotoMonoMedium"/>
            <include
                android:id="@+id/progressBar"
                android:visibility="gone"
                android:layout_width="0dp"
                android:layout_height="0dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                layout="@layout/default_loader"/>
            <View
                android:id="@+id/viewBackInEar"
                android:background="@drawable/back_modal_light_white"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginLeft="16dp"
                android:layout_marginTop="20dp"
                android:layout_marginRight="16dp"
                android:layout_marginHorizontal="16dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/lytTabs"/>
            <TextView
                android:textColor="#54656d"
                android:ellipsize="end"
                android:id="@+id/labelInEar"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="@string/text_in_ear_detection"
                android:singleLine="true"
                android:textAllCaps="true"
                android:layout_marginStart="24dp"
                android:layout_marginEnd="6dp"
                app:layout_constraintBottom_toBottomOf="@+id/viewBackInEar"
                app:layout_constraintEnd_toStartOf="@+id/switchInEarDetection"
                app:layout_constraintStart_toStartOf="@+id/viewBackInEar"
                app:layout_constraintTop_toTopOf="@+id/viewBackInEar"
                style="@style/RobotoMonoRegular"/>
            <com.google.android.material.materialswitch.MaterialSwitch
                android:id="@+id/switchInEarDetection"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="@dimen/dimen_24dp"
                app:layout_constraintBottom_toBottomOf="@+id/viewBackInEar"
                app:layout_constraintEnd_toEndOf="@+id/viewBackInEar"
                app:layout_constraintTop_toTopOf="@+id/viewBackInEar"
                app:thumbTint="@color/white"
                app:trackDecorationTint="@color/custom_switch_track_color"
                app:trackTint="@color/custom_switch_track_color"
                style="@style/Widget.Material3.CompoundButton.MaterialSwitch"/>
            <androidx.constraintlayout.widget.Group
                android:id="@+id/groupContent"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:constraint_referenced_ids="viewBackInEar,labelInEar,switchInEarDetection"/>
            <View
                android:id="@+id/viewBackCBridge"
                android:background="@drawable/back_modal_light_white"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginLeft="16dp"
                android:layout_marginTop="20dp"
                android:layout_marginRight="16dp"
                android:layout_marginHorizontal="16dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/lytTabs"/>
            <TextView
                android:textColor="#4c5252"
                android:ellipsize="end"
                android:id="@+id/labelCBridge"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="@string/text_c_bridge_touch_sensor"
                android:singleLine="true"
                android:layout_marginStart="24dp"
                android:layout_marginEnd="6dp"
                app:layout_constraintBottom_toBottomOf="@+id/viewBackCBridge"
                app:layout_constraintEnd_toStartOf="@+id/switchCBridge"
                app:layout_constraintStart_toStartOf="@+id/viewBackCBridge"
                app:layout_constraintTop_toTopOf="@+id/viewBackCBridge"
                style="@style/ClashDisplayMedium"/>
            <com.google.android.material.materialswitch.MaterialSwitch
                android:id="@+id/switchCBridge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="@dimen/dimen_24dp"
                app:layout_constraintBottom_toBottomOf="@+id/viewBackCBridge"
                app:layout_constraintEnd_toEndOf="@+id/viewBackCBridge"
                app:layout_constraintTop_toTopOf="@+id/viewBackCBridge"
                app:thumbTint="@color/white"
                app:trackDecorationTint="@color/custom_switch_track_color"
                app:trackTint="@color/custom_switch_track_color"
                style="@style/Widget.Material3.CompoundButton.MaterialSwitch"/>
            <androidx.constraintlayout.widget.Group
                android:id="@+id/groupCBridge"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:constraint_referenced_ids="viewBackCBridge,labelCBridge,switchCBridge"/>
            <androidx.constraintlayout.widget.Barrier
                android:id="@+id/barrierRows"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:barrierAllowsGoneWidgets="false"
                app:barrierDirection="bottom"
                app:constraint_referenced_ids="lytTabs,viewBackInEar,viewBackCBridge"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.core.widget.NestedScrollView>
</androidx.constraintlayout.widget.ConstraintLayout>
