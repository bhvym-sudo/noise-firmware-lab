<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/title_color"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ImageView
        android:id="@+id/img_back"
        android:padding="@dimen/dimen_8dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="0x7f080244"
        android:layout_marginStart="16dp"
        app:layout_constraintBottom_toBottomOf="@+id/text_title"
        app:layout_constraintEnd_toStartOf="@+id/text_title"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/text_title"
        app:tint="@color/white"/>
    <TextView
        android:textSize="24sp"
        android:textColor="@color/white"
        android:id="@+id/text_title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="32dp"
        android:text="@string/text_my_profile_"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        app:layout_constraintEnd_toStartOf="@+id/img_edit"
        app:layout_constraintStart_toEndOf="@+id/img_back"
        app:layout_constraintTop_toTopOf="parent"
        app:textAllCaps="true"
        style="@style/ClashDisplayVariableMedium"/>
    <include
        android:id="@+id/lytUpdate"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        app:layout_constraintBottom_toTopOf="@+id/cardView"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/text_title"
        layout="@layout/layout_image_update"/>
    <ImageView
        android:id="@+id/img_edit"
        android:padding="@dimen/dimen_8dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="0x7f08029c"
        android:layout_marginEnd="16dp"
        app:layout_constraintBottom_toBottomOf="@+id/text_title"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@+id/text_title"/>
    <androidx.cardview.widget.CardView
        android:id="@+id/cardView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="@dimen/dimen_12dp"
        app:cardBackgroundColor="@color/white"
        app:cardCornerRadius="30dp"
        app:cardElevation="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">
        <LinearLayout
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <TextView
                android:textSize="@dimen/text_12sp"
                android:textColor="#3a414e"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dimen_48dp"
                android:text="@string/your_name"
                android:letterSpacing="-0.03"
                app:textAllCaps="true"
                style="@style/RobotoMonoRegular"/>
            <TextView
                android:textSize="@dimen/text_size_22"
                android:textColor="#5d6262"
                android:gravity="center"
                android:id="@+id/text_user_name"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="@dimen/dimen_48dp"
                android:layout_marginTop="@dimen/dimen_12dp"
                android:layout_marginRight="@dimen/dimen_48dp"
                android:letterSpacing="-0.01"
                android:layout_marginHorizontal="@dimen/dimen_48dp"
                style="@style/ClashDisplayVariableMedium"/>
            <TextView
                android:textSize="@dimen/text_12sp"
                android:textColor="#3a414e"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="32dp"
                android:text="@string/d_o_b"
                android:letterSpacing="-0.03"
                app:textAllCaps="true"
                style="@style/RobotoMonoRegular"/>
            <TextView
                android:textSize="@dimen/text_size_22"
                android:textColor="@color/profile_input_info_color"
                android:gravity="center"
                android:id="@+id/text_user_dob"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="@dimen/dimen_48dp"
                android:layout_marginTop="@dimen/dimen_8dp"
                android:layout_marginRight="@dimen/dimen_48dp"
                android:layout_marginHorizontal="@dimen/dimen_48dp"
                app:textAllCaps="true"
                style="@style/ClashDisplayVariableMedium"/>
            <TextView
                android:textSize="@dimen/text_12sp"
                android:textColor="#3a414e"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="32dp"
                android:text="@string/your_email"
                android:letterSpacing="-0.03"
                app:textAllCaps="true"
                style="@style/RobotoMonoRegular"/>
            <TextView
                android:textSize="@dimen/text_size_22"
                android:textColor="#5d6262"
                android:gravity="center"
                android:id="@+id/text_email_address"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="@dimen/side_margin"
                android:layout_marginTop="@dimen/dimen_12dp"
                android:layout_marginRight="@dimen/side_margin"
                android:layout_marginBottom="@dimen/dimen_48dp"
                android:letterSpacing="-0.01"
                android:layout_marginHorizontal="@dimen/side_margin"
                style="@style/ClashDisplayVariableMedium"/>
        </LinearLayout>
    </androidx.cardview.widget.CardView>
    <include
        android:id="@+id/progressBar"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        layout="@layout/default_loader"/>
</androidx.constraintlayout.widget.ConstraintLayout>
