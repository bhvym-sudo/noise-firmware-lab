<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/constraintLayout7"
        android:layout_width="0dp"
        android:layout_height="172dp"
        android:layout_marginTop="12dp"
        app:cardBackgroundColor="#f7f7f7"
        app:cardCornerRadius="18dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/constraintLayout8"
        app:layout_constraintHorizontal_bias="0.5"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:strokeColor="@color/transparent">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/lytDualPairing"
            android:background="@drawable/back_card_v2"
            android:padding="16dp"
            android:layout_width="match_parent"
            android:layout_height="172dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/constraintLayout8"
            app:layout_constraintHorizontal_bias="0.5"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">
            <ImageView
                android:id="@+id/ivMore1"
                android:padding="10dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/ic_right_blue_arrow"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
            <ImageView
                android:id="@+id/imv1"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:src="@drawable/ic_new_dual_pairing"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
            <TextView
                android:textSize="16sp"
                android:textStyle="normal"
                android:textColor="@color/card_title_color"
                android:gravity="start"
                android:id="@+id/tvTitle1"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="@string/text_dual_pairing"
                android:letterSpacing="-0.01"
                app:layout_constraintBottom_toTopOf="@+id/tvSubText1"
                app:layout_constraintStart_toStartOf="parent"
                style="@style/ClashDisplayVariableMedium"/>
            <TextView
                android:textSize="12sp"
                android:textStyle="normal"
                android:textColor="@color/card_message_color"
                android:ellipsize="end"
                android:id="@+id/tvSubText1"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="@string/text_connect_with_two_devices_at_a_time"
                android:maxLines="3"
                android:letterSpacing="-0.01"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                style="@style/RobotoMonoRegular"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </com.google.android.material.card.MaterialCardView>
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/constraintLayout8"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="12dp"
        android:layout_marginStart="12dp"
        app:cardBackgroundColor="#f7f7f7"
        app:cardCornerRadius="18dp"
        app:layout_constraintBottom_toTopOf="@+id/constraintLayout9"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.5"
        app:layout_constraintStart_toEndOf="@+id/constraintLayout7"
        app:layout_constraintTop_toTopOf="parent"
        app:strokeColor="@color/transparent">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/lytSound"
            android:padding="16dp"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:layout_constraintBottom_toTopOf="@+id/constraintLayout9"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_bias="0.5"
            app:layout_constraintStart_toEndOf="@+id/constraintLayout7"
            app:layout_constraintTop_toTopOf="parent">
            <TextView
                android:textSize="16sp"
                android:textStyle="normal"
                android:textColor="@color/card_title_color"
                android:gravity="start"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="@string/text_sound"
                android:letterSpacing="-0.01"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toStartOf="@+id/imvSoundArrow"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                style="@style/ClashDisplayVariableMedium"/>
            <ImageView
                android:id="@+id/imvSoundArrow"
                android:padding="10dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/ic_right_blue_arrow"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </com.google.android.material.card.MaterialCardView>
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/constraintLayout9"
        android:padding="16dp"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="12dp"
        android:layout_marginStart="12dp"
        app:cardBackgroundColor="#f7f7f7"
        app:cardCornerRadius="18dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.5"
        app:layout_constraintStart_toEndOf="@+id/constraintLayout7"
        app:layout_constraintTop_toBottomOf="@+id/constraintLayout8"
        app:strokeColor="@color/transparent">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/lytControls"
            android:padding="16dp"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_bias="0.5"
            app:layout_constraintStart_toEndOf="@+id/constraintLayout7"
            app:layout_constraintTop_toBottomOf="@+id/constraintLayout8">
            <TextView
                android:textSize="16sp"
                android:textStyle="normal"
                android:textColor="@color/card_title_color"
                android:gravity="start"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="@string/text_controls"
                android:letterSpacing="-0.01"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toStartOf="@+id/imvControlsArrow"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                style="@style/ClashDisplayVariableMedium"/>
            <ImageView
                android:id="@+id/imvControlsArrow"
                android:padding="10dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/ic_right_blue_arrow"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </com.google.android.material.card.MaterialCardView>
</androidx.constraintlayout.widget.ConstraintLayout>
