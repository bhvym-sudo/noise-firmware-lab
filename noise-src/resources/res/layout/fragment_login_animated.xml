<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@android:color/transparent"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:id="@+id/linearLayout4"
        android:background="@android:color/transparent"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="-120dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <ImageView
            android:id="@+id/ivBackMain"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:src="0x7f0803d9"
            android:scaleType="centerCrop"/>
    </LinearLayout>
    <ImageView
        android:id="@+id/ivBackMain2"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:src="0x7f0803d9"
        android:scaleType="centerCrop"
        app:layout_constraintBottom_toBottomOf="@+id/imageBlur"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <ImageView
        android:id="@+id/imageBlur"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:src="0x7f0803d8"
        android:scaleType="centerCrop"
        android:alpha="0"
        app:layout_constraintBottom_toBottomOf="@+id/vTop"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <ImageView
        android:id="@+id/imageViewNoiseLogo"
        android:layout_width="100dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="80dp"
        android:src="0x7f08030e"
        android:layout_centerHorizontal="true"
        android:alpha="0"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.498"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textSize="28sp"
        android:textColor="@color/white"
        android:id="@+id/textCreateAccount"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginBottom="32dp"
        android:text="@string/text_experience_npure_audio_nyour_way"
        android:layout_above="@+id/btn_continue"
        android:alpha="0"
        android:textAllCaps="true"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp"
        app:layout_constraintBottom_toTopOf="@+id/btn_continue"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        style="@style/ClashDisplayVariableSemiBold"/>
    <com.noise.audio.customviews.NoiseContinueButton2
        android:id="@+id/btn_continue"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="30dp"
        android:layout_alignParentBottom="true"
        android:alpha="0"
        android:layout_marginStart="20dp"
        app:layout_constraintBottom_toBottomOf="@+id/vTop"
        app:layout_constraintStart_toStartOf="parent"/>
    <View
        android:id="@+id/vTop"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintBottom_toTopOf="@+id/vBottomBack"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_weight="0.7"/>
    <View
        android:id="@+id/vBottomBack"
        android:background="@android:color/white"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:alpha="0"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/vTop"
        app:layout_constraintVertical_weight="0.3"/>
    <com.noise.audio.customviews.NoiseTextView
        android:textSize="22sp"
        android:textColor="#628c92"
        android:id="@+id/textLoginUsing"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/text_or_login_using"
        android:alpha="0"
        android:textAllCaps="true"
        android:layout_marginStart="20dp"
        android:letterSpacing="-0.01"
        app:layout_constraintBottom_toTopOf="@+id/imageGoogleLogin"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/vTop"
        style="@style/ClashDisplayVariableMedium"/>
    <ImageView
        android:id="@+id/imageGoogleLogin"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="0x7f0803ac"
        android:alpha="0"
        android:layout_marginStart="20dp"
        app:layout_constraintBottom_toTopOf="@+id/chbx"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/textLoginUsing"/>
    <ImageView
        android:id="@+id/imageEmailLogin"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@drawable/ic_email_login"
        android:alpha="0"
        android:layout_marginStart="@dimen/dimen_20dp"
        app:layout_constraintBottom_toTopOf="@+id/chbx"
        app:layout_constraintStart_toEndOf="@+id/imageGoogleLogin"
        app:layout_constraintTop_toBottomOf="@+id/textLoginUsing"/>
    <com.google.android.material.checkbox.MaterialCheckBox
        android:id="@+id/chbx"
        android:padding="@dimen/dimen_0dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:alpha="0"
        android:layout_marginStart="20dp"
        app:buttonTint="#43555e"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/imageGoogleLogin"/>
    <TextView
        android:textSize="12sp"
        android:textColor="#43555e"
        android:id="@+id/tvPrivacyText"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="@string/text_terms_privacy_policy"
        android:alpha="0"
        android:textAllCaps="true"
        android:layout_marginEnd="24dp"
        android:letterSpacing="0.06"
        app:layout_constraintBottom_toBottomOf="@+id/chbx"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/chbx"
        app:layout_constraintTop_toTopOf="@+id/chbx"
        style="@style/RobotoMonoRegular"/>
    <ImageView
        android:id="@+id/bgLanguageSwitch"
        android:visibility="invisible"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:src="0x7f08011c"
        android:adjustViewBounds="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>
    <include
        android:id="@+id/lytLanguageSwitch"
        android:visibility="invisible"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/dimen_16dp"
        android:layout_marginRight="@dimen/dimen_16dp"
        android:layout_marginBottom="42dp"
        android:layout_marginHorizontal="@dimen/dimen_16dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        layout="@layout/layout_language_switch"/>
    <include
        android:id="@+id/progressBar"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        layout="@layout/default_loader"/>
</androidx.constraintlayout.widget.ConstraintLayout>
