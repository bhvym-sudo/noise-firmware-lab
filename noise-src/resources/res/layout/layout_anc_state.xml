<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <View
        android:id="@+id/viewAncOff"
        android:background="@drawable/circle_white"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:layout_marginEnd="7dp"
        app:layout_constraintBottom_toBottomOf="@+id/btnAncOffCircle"
        app:layout_constraintEnd_toEndOf="@+id/btnAncOffCircle"
        app:layout_constraintStart_toStartOf="@+id/btnAncOffCircle"
        app:layout_constraintTop_toTopOf="@+id/btnAncOffCircle"/>
    <ImageButton
        android:id="@+id/btnAncOffCircle"
        android:background="@color/transparent"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:src="@drawable/back_anc_circle"
        android:layout_marginStart="@dimen/dimen_16dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <ImageView
        android:id="@+id/imvAncOff"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@drawable/ic_anc_off_black"
        app:layout_constraintBottom_toBottomOf="@+id/viewAncOff"
        app:layout_constraintEnd_toEndOf="@+id/viewAncOff"
        app:layout_constraintStart_toStartOf="@+id/viewAncOff"
        app:layout_constraintTop_toTopOf="@+id/viewAncOff"/>
    <TextView
        android:textSize="10sp"
        android:textStyle="normal"
        android:textColor="#828f95"
        android:gravity="center_horizontal"
        android:id="@+id/tvAncOff"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dimen_8dp"
        android:text="@string/text_off"
        android:letterSpacing="0.06"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="@+id/viewAncOff"
        app:layout_constraintStart_toStartOf="@+id/viewAncOff"
        app:layout_constraintTop_toBottomOf="@+id/viewAncOff"
        style="@style/RobotoMonoRegular"/>
    <View
        android:id="@+id/viewTransparency"
        android:background="@drawable/circle_white"
        android:padding="@dimen/dimen_2dp"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:layout_marginStart="-2dp"
        app:layout_constraintBottom_toBottomOf="@+id/btnTransparencyCircle"
        app:layout_constraintEnd_toEndOf="@+id/btnTransparencyCircle"
        app:layout_constraintStart_toStartOf="@+id/btnTransparencyCircle"
        app:layout_constraintTop_toTopOf="@+id/btnTransparencyCircle"/>
    <ImageView
        android:id="@+id/imvTransparency"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@drawable/ic_transparency_blue"
        app:layout_constraintBottom_toBottomOf="@+id/viewTransparency"
        app:layout_constraintEnd_toEndOf="@+id/viewTransparency"
        app:layout_constraintStart_toStartOf="@+id/viewTransparency"
        app:layout_constraintTop_toTopOf="@+id/viewTransparency"/>
    <ImageButton
        android:id="@+id/btnTransparencyCircle"
        android:background="@color/transparent"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:src="@drawable/back_anc_circle"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textSize="10sp"
        android:textStyle="normal"
        android:textColor="#828f95"
        android:gravity="center_horizontal"
        android:id="@+id/tvTransparency"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dimen_8dp"
        android:text="@string/text_transparency"
        android:letterSpacing="0.06"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="@+id/btnTransparencyCircle"
        app:layout_constraintStart_toStartOf="@+id/btnTransparencyCircle"
        app:layout_constraintTop_toBottomOf="@+id/viewTransparency"
        style="@style/RobotoMonoRegular"/>
    <View
        android:id="@+id/viewAnc"
        android:background="@drawable/circle_white"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:layout_marginStart="6dp"
        app:layout_constraintBottom_toBottomOf="@+id/btnAncCircle"
        app:layout_constraintEnd_toEndOf="@+id/btnAncCircle"
        app:layout_constraintStart_toStartOf="@+id/btnAncCircle"
        app:layout_constraintTop_toTopOf="@+id/btnAncCircle"/>
    <ImageButton
        android:id="@+id/btnAncCircle"
        android:background="@color/transparent"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:src="@drawable/back_anc_circle"
        android:rotation="-180"
        android:layout_marginEnd="@dimen/dimen_16dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <ImageView
        android:id="@+id/imvAnc"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@drawable/ic_anc_on_black"
        app:layout_constraintBottom_toBottomOf="@+id/viewAnc"
        app:layout_constraintEnd_toEndOf="@+id/viewAnc"
        app:layout_constraintStart_toStartOf="@+id/viewAnc"
        app:layout_constraintTop_toTopOf="@+id/viewAnc"/>
    <TextView
        android:textSize="10sp"
        android:textStyle="normal"
        android:textColor="#828f95"
        android:gravity="center_horizontal"
        android:id="@+id/tvAnc"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dimen_8dp"
        android:text="@string/text_anc"
        android:letterSpacing="0.06"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="@+id/viewAnc"
        app:layout_constraintStart_toStartOf="@+id/viewAnc"
        app:layout_constraintTop_toBottomOf="@+id/viewAnc"
        style="@style/RobotoMonoRegular"/>
</androidx.constraintlayout.widget.ConstraintLayout>
