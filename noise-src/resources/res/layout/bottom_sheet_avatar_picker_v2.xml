<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:tag="layout/bottom_sheet_avatar_picker_v2_0"
    android:background="@android:color/transparent"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:background="@drawable/back_modal_dialog_ad_stroke"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="12dp">
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:id="@+id/rowTakePhoto"
            android:paddingLeft="16dp"
            android:paddingRight="16dp"
            android:layout_width="0dp"
            android:layout_height="92dp"
            android:paddingHorizontal="16dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">
            <FrameLayout
                android:background="@drawable/ic_ring_v2"
                android:layout_width="48dp"
                android:layout_height="48dp">
                <ImageView
                    android:layout_gravity="center"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/ic_profile_camera"/>
            </FrameLayout>
            <TextView
                android:textSize="16sp"
                android:textColor="#54656d"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="@string/text_take_a_photo"
                android:layout_weight="1"
                android:layout_marginStart="16dp"
                style="@style/ClashDisplayVariableMedium"/>
            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_right_blue_arrow"/>
        </LinearLayout>
        <View
            android:id="@+id/dividerPicker"
            android:background="#8793994d"
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_marginStart="80dp"
            app:layout_constraintBottom_toBottomOf="@+id/rowTakePhoto"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"/>
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:id="@+id/rowGallery"
            android:paddingLeft="16dp"
            android:paddingRight="16dp"
            android:layout_width="0dp"
            android:layout_height="92dp"
            android:paddingHorizontal="16dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/rowTakePhoto">
            <FrameLayout
                android:background="@drawable/ic_ring_v2"
                android:layout_width="48dp"
                android:layout_height="48dp">
                <ImageView
                    android:layout_gravity="center"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/ic_picker_gallery"/>
            </FrameLayout>
            <TextView
                android:textSize="16sp"
                android:textColor="#54656d"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="@string/text_upload_from_gallery"
                android:layout_weight="1"
                android:layout_marginStart="16dp"
                style="@style/ClashDisplayVariableMedium"/>
            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_right_blue_arrow"/>
        </LinearLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>
</RelativeLayout>
