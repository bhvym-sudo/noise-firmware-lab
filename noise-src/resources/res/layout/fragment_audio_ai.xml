<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="#cccdcdd3"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ImageView
        android:id="@+id/imageView5"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:src="0x7f080097"
        android:adjustViewBounds="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>
    <View
        android:id="@+id/view6"
        android:background="@drawable/back_ai_audio"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="24dp"
        android:layout_marginBottom="54dp"
        android:layout_marginStart="24dp"
        android:layout_marginEnd="24dp"
        app:layout_constraintBottom_toBottomOf="@+id/tvMessage"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <ImageView
        android:id="@+id/ivCross"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_marginBottom="40dp"
        android:src="@drawable/ic_cross_with_back"
        android:layout_marginEnd="24dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>
    <TextView
        android:textSize="14sp"
        android:textColor="#b342454a"
        android:gravity="center"
        android:id="@+id/tvMessage"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp"
        android:textAllCaps="true"
        app:layout_constraintBottom_toTopOf="@+id/ivButtonState"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        style="@style/RobotoMonoMedium"/>
    <ImageView
        android:id="@+id/ivMic"
        android:visibility="gone"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:layout_marginBottom="12dp"
        android:src="@drawable/ic_mic_off"
        app:layout_constraintBottom_toTopOf="@+id/ivButtonState"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>
    <com.noise.audio.ui.customView.AudioTalkingView
        android:id="@+id/talkingView"
        android:visibility="gone"
        android:layout_width="184dp"
        android:layout_height="22dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <com.noise.audio.ui.customView.AudioBarsView
        android:id="@+id/audioBarsTalking"
        android:visibility="visible"
        android:layout_width="0dp"
        android:layout_height="140dp"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        app:barCount="10"
        app:barSpacing="4dp"
        app:circleRadius="6dp"
        app:innerInset="3dp"
        app:layout_constraintBottom_toBottomOf="@+id/view6"
        app:layout_constraintEnd_toEndOf="@+id/view6"
        app:layout_constraintStart_toStartOf="@+id/view6"
        app:layout_constraintTop_toTopOf="@+id/view6"
        app:minBarHeightFraction="0.2"/>
    <ImageView
        android:id="@+id/ivButtonState"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@drawable/image_ai_button"
        app:layout_constraintBottom_toBottomOf="@+id/ivCross"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/ivCross"/>
    <ImageView
        android:id="@+id/ivAiStop"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@drawable/image_ai_stop"
        app:layout_constraintBottom_toBottomOf="@+id/ivCross"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/ivCross"/>
    <TextView
        android:textSize="14sp"
        android:gravity="center"
        android:id="@+id/tvLogs"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="40dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/RobotoMonoMedium"/>
    <include
        android:id="@+id/progressBar"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        layout="@layout/default_loader"/>
    <androidx.constraintlayout.widget.Group
        android:id="@+id/groupRetry"
        android:visibility="invisible"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:constraint_referenced_ids="tvRetry,ivButtonError"/>
    <ImageView
        android:id="@+id/ivButtonError"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@drawable/ic_ai_back_tap"
        app:layout_constraintBottom_toBottomOf="@+id/ivCross"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/ivCross"/>
    <TextView
        android:textColor="@color/white"
        android:gravity="center"
        android:id="@+id/tvRetry"
        android:paddingLeft="6dp"
        android:paddingRight="6dp"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="@string/text_retry"
        android:textAllCaps="true"
        android:fontFamily="@font/clash_display_medium"
        android:paddingHorizontal="6dp"
        app:layout_constraintBottom_toBottomOf="@+id/ivButtonError"
        app:layout_constraintEnd_toEndOf="@+id/ivButtonError"
        app:layout_constraintStart_toStartOf="@+id/ivButtonError"
        app:layout_constraintTop_toTopOf="@+id/ivButtonError"
        style="@style/S16"/>
</androidx.constraintlayout.widget.ConstraintLayout>
