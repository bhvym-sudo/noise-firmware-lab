<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/cardRoot"
    android:layout_width="match_parent"
    android:layout_height="172dp"
    app:cardBackgroundColor="#f7f7f7"
    app:cardCornerRadius="18dp"
    app:strokeColor="@color/transparent">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/lytContent"
        android:padding="16dp"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <ImageView
            android:id="@+id/imvIcon"
            android:layout_width="48dp"
            android:layout_height="48dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/ivSwitch"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:thumbTint="@color/white"
            app:trackDecorationTint="@color/custom_switch_track_color"
            app:trackTint="@color/custom_switch_track_color"
            style="@style/Widget.Material3.CompoundButton.MaterialSwitch"/>
        <TextView
            android:textSize="16sp"
            android:textStyle="normal"
            android:textColor="@color/card_title_color"
            android:gravity="start"
            android:id="@+id/tvTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:letterSpacing="-0.01"
            app:layout_constraintBottom_toTopOf="@+id/tvSubText"
            app:layout_constraintStart_toStartOf="parent"
            style="@style/ClashDisplayVariableMedium"/>
        <TextView
            android:textSize="12sp"
            android:textStyle="normal"
            android:textColor="@color/card_message_color"
            android:ellipsize="end"
            android:id="@+id/tvSubText"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:maxLines="3"
            android:letterSpacing="-0.01"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            style="@style/RobotoMonoRegular"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</com.google.android.material.card.MaterialCardView>
