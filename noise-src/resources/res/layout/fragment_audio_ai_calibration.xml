<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ImageView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:src="0x7f080097"
        android:adjustViewBounds="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>
    <ImageView
        android:id="@+id/ivCross"
        android:padding="8dp"
        android:layout_width="38dp"
        android:layout_height="38dp"
        android:layout_marginTop="16dp"
        android:src="@drawable/ic_toolbar_cross_2"
        android:layout_marginStart="16dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:tint="#43555e"/>
    <ImageView
        android:id="@+id/imageView62"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@drawable/ic_toolbar_cross_2"
        app:layout_constraintBottom_toBottomOf="@+id/ivCross"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/ivCross"/>
    <TextView
        android:textColor="#43555e"
        android:gravity="center"
        android:id="@+id/tvHeader"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="48dp"
        android:layout_marginEnd="48dp"
        app:layout_constraintBottom_toTopOf="@+id/tvMessage"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/imageView62"
        app:layout_constraintVertical_bias="0.2"
        app:layout_constraintVertical_chainStyle="packed"
        style="@style/ClashDisplayVariableMedium"/>
    <TextView
        android:textColor="#879399"
        android:gravity="center"
        android:id="@+id/tvMessage"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:layout_marginStart="48dp"
        android:layout_marginEnd="48dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.5"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tvHeader"
        style="@style/RobotoMonoMedium"/>
    <TextView
        android:textColor="#43555e"
        android:gravity="center"
        android:id="@+id/tvListening"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginBottom="26dp"
        android:text="@string/text_listening_dot"
        android:layout_marginStart="32dp"
        android:layout_marginEnd="32dp"
        app:layout_constraintBottom_toTopOf="@+id/ivStart"
        app:layout_constraintEnd_toEndOf="@+id/ivStart"
        app:layout_constraintStart_toStartOf="@+id/ivStart"
        style="@style/ClashDisplayVariableMedium"/>
    <com.google.android.material.imageview.ShapeableImageView
        android:id="@+id/ivAllSet"
        android:background="#232726"
        android:visibility="invisible"
        android:layout_width="80dp"
        android:layout_height="80dp"
        android:layout_marginBottom="76dp"
        android:src="@drawable/ic_ai_all_set"
        app:contentPadding="18dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:shapeAppearance="@style/ShapeAppearance.App.CircleImageView"/>
    <com.google.android.material.imageview.ShapeableImageView
        android:id="@+id/ivStart"
        android:background="#232726"
        android:visibility="invisible"
        android:layout_width="80dp"
        android:layout_height="80dp"
        android:layout_marginBottom="76dp"
        android:src="@drawable/ic_ai_mic"
        android:tint="@color/white"
        app:contentPadding="18dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:shapeAppearance="@style/ShapeAppearance.App.CircleImageView"/>
    <com.google.android.material.progressindicator.CircularProgressIndicator
        android:id="@+id/progressBarRecording"
        android:padding="0dp"
        android:visibility="gone"
        android:layout_width="80dp"
        android:layout_height="80dp"
        android:progress="30"
        android:indeterminate="false"
        app:indicatorColor="@color/white"
        app:indicatorSize="80dp"
        app:layout_constraintBottom_toBottomOf="@+id/ivStart"
        app:layout_constraintEnd_toEndOf="@+id/ivStart"
        app:layout_constraintStart_toStartOf="@+id/ivStart"
        app:layout_constraintTop_toTopOf="@+id/ivStart"
        app:trackColor="#1effffff"
        app:trackThickness="4dp"/>
    <include
        android:id="@+id/lytBottomChecks2"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="18dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        layout="@layout/layout_calibration_bottom"/>
    <include
        android:id="@+id/progressBar"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        layout="@layout/default_loader"/>
</androidx.constraintlayout.widget.ConstraintLayout>
