<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="172dp"
    android:layout_margin="6dp"
    app:cardBackgroundColor="#f7f7f7"
    app:cardCornerRadius="18dp"
    app:cardElevation="0dp"
    app:strokeColor="@color/transparent">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:padding="16dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="172dp">
        <FrameLayout
            android:id="@+id/lytIcon"
            android:background="@drawable/ic_ring_v2"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:foregroundGravity="center"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">
            <ImageView
                android:layout_gravity="center"
                android:id="@+id/imvIcon"
                android:layout_width="24dp"
                android:layout_height="24dp"/>
        </FrameLayout>
        <ImageView
            android:id="@+id/imvNext"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:src="@drawable/ic_right_blue_arrow"
            app:layout_constraintBottom_toBottomOf="@+id/lytIcon"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@+id/lytIcon"
            app:tint="#54656d"/>
        <TextView
            android:textSize="16sp"
            android:textColor="#43555e"
            android:ellipsize="end"
            android:id="@+id/tvTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:maxLines="1"
            app:layout_constraintBottom_toTopOf="@+id/tvSubtitle"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="@+id/lytIcon"
            style="@style/ClashDisplayVariableMedium"/>
        <TextView
            android:textSize="12sp"
            android:textColor="#879399"
            android:ellipsize="end"
            android:id="@+id/tvSubtitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:maxLines="3"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="@+id/tvTitle"
            style="@style/RobotoMonoRegular"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</com.google.android.material.card.MaterialCardView>
