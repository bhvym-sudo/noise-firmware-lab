<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:tag="layout/fragment_report_issue_0"
    android:background="@color/white"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.coordinatorlayout.widget.CoordinatorLayout
        android:id="@+id/coordinator"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toTopOf="@+id/btnSubmit"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <com.google.android.material.appbar.AppBarLayout
            android:id="@+id/appbar_lyt"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <com.google.android.material.appbar.CollapsingToolbarLayout
                android:id="@+id/collapsingToolbar"
                android:background="@color/white"
                android:layout_width="match_parent"
                android:layout_height="?attr/collapsingToolbarLayoutMediumSize"
                app:collapsedTitleTextAppearance="@style/CollapsedToolbarTitle"
                app:contentScrim="@color/white"
                app:expandedTitleMarginStart="24dp"
                app:expandedTitleTextAppearance="@style/ExpandedToolbarTitle"
                app:layout_scrollFlags="snap|exitUntilCollapsed|scroll"
                app:maxLines="2"
                app:statusBarScrim="@color/white"
                app:title="@string/text_report_an_issue"
                style="?attr/collapsingToolbarLayoutMediumStyle">
                <com.google.android.material.appbar.MaterialToolbar
                    android:id="@+id/toolbar"
                    android:background="@color/white"
                    android:layout_width="match_parent"
                    android:layout_height="?attr/actionBarSize"
                    android:elevation="0dp"
                    app:layout_collapseMode="pin"
                    app:navigationIcon="0x7f080244"/>
            </com.google.android.material.appbar.CollapsingToolbarLayout>
        </com.google.android.material.appbar.AppBarLayout>
        <androidx.core.widget.NestedScrollView
            android:paddingBottom="16dp"
            android:clipToPadding="false"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:layout_behavior="@string/appbar_scrolling_view_behavior">
            <LinearLayout
                android:orientation="vertical"
                android:paddingLeft="16dp"
                android:paddingTop="12dp"
                android:paddingRight="16dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingHorizontal="16dp">
                <TextView
                    android:textSize="14sp"
                    android:textColor="#4c5252"
                    android:id="@+id/tvSubjectLabel"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/text_subject_label"
                    android:textAllCaps="true"
                    style="@style/RobotoMonoRegular"/>
                <FrameLayout
                    android:background="@drawable/bg_input_field_16"
                    android:layout_width="match_parent"
                    android:layout_height="64dp"
                    android:layout_marginTop="8dp">
                    <EditText
                        android:textSize="16sp"
                        android:textColor="#3a414e"
                        android:textColorHint="#879399"
                        android:gravity="start|center_vertical"
                        android:layout_gravity="center_vertical"
                        android:id="@+id/etSubject"
                        android:background="@null"
                        android:paddingTop="16dp"
                        android:paddingBottom="16dp"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="@string/text_subject_hint"
                        android:maxLines="1"
                        android:maxLength="50"
                        android:inputType="textCapSentences"
                        android:imeOptions="actionNext"
                        android:paddingStart="16dp"
                        android:paddingEnd="16dp"
                        style="@style/ClashDisplayVariableMedium"/>
                    <TextView
                        android:textSize="10sp"
                        android:textColor="#879399"
                        android:layout_gravity="end|bottom"
                        android:id="@+id/tvSubjectCount"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="8dp"
                        android:text="0/50"
                        android:layout_marginEnd="16dp"
                        style="@style/RobotoMonoRegular"/>
                </FrameLayout>
                <TextView
                    android:textSize="14sp"
                    android:textColor="#4c5252"
                    android:id="@+id/tvDescriptionLabel"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="@string/text_description_label"
                    android:textAllCaps="true"
                    style="@style/RobotoMonoRegular"/>
                <FrameLayout
                    android:background="@drawable/bg_input_field_18"
                    android:layout_width="match_parent"
                    android:layout_height="178dp"
                    android:layout_marginTop="8dp">
                    <EditText
                        android:textSize="16sp"
                        android:textColor="#3a414e"
                        android:textColorHint="#879399"
                        android:gravity="start|top"
                        android:id="@+id/etDescription"
                        android:background="@null"
                        android:paddingTop="17dp"
                        android:paddingBottom="28dp"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:hint="@string/text_description_hint"
                        android:maxLength="300"
                        android:inputType="textMultiLine"
                        android:imeOptions="actionDone"
                        android:paddingStart="16dp"
                        android:paddingEnd="16dp"
                        style="@style/ClashDisplayVariableMedium"/>
                    <TextView
                        android:textSize="10sp"
                        android:textColor="#879399"
                        android:layout_gravity="end|bottom"
                        android:id="@+id/tvDescCount"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="8dp"
                        android:text="0/300"
                        android:layout_marginEnd="16dp"
                        style="@style/RobotoMonoRegular"/>
                </FrameLayout>
                <HorizontalScrollView
                    android:id="@+id/scrollThumbnails"
                    android:visibility="gone"
                    android:scrollbars="none"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp">
                    <LinearLayout
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:id="@+id/lytAttachments"
                        android:layout_width="wrap_content"
                        android:layout_height="80dp"/>
                </HorizontalScrollView>
                <LinearLayout
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:id="@+id/lytAddMedia"
                    android:background="@drawable/back_card_v2"
                    android:layout_width="match_parent"
                    android:layout_height="72dp"
                    android:layout_marginTop="12dp"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp">
                    <ImageView
                        android:background="@drawable/ic_ring_v2"
                        android:padding="12dp"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:src="@drawable/ic_add_media"
                        app:tint="#54656d"/>
                    <TextView
                        android:textSize="16sp"
                        android:textColor="#54656d"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:text="@string/text_add_screenshot_recording"
                        android:layout_weight="1"
                        android:layout_marginStart="16dp"
                        style="@style/ClashDisplayVariableMedium"/>
                    <ImageView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:src="@drawable/ic_arrow_right_black_icon"/>
                </LinearLayout>
                <TextView
                    android:textSize="12sp"
                    android:textColor="#879399"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/text_upload_hint"
                    style="@style/RobotoMonoRegular"/>
            </LinearLayout>
        </androidx.core.widget.NestedScrollView>
    </androidx.coordinatorlayout.widget.CoordinatorLayout>
    <TextView
        android:enabled="false"
        android:textSize="14sp"
        android:textColor="#ffffff"
        android:gravity="center"
        android:id="@+id/btnSubmit"
        android:background="@drawable/btn_submit_report"
        android:layout_width="0dp"
        android:layout_height="56dp"
        android:layout_marginBottom="16dp"
        android:text="@string/text_submit"
        android:textAllCaps="true"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        app:layout_constraintBottom_toTopOf="@+id/tvLogNote"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        style="@style/RobotoMonoRegular"/>
    <TextView
        android:textSize="12sp"
        android:textColor="#54656d"
        android:gravity="center"
        android:id="@+id/tvLogNote"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        android:text="@string/text_recent_app_logs_note"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        style="@style/RobotoMonoRegular"/>
    <include
        android:id="@+id/progressBar"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        layout="@layout/default_loader"/>
</androidx.constraintlayout.widget.ConstraintLayout>
