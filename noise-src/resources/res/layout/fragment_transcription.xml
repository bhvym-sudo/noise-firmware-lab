<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/white"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/topBar"
        android:background="@color/white"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <ImageView
            android:id="@+id/btnBack"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:padding="14dp"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:src="0x7f080244"
            android:contentDescription="@string/text_back"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:id="@+id/lytTimerPill"
            android:background="@drawable/bg_timer_pill_green"
            android:paddingLeft="12dp"
            android:paddingTop="6dp"
            android:paddingRight="12dp"
            android:paddingBottom="6dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingHorizontal="12dp"
            android:paddingVertical="6dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">
            <ImageView
                android:id="@+id/ivBolt"
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:src="@drawable/ic_bolt_filled"
                app:tint="#3ca94e"/>
            <TextView
                android:textSize="12sp"
                android:textStyle="bold"
                android:textColor="#1b1b1b"
                android:id="@+id/tvTimerLeft"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                style="@style/RobotoMonoMedium"/>
        </LinearLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@+id/lytTabs"
        android:background="@drawable/bg_tab_container"
        android:padding="4dp"
        android:layout_width="wrap_content"
        android:layout_height="44dp"
        android:layout_marginTop="8dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/topBar">
        <TextView
            android:textSize="12sp"
            android:textStyle="bold"
            android:textColor="#ffffff"
            android:gravity="center"
            android:id="@+id/tabTranscription"
            android:background="@drawable/bg_tab_selected_pill"
            android:paddingLeft="24dp"
            android:paddingRight="24dp"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:text="@string/text_tab_transcription"
            android:textAllCaps="true"
            android:paddingHorizontal="24dp"
            style="@style/RobotoMonoMedium"/>
        <TextView
            android:enabled="false"
            android:textSize="12sp"
            android:textStyle="bold"
            android:textColor="#43555e"
            android:gravity="center"
            android:id="@+id/tabSummarise"
            android:background="@android:color/transparent"
            android:paddingLeft="24dp"
            android:paddingRight="24dp"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:text="@string/text_tab_summarise"
            android:alpha="0.4"
            android:textAllCaps="true"
            android:paddingHorizontal="24dp"
            style="@style/RobotoMonoMedium"/>
    </LinearLayout>
    <androidx.core.widget.NestedScrollView
        android:id="@+id/scrollTranscript"
        android:paddingLeft="20dp"
        android:paddingRight="20dp"
        android:paddingBottom="24dp"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="16dp"
        android:fillViewport="true"
        android:paddingHorizontal="20dp"
        app:layout_constraintBottom_toTopOf="@+id/lytPlayer"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/lytTabs">
        <TextView
            android:textSize="16sp"
            android:textColor="#43555e"
            android:id="@+id/tvTranscript"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:lineSpacingExtra="4sp"
            android:textIsSelectable="true"
            style="@style/RobotoMonoRegular"/>
    </androidx.core.widget.NestedScrollView>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/lytPlayer"
        android:background="@drawable/bg_player_container"
        android:paddingLeft="20dp"
        android:paddingTop="16dp"
        android:paddingRight="20dp"
        android:paddingBottom="20dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="20dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">
        <TextView
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="#1b1b1b"
            android:id="@+id/tvElapsed"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            style="@style/RobotoMonoMedium"/>
        <com.noise.audio.ui.ai.transcribews.WaveformView
            android:id="@+id/waveform"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="8dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tvElapsed"/>
        <TextView
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="#ffffff"
            android:gravity="center"
            android:id="@+id/btnStart"
            android:background="@drawable/back_black_cta"
            android:focusable="true"
            android:visibility="gone"
            android:clickable="true"
            android:layout_width="0dp"
            android:layout_height="56dp"
            android:layout_marginTop="16dp"
            android:foreground="?attr/selectableItemBackground"
            android:text="@string/text_start_caps"
            android:textAllCaps="true"
            android:layout_marginStart="68dp"
            android:layout_marginEnd="68dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/waveform"
            style="@style/RobotoMonoMedium"/>
        <TextView
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="#ffffff"
            android:gravity="center"
            android:id="@+id/btnStop"
            android:background="@drawable/back_black_cta"
            android:focusable="true"
            android:visibility="gone"
            android:clickable="true"
            android:layout_width="0dp"
            android:layout_height="56dp"
            android:layout_marginTop="16dp"
            android:foreground="?attr/selectableItemBackground"
            android:text="@string/text_stop_caps"
            android:textAllCaps="true"
            android:layout_marginStart="68dp"
            android:layout_marginEnd="68dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/waveform"
            style="@style/RobotoMonoMedium"/>
        <ImageView
            android:id="@+id/btnPause"
            android:background="@drawable/bg_circle_outline"
            android:padding="16dp"
            android:focusable="true"
            android:visibility="gone"
            android:clickable="true"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:layout_marginTop="16dp"
            android:src="@drawable/ic_pause_music"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/waveform"/>
        <ImageView
            android:id="@+id/btnStartOver"
            android:background="@drawable/bg_circle_outline"
            android:padding="14dp"
            android:focusable="true"
            android:visibility="gone"
            android:clickable="true"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:layout_marginTop="16dp"
            android:src="@drawable/ic_replay"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/waveform"/>
        <TextView
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="#ffffff"
            android:gravity="center"
            android:id="@+id/btnResume"
            android:background="@drawable/back_black_cta"
            android:focusable="true"
            android:visibility="gone"
            android:clickable="true"
            android:layout_width="0dp"
            android:layout_height="56dp"
            android:layout_marginLeft="12dp"
            android:layout_marginTop="16dp"
            android:layout_marginRight="12dp"
            android:foreground="?attr/selectableItemBackground"
            android:text="@string/text_resume_caps"
            android:textAllCaps="true"
            android:layout_marginHorizontal="12dp"
            app:layout_constraintEnd_toStartOf="@+id/btnStopRound"
            app:layout_constraintStart_toEndOf="@+id/btnStartOver"
            app:layout_constraintTop_toBottomOf="@+id/waveform"
            style="@style/RobotoMonoMedium"/>
        <ImageView
            android:id="@+id/btnStopRound"
            android:background="@drawable/bg_circle_outline"
            android:padding="18dp"
            android:focusable="true"
            android:visibility="gone"
            android:clickable="true"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:layout_marginTop="16dp"
            android:src="@drawable/ic_stop_square"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/waveform"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
