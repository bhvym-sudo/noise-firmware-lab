<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:gravity="center"
    android:id="@+id/container"
    android:paddingTop="30dp"
    android:visibility="invisible"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <TextView
        android:textSize="@dimen/text_size_22"
        android:textColor="#44565f"
        android:gravity="center_horizontal"
        android:id="@+id/text_title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="@string/text_firmware_update_nfailed"
        android:lineSpacingExtra="2sp"
        android:textAllCaps="true"
        android:letterSpacing="-0.01"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/ClashDisplayVariableSemiBold"/>
    <TextView
        android:textSize="@dimen/text_size_14"
        android:textColor="@color/profile_input_title_color"
        android:gravity="center"
        android:id="@+id/text_sub_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="@string/text_follow_the_steps_from_the_video_below"
        android:textAllCaps="true"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/text_title"
        app:textAllCaps="true"
        style="@style/RobotoMonoRegular"/>
    <ImageView
        android:id="@+id/img_earbud"
        android:padding="@dimen/dimen_20dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="68dp"
        android:adjustViewBounds="true"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/text_sub_title"/>
    <TextView
        android:textSize="@dimen/text_14sp"
        android:textColor="@color/white"
        android:gravity="center"
        android:id="@+id/btnDismiss"
        android:background="@drawable/round_corner_continue_button"
        android:padding="20dp"
        android:visibility="visible"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:layout_marginTop="80dp"
        android:layout_marginBottom="@dimen/dimen_20dp"
        android:text="@string/text_retry"
        android:textAllCaps="true"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/img_earbud"
        style="@style/Sequel100Wide"/>
    <TextView
        android:textSize="@dimen/text_14sp"
        android:textColor="@color/white"
        android:gravity="center"
        android:id="@+id/text_take_home"
        android:background="@drawable/round_corner_title_color"
        android:padding="20dp"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="68dp"
        android:layout_marginTop="20dp"
        android:layout_marginBottom="30dp"
        android:text="@string/take_me_home"
        android:textAllCaps="true"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/btnDismiss"
        style="@style/Sequel100Wide"/>
</androidx.constraintlayout.widget.ConstraintLayout>
