<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <ImageView
        android:id="@+id/imvBudsBg"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:src="@drawable/ic_home_buds_bg_img"
        app:layout_constraintDimensionRatio="1:1"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <ImageView
        android:id="@+id/imageView"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="@+id/imvBudsBg"
        app:layout_constraintDimensionRatio="1:1"
        app:layout_constraintEnd_toEndOf="@+id/imvBudsBg"
        app:layout_constraintStart_toStartOf="@+id/imvBudsBg"
        app:layout_constraintTop_toTopOf="@+id/imvBudsBg"
        app:layout_constraintWidth_percent="0.73"/>
    <TextView
        android:textSize="34dp"
        android:textStyle="normal"
        android:textColor="#54656d"
        android:ellipsize="end"
        android:gravity="center"
        android:id="@+id/tvName"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="78dp"
        android:layout_marginLeft="@dimen/dimen_16dp"
        android:layout_marginRight="@dimen/dimen_16dp"
        android:maxLines="2"
        android:minLines="2"
        android:letterSpacing="0.01"
        android:layout_marginHorizontal="@dimen/dimen_16dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/imvBudsBg"
        style="@style/ClashDisplayVariableMedium"/>
    <include
        android:id="@+id/lytCaseBatteryState"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/imvBudsBg"
        layout="@layout/layout_battery_progress"/>
    <TextView
        android:textColor="#ffffff"
        android:gravity="center"
        android:id="@+id/tvReconnect"
        android:background="@drawable/bg_reconnect_button"
        android:visibility="gone"
        android:layout_width="212dp"
        android:layout_height="52dp"
        android:layout_marginLeft="@dimen/dimen_16dp"
        android:layout_marginTop="12dp"
        android:layout_marginRight="@dimen/dimen_16dp"
        android:text="@string/text_reconnect"
        android:textAllCaps="true"
        android:backgroundTint="#000000"
        android:layout_marginHorizontal="@dimen/dimen_16dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/imvBudsBg"
        style="@style/RobotoMonoRegular"/>
</androidx.constraintlayout.widget.ConstraintLayout>
