<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="horizontal"
    android:background="@drawable/back_anc_level"
    android:padding="2dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <TextView
        android:textSize="12sp"
        android:textStyle="normal"
        android:textColor="#879399"
        android:gravity="center"
        android:id="@+id/tvLow"
        android:layout_width="0dp"
        android:layout_height="28dp"
        android:text="@string/text_low"
        android:layout_weight="1"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="@+id/imvAncLow"
        app:layout_constraintStart_toStartOf="@+id/imvAncLow"
        app:layout_constraintTop_toBottomOf="@+id/imvAncLow"
        style="@style/RobotoMonoRegular"/>
    <TextView
        android:textSize="12sp"
        android:textStyle="normal"
        android:textColor="#879399"
        android:gravity="center"
        android:id="@+id/tvMid"
        android:layout_width="0dp"
        android:layout_height="28dp"
        android:text="@string/text_mid"
        android:layout_weight="1"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="@+id/imvAncLow"
        app:layout_constraintStart_toStartOf="@+id/imvAncLow"
        app:layout_constraintTop_toBottomOf="@+id/imvAncLow"
        style="@style/RobotoMonoRegular"/>
    <TextView
        android:textSize="12sp"
        android:textStyle="normal"
        android:textColor="#879399"
        android:gravity="center"
        android:id="@+id/tvMax"
        android:layout_width="0dp"
        android:layout_height="28dp"
        android:text="@string/text_max"
        android:layout_weight="1"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="@+id/imvAncLow"
        app:layout_constraintStart_toStartOf="@+id/imvAncLow"
        app:layout_constraintTop_toBottomOf="@+id/imvAncLow"
        style="@style/RobotoMonoRegular"/>
    <TextView
        android:textSize="12sp"
        android:textStyle="normal"
        android:textColor="#879399"
        android:gravity="center"
        android:id="@+id/tvAdaptive"
        android:layout_width="0dp"
        android:layout_height="28dp"
        android:text="@string/text_adaptive"
        android:layout_weight="1"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="@+id/imvAncLow"
        app:layout_constraintStart_toStartOf="@+id/imvAncLow"
        app:layout_constraintTop_toBottomOf="@+id/imvAncLow"
        style="@style/RobotoMonoRegular"/>
</LinearLayout>
