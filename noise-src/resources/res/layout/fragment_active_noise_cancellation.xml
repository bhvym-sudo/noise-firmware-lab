<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:gravity="bottom"
    android:orientation="vertical"
    android:paddingBottom="12dp"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:paddingStart="12dp"
    android:paddingEnd="12dp">
    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardBackgroundColor="@color/white"
        app:cardCornerRadius="30dp"
        app:cardElevation="0dp">
        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <androidx.constraintlayout.widget.ConstraintLayout
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:paddingTop="40dp"
                android:paddingBottom="20dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingStart="18dp"
                android:paddingEnd="18dp">
                <TextView
                    android:textSize="@dimen/text_size_22"
                    android:textStyle="bold"
                    android:textColor="#4c5252"
                    android:gravity="center_horizontal"
                    android:id="@+id/textView5"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="@dimen/dimen_40dp"
                    android:layout_marginRight="@dimen/dimen_40dp"
                    android:text="@string/active_noise_cancellation"
                    android:textAllCaps="true"
                    android:letterSpacing="-0.01"
                    android:layout_marginHorizontal="@dimen/dimen_40dp"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    style="@style/ClashDisplayVariableMedium"/>
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/constraintLayout5"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/dimen_24dp"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/textView5">
                    <TextView
                        android:textSize="@dimen/text_14sp"
                        android:textColor="#4d4c5252"
                        android:gravity="center_horizontal"
                        android:id="@+id/tvAncType"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textAllCaps="true"
                        android:letterSpacing="-0.01"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        style="@style/ClashDisplayVariableRegular"/>
                    <TextView
                        android:textSize="@dimen/text_14sp"
                        android:textColor="#978c74"
                        android:gravity="center_horizontal"
                        android:id="@+id/tvAncStatus"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textAllCaps="true"
                        android:layout_marginStart="@dimen/dimen_2dp"
                        android:letterSpacing="-0.01"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toEndOf="@+id/tvAncType"
                        app:layout_constraintTop_toTopOf="parent"
                        style="@style/ClashDisplayVariableMedium"/>
                </androidx.constraintlayout.widget.ConstraintLayout>
                <com.airbnb.lottie.LottieAnimationView
                    android:id="@+id/defaultAnim"
                    android:layout_width="match_parent"
                    android:layout_height="300dp"
                    android:scaleType="centerCrop"
                    app:layout_constraintBottom_toBottomOf="@+id/imageOverlayAnim"
                    app:layout_constraintEnd_toEndOf="@+id/imageOverlayAnim"
                    app:layout_constraintStart_toStartOf="@+id/imageOverlayAnim"
                    app:layout_constraintTop_toTopOf="@+id/imageOverlayAnim"
                    app:lottie_autoPlay="true"
                    app:lottie_loop="false"
                    app:lottie_rawRes="@raw/lottie_anc_on"/>
                <ImageView
                    android:id="@+id/imageOverlayAnim"
                    android:padding="@dimen/dimen_8dp"
                    android:layout_width="300dp"
                    android:layout_height="300dp"
                    android:layout_marginTop="34dp"
                    android:src="0x7f08022b"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/constraintLayout5"/>
                <ImageView
                    android:id="@+id/imvMask"
                    android:visibility="visible"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:src="@drawable/bg_video_mask_video"
                    app:layout_constraintBottom_toBottomOf="@+id/defaultAnim"
                    app:layout_constraintEnd_toEndOf="@+id/defaultAnim"
                    app:layout_constraintStart_toStartOf="@+id/defaultAnim"
                    app:layout_constraintTop_toTopOf="@+id/defaultAnim"/>
                <LinearLayout
                    android:gravity="center"
                    android:id="@+id/linearLayout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp"
                    app:layout_constraintBottom_toTopOf="@+id/label_adjust_level"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent">
                    <com.noise.audio.customviews.NoiseImageButton
                        android:id="@+id/btn_anc_off"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        app:drawable="0x7f08008e"
                        app:selected="false"
                        app:selected_drawable="0x7f08008f"
                        app:show_title="false"
                        app:text="ANC_OFF"/>
                    <com.noise.audio.customviews.NoiseImageButton
                        android:id="@+id/btn_anc_on"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        app:drawable="0x7f08008c"
                        app:selected="false"
                        app:selected_drawable="0x7f08008d"
                        app:show_title="false"
                        app:text="ANC_ON"/>
                    <com.noise.audio.customviews.NoiseImageButton
                        android:id="@+id/btn_transparency_on"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        app:drawable="0x7f080089"
                        app:selected="false"
                        app:selected_drawable="0x7f08008a"
                        app:show_title="false"
                        app:text="TRANSPARENCY"/>
                </LinearLayout>
                <TextView
                    android:textColor="@color/black"
                    android:id="@+id/label_adjust_level"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="10dp"
                    android:text="@string/adjust_anc_levels"
                    android:textAllCaps="true"
                    android:letterSpacing="0.06"
                    app:layout_constraintBottom_toTopOf="@+id/ancTrack"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    style="@style/RobotoMonoRegular"/>
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/ancTrack"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="24dp"
                    app:layout_constraintBottom_toTopOf="@+id/text_save_adjustment"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent">
                    <TextView
                        android:textSize="@dimen/text_14sp"
                        android:textColor="@color/anc_unselected"
                        android:id="@+id/tvLow"
                        android:padding="@dimen/dimen_4dp"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/text_low_cap"
                        android:letterSpacing="-0.01"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toStartOf="@+id/tvMedium"
                        app:layout_constraintHorizontal_bias="0.5"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        style="@style/ClashDisplayVariableRegular"/>
                    <TextView
                        android:textSize="@dimen/text_14sp"
                        android:textColor="@color/anc_selected"
                        android:id="@+id/tvMedium"
                        android:padding="@dimen/dimen_4dp"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/text_medium_cap"
                        android:letterSpacing="-0.01"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toStartOf="@+id/tvHigh"
                        app:layout_constraintHorizontal_bias="0.5"
                        app:layout_constraintStart_toEndOf="@+id/tvLow"
                        app:layout_constraintTop_toTopOf="parent"
                        style="@style/ClashDisplayVariableRegular"/>
                    <TextView
                        android:textSize="@dimen/text_14sp"
                        android:textColor="#978c74"
                        android:id="@+id/tvHigh"
                        android:padding="@dimen/dimen_4dp"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/text_high_cap"
                        android:letterSpacing="-0.01"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintHorizontal_bias="0.5"
                        app:layout_constraintStart_toEndOf="@+id/tvMedium"
                        app:layout_constraintTop_toTopOf="parent"
                        style="@style/ClashDisplayVariableRegular"/>
                </androidx.constraintlayout.widget.ConstraintLayout>
                <com.noise.audio.customviews.NoiseTextView
                    android:textSize="@dimen/text_14sp"
                    android:textStyle="bold"
                    android:textColor="@color/dark_color"
                    android:gravity="center"
                    android:id="@+id/text_save_adjustment"
                    android:background="@drawable/round_corner_action_bg"
                    android:padding="20dp"
                    android:layout_width="match_parent"
                    android:layout_height="70dp"
                    android:layout_marginTop="160dp"
                    android:text="@string/text_save_adjustments"
                    android:textAllCaps="true"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/defaultAnim"
                    style="@style/ClashDisplayVariableRegular"/>
            </androidx.constraintlayout.widget.ConstraintLayout>
        </ScrollView>
        <include
            android:id="@+id/progressBar"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            layout="@layout/default_loader"/>
    </androidx.cardview.widget.CardView>
</LinearLayout>
