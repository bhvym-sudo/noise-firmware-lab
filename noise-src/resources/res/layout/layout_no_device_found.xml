<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/noDeviceFoundContainer"
    android:background="@color/white"
    android:visibility="gone"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ImageView
        android:id="@+id/ivBackNoDevice"
        android:padding="@dimen/dimen_8dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="0x7f080244"
        android:layout_marginStart="20dp"
        app:layout_constraintBottom_toBottomOf="@+id/tvNoDeviceTitle"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/tvNoDeviceTitle"/>
    <TextView
        android:textSize="24sp"
        android:textColor="#43555e"
        android:gravity="center_horizontal"
        android:id="@+id/tvNoDeviceTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="32dp"
        android:text="@string/text_no_device_found"
        android:textAllCaps="true"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/ClashDisplayVariableSemiBold"/>
    <TextView
        android:textSize="14sp"
        android:textColor="#4c5252"
        android:ellipsize="end"
        android:gravity="center_horizontal"
        android:id="@+id/tvNoDeviceMessage"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginLeft="32dp"
        android:layout_marginTop="8dp"
        android:layout_marginRight="32dp"
        android:maxLines="5"
        android:textAllCaps="true"
        android:letterSpacing="0.02"
        android:layout_marginHorizontal="32dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tvNoDeviceTitle"
        style="@style/RobotoMonoRegular"/>
    <View
        android:id="@+id/circleBackground"
        android:background="@drawable/bg_circle_light_grey"
        android:layout_width="240dp"
        android:layout_height="240dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <ImageView
        android:id="@+id/ivRetryIcon"
        android:background="@drawable/bg_circle_white"
        android:padding="12dp"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:src="@drawable/ic_replay"
        app:layout_constraintBottom_toBottomOf="@+id/circleBackground"
        app:layout_constraintEnd_toEndOf="@+id/circleBackground"
        app:layout_constraintStart_toStartOf="@+id/circleBackground"
        app:layout_constraintTop_toTopOf="@+id/circleBackground"/>
    <TextView
        android:textSize="14sp"
        android:textColor="#4c5252"
        android:id="@+id/tvUnableText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp"
        android:text="@string/text_unable_to_find_device2"
        app:layout_constraintBottom_toTopOf="@+id/btnScanAgain"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        style="@style/RobotoMonoRegular"/>
    <com.noise.audio.customviews.NoiseButtonView
        android:textSize="14sp"
        android:textColor="@color/white"
        android:gravity="center"
        android:id="@+id/btnScanAgain"
        android:background="@drawable/round_corner_continue_button"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginLeft="16dp"
        android:layout_marginRight="16dp"
        android:layout_marginBottom="8dp"
        android:text="@string/text_scan_again"
        android:textAllCaps="true"
        android:backgroundTint="@null"
        android:layout_marginHorizontal="16dp"
        app:backgroundTint="@null"
        app:layout_constraintBottom_toTopOf="@+id/tvGetHelp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:textAllCaps="true"
        style="@style/RobotoMonoRegular"/>
    <TextView
        android:textSize="14sp"
        android:textColor="#131414"
        android:id="@+id/tvGetHelp"
        android:padding="@dimen/dimen_8dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="24dp"
        android:text="@string/text_get_help"
        android:textAllCaps="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        style="@style/RobotoMonoRegular"/>
</androidx.constraintlayout.widget.ConstraintLayout>
