<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/back_modal_light_black"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <TextView
        android:textColor="#99ffffff"
        android:id="@+id/tvTitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dimen_16dp"
        android:text="@string/text_your_device_is_in_french"
        android:layout_marginStart="@dimen/dimen_24dp"
        android:layout_marginEnd="@dimen/dimen_8dp"
        app:layout_constraintEnd_toStartOf="@+id/btnChanger"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textSize="@dimen/text_16sp"
        android:textColor="@color/white"
        android:id="@+id/tvDescription"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/dimen_16dp"
        android:text="@string/text_shall_we_switch_the_app_to_french_too"
        android:fontFamily="@font/clash_display_medium"
        android:layout_marginEnd="@dimen/dimen_8dp"
        android:letterSpacing="0.04"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/btnChanger"
        app:layout_constraintStart_toStartOf="@+id/tvTitle"
        app:layout_constraintTop_toBottomOf="@+id/tvTitle"/>
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnChanger"
        android:background="@drawable/round_corner_changer_button"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/text_changer"
        android:textAllCaps="true"
        android:fontFamily="@font/roboto_mono_medium"
        android:layout_marginEnd="@dimen/dimen_16dp"
        app:backgroundTint="@null"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
