<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="horizontal"
    android:id="@+id/container"
    android:background="@drawable/back_alert_nudge"
    android:paddingLeft="6dp"
    android:paddingRight="6dp"
    android:layout_width="match_parent"
    android:layout_height="28dp"
    android:layout_weight="3"
    android:paddingHorizontal="6dp">
    <RelativeLayout
        android:layout_gravity="center_vertical"
        android:id="@+id/circleContainer"
        android:layout_width="18dp"
        android:layout_height="18dp"
        android:layout_marginTop="6dp"
        android:layout_marginBottom="6dp"
        android:layout_marginVertical="6dp">
        <ImageView
            android:background="@drawable/back_alert_icon"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
        <ImageView
            android:id="@+id/imvAlertIcon"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_margin="4dp"
            android:src="@drawable/ic_anc_off_blue"
            android:layout_centerHorizontal="true"
            android:layout_centerVertical="true"
            app:tint="@color/white"/>
    </RelativeLayout>
    <TextView
        android:textSize="12sp"
        android:textStyle="normal"
        android:textColor="#ffffff"
        android:ellipsize="marquee"
        android:layout_gravity="center_vertical"
        android:id="@+id/tvAlert"
        android:focusable="true"
        android:focusableInTouchMode="true"
        android:fadingEdge="horizontal"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="8dp"
        android:layout_marginRight="8dp"
        android:text="@string/text_unable_to_connect_to_device"
        android:scrollHorizontally="true"
        android:singleLine="true"
        android:layout_weight="1"
        android:marqueeRepeatLimit="1"
        android:layout_marginHorizontal="8dp"
        style="@style/RobotoMonoRegular"/>
    <RelativeLayout
        android:layout_gravity="center_vertical"
        android:id="@+id/closeView"
        android:visibility="gone"
        android:layout_width="24dp"
        android:layout_height="24dp">
        <ImageView
            android:layout_width="12dp"
            android:layout_height="12dp"
            android:src="@drawable/dark_circle_grey"
            android:layout_centerHorizontal="true"
            android:layout_centerVertical="true"/>
        <ImageView
            android:id="@+id/imvAlertClose"
            android:layout_width="8dp"
            android:layout_height="8dp"
            android:src="@drawable/ic_clear_grey"
            android:layout_centerHorizontal="true"
            android:layout_centerVertical="true"
            app:tint="@color/white"/>
    </RelativeLayout>
</LinearLayout>
