<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/white"
    android:padding="16dp"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:gravity="center"
        android:orientation="vertical"
        android:id="@+id/linearLayout3"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="32dp"
        android:layout_marginBottom="8dp"
        app:layout_constraintBottom_toTopOf="@+id/btn_continue"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <com.noise.audio.customviews.NoiseLoginTitleBar
            android:id="@+id/title_bar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:show_skip="true"/>
        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <LinearLayout
                android:orientation="vertical"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <TextView
                    android:textSize="14sp"
                    android:textColor="#4c5252"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="24dp"
                    android:text="@string/text_name"
                    android:textAllCaps="true"
                    android:letterSpacing="0.02"
                    style="@style/RobotoMonoRegular"/>
                <EditText
                    android:textSize="20sp"
                    android:textColor="#3a434e"
                    android:textColorHint="#879399"
                    android:gravity="center_vertical"
                    android:id="@+id/etName"
                    android:background="@drawable/back_card_v2"
                    android:padding="16dp"
                    android:layout_width="match_parent"
                    android:layout_height="64dp"
                    android:layout_marginTop="8dp"
                    android:hint="@string/your_name"
                    android:singleLine="true"
                    android:maxLength="50"
                    android:inputType="textCapWords"
                    style="@style/ClashDisplayVariableMedium"/>
                <TextView
                    android:textSize="14sp"
                    android:textColor="#4c5252"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="24dp"
                    android:text="@string/text_date_of_birth_2"
                    android:textAllCaps="true"
                    android:letterSpacing="0.02"
                    style="@style/RobotoMonoRegular"/>
                <TextView
                    android:textSize="20sp"
                    android:textColor="#3a434e"
                    android:textColorHint="#879399"
                    android:gravity="center_vertical"
                    android:id="@+id/editTextDOB"
                    android:background="@drawable/back_card_v2"
                    android:padding="16dp"
                    android:layout_width="match_parent"
                    android:layout_height="64dp"
                    android:layout_marginTop="8dp"
                    android:hint="@string/hint_dd_mm_yy"
                    android:maxLength="10"
                    style="@style/ClashDisplayVariableMedium"/>
                <Space
                    android:layout_width="match_parent"
                    android:layout_height="16dp"/>
            </LinearLayout>
        </ScrollView>
    </LinearLayout>
    <com.noise.audio.customviews.NoiseContinueButton
        android:id="@+id/btn_continue"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        app:layout_constraintBottom_toBottomOf="parent"/>
    <TextView
        android:textSize="14sp"
        android:textColor="#5c6161"
        android:id="@+id/tvSkip"
        android:background="@drawable/bg_skip_2"
        android:paddingLeft="6dp"
        android:paddingTop="4dp"
        android:paddingRight="6dp"
        android:paddingBottom="4dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/text_skip"
        android:textAllCaps="true"
        android:letterSpacing="0.06"
        android:paddingHorizontal="6dp"
        android:paddingVertical="4dp"
        app:layout_constraintEnd_toEndOf="@+id/linearLayout3"
        app:layout_constraintTop_toTopOf="@+id/linearLayout3"
        style="@style/RobotoMonoRegular"/>
    <include
        android:id="@+id/progressBar"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        layout="@layout/default_loader"/>
</androidx.constraintlayout.widget.ConstraintLayout>
