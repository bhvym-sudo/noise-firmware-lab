<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <ImageView
        android:id="@+id/ivAddAttachment"
        android:visibility="gone"
        android:layout_width="52dp"
        android:layout_height="52dp"
        app:layout_constraintBottom_toBottomOf="@+id/chatEtx"
        app:layout_constraintStart_toStartOf="parent"/>
    <ImageView
        android:id="@+id/imageView47"
        android:background="@drawable/back_chat_message_send"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="@+id/chatEtx"
        app:layout_constraintEnd_toEndOf="@+id/chatEtx"
        app:layout_constraintStart_toStartOf="@+id/chatEtx"
        app:layout_constraintTop_toTopOf="@+id/chatEtx"/>
    <EditText
        android:textSize="14sp"
        android:textColor="@color/black"
        android:textColorHint="#a9a9aa"
        android:id="@+id/chatEtx"
        android:background="@color/transparent"
        android:focusable="true"
        android:focusableInTouchMode="true"
        android:layout_width="0dp"
        android:layout_height="54dp"
        android:hint="@string/text_ask_anything"
        android:maxLines="1"
        android:singleLine="true"
        android:imeOptions="actionSend"
        android:fontFamily="@font/roboto_mono_regular"
        android:paddingStart="16dp"
        android:paddingEnd="54dp"
        android:layout_marginStart="6dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/ivAddAttachment"/>
    <ImageView
        android:id="@+id/btnAudioChat"
        android:padding="8dp"
        android:layout_width="54dp"
        android:layout_height="54dp"
        android:src="@drawable/image_ai_audio"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="@+id/chatEtx"/>
    <ImageView
        android:id="@+id/btnSend"
        android:padding="18dp"
        android:visibility="gone"
        android:layout_width="54dp"
        android:layout_height="54dp"
        android:src="@drawable/ic_ai_send_message_2"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="@+id/chatEtx"
        app:tint="@color/black"/>
</androidx.constraintlayout.widget.ConstraintLayout>
