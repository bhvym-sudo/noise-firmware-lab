<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ImageView
        android:id="@+id/imv_connect_status"
        android:background="@drawable/circle_disconnected"
        android:layout_width="10dp"
        android:layout_height="10dp"
        android:layout_marginEnd="6dp"
        app:layout_constraintBottom_toBottomOf="@+id/tvConnection"
        app:layout_constraintEnd_toStartOf="@+id/tvConnection"
        app:layout_constraintTop_toTopOf="@+id/tvConnection"/>
    <TextView
        android:textSize="@dimen/text_14sp"
        android:textColor="#242a36"
        android:id="@+id/tvConnection"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textAllCaps="true"
        android:letterSpacing="0.06"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/RobotoMonoRegular"/>
    <TextView
        android:textSize="34sp"
        android:textColor="#43555e"
        android:ellipsize="end"
        android:gravity="center_horizontal"
        android:id="@+id/tvName"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/dimen_16dp"
        android:layout_marginTop="10dp"
        android:layout_marginRight="@dimen/dimen_16dp"
        android:maxLines="2"
        android:lineSpacingExtra="3sp"
        android:textAllCaps="true"
        android:letterSpacing="-0.01"
        android:layout_marginHorizontal="@dimen/dimen_16dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tvConnection"
        style="@style/ClashDisplayVariableMedium"/>
</androidx.constraintlayout.widget.ConstraintLayout>
