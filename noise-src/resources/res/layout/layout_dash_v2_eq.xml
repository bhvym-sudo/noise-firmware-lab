<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="96dp"
    app:cardBackgroundColor="#f7f7f7"
    app:cardCornerRadius="18dp"
    app:strokeColor="@color/transparent">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/constraintLayout8"
        android:background="0x7f0800b2"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <TextView
            android:textSize="16sp"
            android:textStyle="normal"
            android:textColor="@color/card_title_color"
            android:id="@+id/tvMessage"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="@string/text_equaliser"
            android:layout_marginStart="24dp"
            android:layout_marginEnd="16dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/backBlack"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            style="@style/ClashDisplayVariableMedium"/>
        <ImageView
            android:id="@+id/backBlack"
            android:background="@drawable/round_corner_action_black_8"
            android:layout_width="146dp"
            android:layout_height="44dp"
            android:layout_marginTop="24dp"
            android:layout_marginBottom="24dp"
            android:layout_marginEnd="24dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <TextView
            android:textSize="14sp"
            android:textColor="@color/white"
            android:gravity="center"
            android:id="@+id/tvEqValue"
            android:visibility="gone"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:singleLine="true"
            app:layout_constraintBottom_toBottomOf="@+id/backBlack"
            app:layout_constraintEnd_toEndOf="@+id/backBlack"
            app:layout_constraintStart_toStartOf="@+id/backBlack"
            app:layout_constraintTop_toTopOf="@+id/backBlack"
            style="@style/RobotoMonoRegular"/>
        <ImageView
            android:id="@+id/ivSoundByBose"
            android:visibility="gone"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:src="0x7f0803f9"
            app:layout_constraintBottom_toBottomOf="@+id/backBlack"
            app:layout_constraintEnd_toEndOf="@+id/backBlack"
            app:layout_constraintStart_toStartOf="@+id/backBlack"
            app:layout_constraintTop_toTopOf="@+id/backBlack"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</com.google.android.material.card.MaterialCardView>
