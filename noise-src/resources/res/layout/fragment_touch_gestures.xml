<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:gravity="bottom"
    android:orientation="vertical"
    android:paddingBottom="12dp"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:paddingStart="12dp"
    android:paddingEnd="12dp">
    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardBackgroundColor="@color/white"
        app:cardCornerRadius="30dp"
        app:cardElevation="0dp">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:gravity="center"
            android:paddingTop="40dp"
            android:paddingBottom="20dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <TextView
                android:textSize="@dimen/text_size_22"
                android:textColor="#4c5252"
                android:gravity="center_horizontal"
                android:id="@+id/text_title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginLeft="@dimen/dimen_40dp"
                android:layout_marginRight="@dimen/dimen_40dp"
                android:text="@string/touch_gestures_customization"
                android:textAllCaps="true"
                android:letterSpacing="-0.01"
                android:layout_marginHorizontal="@dimen/dimen_40dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:textAllCaps="true"
                style="@style/ClashDisplayVariableMedium"/>
            <ImageView
                android:id="@+id/imvLeftEarBud"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="68dp"
                android:src="0x7f0800f3"
                android:layout_marginStart="20dp"
                app:layout_constraintEnd_toEndOf="@+id/label_left"
                app:layout_constraintStart_toStartOf="@+id/btn_left_customize"
                app:layout_constraintTop_toBottomOf="@+id/text_title"/>
            <ImageView
                android:id="@+id/imvRightEarBud"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="68dp"
                android:src="0x7f0800fb"
                app:layout_constraintEnd_toEndOf="@+id/btn_right_customize"
                app:layout_constraintStart_toStartOf="@+id/btn_right_customize"
                app:layout_constraintTop_toBottomOf="@+id/text_title"/>
            <TextView
                android:textSize="@dimen/text_14sp"
                android:textColor="@color/widget_title_color"
                android:id="@+id/label_left"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/text_left"
                app:layout_constraintEnd_toStartOf="@+id/label_right"
                app:layout_constraintHorizontal_bias="0.5"
                app:layout_constraintHorizontal_chainStyle="spread"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/imvLeftEarBud"
                style="@style/ClashDisplayVariableMedium"/>
            <TextView
                android:textSize="@dimen/text_14sp"
                android:textColor="@color/widget_title_color"
                android:id="@+id/label_right"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/text_right"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintHorizontal_bias="0.5"
                app:layout_constraintStart_toEndOf="@+id/label_left"
                app:layout_constraintTop_toTopOf="@+id/label_left"
                style="@style/ClashDisplayVariableMedium"/>
            <TextView
                android:textSize="@dimen/text_12sp"
                android:textColor="#2c3236"
                android:id="@+id/btn_left_customize"
                android:paddingTop="10dp"
                android:paddingBottom="10dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/customize"
                android:drawablePadding="@dimen/dimen_4dp"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:letterSpacing="-0.03"
                app:drawableEndCompat="@drawable/ic_forward"
                app:layout_constraintEnd_toEndOf="@+id/label_left"
                app:layout_constraintStart_toStartOf="@+id/label_left"
                app:layout_constraintTop_toBottomOf="@+id/label_left"
                app:textAllCaps="true"
                style="@style/RobotoMonoRegular"/>
            <TextView
                android:textSize="@dimen/text_12sp"
                android:textColor="#2c3236"
                android:id="@+id/btn_right_customize"
                android:paddingTop="10dp"
                android:paddingBottom="10dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/customize"
                android:drawablePadding="@dimen/dimen_4dp"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:letterSpacing="-0.03"
                app:drawableEndCompat="@drawable/ic_forward"
                app:layout_constraintEnd_toEndOf="@+id/label_right"
                app:layout_constraintStart_toStartOf="@+id/label_right"
                app:layout_constraintTop_toBottomOf="@+id/label_right"
                app:textAllCaps="true"
                style="@style/RobotoMonoRegular"/>
            <com.google.android.material.divider.MaterialDivider
                android:id="@+id/divider"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="30dp"
                android:alpha="0.1"
                app:dividerColor="#7c7972"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/btn_left_customize"/>
            <TextView
                android:textSize="@dimen/text_size_14"
                android:textColor="@color/dark_gray_color"
                android:id="@+id/text_in_ear_detection"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="42dp"
                android:text="@string/in_ear_detection"
                android:layout_marginStart="20dp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/divider"
                app:textAllCaps="true"
                style="@style/RobotoMonoRegular"/>
            <com.google.android.material.materialswitch.MaterialSwitch
                android:id="@+id/chb_in_ear_detection"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="20dp"
                app:layout_constraintBottom_toBottomOf="@+id/text_in_ear_detection"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="@+id/text_in_ear_detection"
                app:thumbTint="@color/white"
                app:trackDecorationTint="@color/custom_switch_track_color"
                app:trackTint="@color/custom_switch_track_color"
                style="@style/Widget.Material3.CompoundButton.MaterialSwitch"/>
            <TextView
                android:textSize="@dimen/text_14sp"
                android:textStyle="bold"
                android:textColor="@color/dark_color"
                android:gravity="center"
                android:id="@+id/text_save_adjustment"
                android:background="@drawable/round_corner_action_bg"
                android:padding="20dp"
                android:layout_width="match_parent"
                android:layout_height="62dp"
                android:layout_marginTop="48dp"
                android:text="@string/text_save_adjustments"
                android:textAllCaps="true"
                android:layout_marginStart="20dp"
                android:layout_marginEnd="20dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/text_in_ear_detection"
                style="@style/ClashDisplayVariableRegular"/>
            <include
                android:id="@+id/progressBar"
                android:visibility="gone"
                android:layout_width="0dp"
                android:layout_height="0dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                layout="@layout/default_loader"/>
            <androidx.constraintlayout.widget.Group
                android:id="@+id/group"
                android:visibility="visible"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:constraint_referenced_ids="imvLeftEarBud,imvRightEarBud,label_left,label_right,btn_left_customize,btn_right_customize, divider,text_in_ear_detection,chb_in_ear_detection,text_save_adjustment"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.cardview.widget.CardView>
</LinearLayout>
