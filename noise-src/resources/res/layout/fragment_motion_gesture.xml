<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/white"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ImageView
        android:id="@+id/ivBack"
        android:padding="16dp"
        android:layout_width="46dp"
        android:layout_height="46dp"
        android:layout_marginTop="6dp"
        android:src="0x7f080244"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <com.google.android.material.materialswitch.MaterialSwitch
        android:id="@+id/switchMaster"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="@dimen/dimen_16dp"
        app:layout_constraintBottom_toBottomOf="@+id/ivBack"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@+id/ivBack"
        app:thumbTint="@color/white"
        app:trackDecorationTint="@color/custom_switch_track_color"
        app:trackTint="@color/custom_switch_track_color"
        style="@style/Widget.Material3.CompoundButton.MaterialSwitch"/>
    <TextView
        android:textSize="34sp"
        android:textColor="#43555e"
        android:id="@+id/textTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="16dp"
        android:layout_marginRight="16dp"
        android:text="@string/text_motion_ngestures"
        android:textAllCaps="true"
        android:layout_marginHorizontal="16dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/ivBack"
        style="@style/ClashDisplayVariableMedium"/>
    <TextView
        android:textSize="12sp"
        android:textColor="#879399"
        android:id="@+id/textMessage"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="16dp"
        android:layout_marginTop="16dp"
        android:layout_marginRight="16dp"
        android:text="@string/text_motion_ges_message"
        android:layout_marginHorizontal="16dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/textTitle"
        style="@style/RobotoMonoMedium"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginBottom="24dp"
        app:layout_constraintBottom_toTopOf="@+id/btn_noise_control"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/textTitle">
        <androidx.viewpager2.widget.ViewPager2
            android:id="@+id/pager"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="16dp"
            android:layout_marginVertical="16dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <com.google.android.material.tabs.TabLayout
            android:id="@+id/tabLayout"
            android:background="@android:color/transparent"
            android:visibility="visible"
            android:layout_width="wrap_content"
            android:layout_height="2dp"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="34dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/pager"
            app:tabBackground="@drawable/tab_selector"
            app:tabGravity="center"
            app:tabIndicatorFullWidth="false"
            app:tabIndicatorHeight="0dp"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <com.noise.audio.customviews.NoiseImageButton
        android:id="@+id/btn_noise_control"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:drawable="0x7f08030f"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/btn_music_control"
        app:layout_constraintHorizontal_bias="0.5"
        app:layout_constraintHorizontal_chainStyle="spread_inside"
        app:layout_constraintStart_toStartOf="parent"
        app:selected="false"
        app:selected_drawable="0x7f080310"
        app:show_title="true"
        app:text="@string/text_noise_control_2"/>
    <com.noise.audio.customviews.NoiseImageButton
        android:id="@+id/btn_music_control"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="10dp"
        app:drawable="0x7f0802fa"
        app:layout_constraintEnd_toStartOf="@+id/btn_phone_call"
        app:layout_constraintHorizontal_bias="0.5"
        app:layout_constraintStart_toEndOf="@+id/btn_noise_control"
        app:layout_constraintTop_toTopOf="@+id/btn_noise_control"
        app:selected="false"
        app:selected_drawable="0x7f0802fc"
        app:show_title="true"
        app:text="@string/text_music_control_2"/>
    <com.noise.audio.customviews.NoiseImageButton
        android:id="@+id/btn_phone_call"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="10dp"
        app:drawable="0x7f080323"
        app:layout_constraintEnd_toStartOf="@+id/btn_charging_buds"
        app:layout_constraintHorizontal_bias="0.5"
        app:layout_constraintStart_toEndOf="@+id/btn_music_control"
        app:layout_constraintTop_toTopOf="@+id/btn_music_control"
        app:selected="false"
        app:selected_drawable="0x7f080324"
        app:show_title="true"
        app:text="@string/text_phone_call_2"/>
    <com.noise.audio.customviews.NoiseImageButton
        android:id="@+id/btn_charging_buds"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="10dp"
        app:drawable="0x7f08026b"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.5"
        app:layout_constraintStart_toEndOf="@+id/btn_phone_call"
        app:layout_constraintTop_toTopOf="@+id/btn_phone_call"
        app:selected="false"
        app:selected_drawable="0x7f08026c"
        app:show_title="true"
        app:text="@string/text_charging_your_buds_2"/>
</androidx.constraintlayout.widget.ConstraintLayout>
