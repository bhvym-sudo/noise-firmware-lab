<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:gravity="center"
    android:orientation="vertical"
    android:id="@+id/content_layout"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="64dp">
        <EditText
            android:textSize="26sp"
            android:textColor="#302f2d"
            android:gravity="center"
            android:id="@+id/otp_digit_1"
            android:background="@drawable/back_card_v2"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:maxLength="1"
            android:layout_weight="1"
            android:inputType="number"
            android:fontFamily="@font/clash_display_medium"/>
        <EditText
            android:textSize="26sp"
            android:textColor="#302f2d"
            android:gravity="center"
            android:id="@+id/otp_digit_2"
            android:background="@drawable/back_card_v2"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:maxLength="1"
            android:layout_weight="1"
            android:inputType="number"
            android:fontFamily="@font/clash_display_medium"
            android:layout_marginStart="@dimen/dimen_8dp"/>
        <EditText
            android:textSize="26sp"
            android:textColor="#302f2d"
            android:gravity="center"
            android:id="@+id/otp_digit_3"
            android:background="@drawable/back_card_v2"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:maxLength="1"
            android:layout_weight="1"
            android:inputType="number"
            android:fontFamily="@font/clash_display_medium"
            android:layout_marginStart="@dimen/dimen_8dp"/>
        <EditText
            android:textSize="26sp"
            android:textColor="#302f2d"
            android:gravity="center"
            android:id="@+id/otp_digit_4"
            android:background="@drawable/back_card_v2"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:maxLength="1"
            android:layout_weight="1"
            android:inputType="number"
            android:fontFamily="@font/clash_display_medium"
            android:layout_marginStart="@dimen/dimen_8dp"/>
    </LinearLayout>
    <TextView
        android:textColor="#bb1515"
        android:id="@+id/text_error"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:textAllCaps="true"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        style="@style/RobotoMonoRegular"/>
</LinearLayout>
