<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/constraintLayout7"
        android:layout_width="0dp"
        android:layout_height="172dp"
        android:layout_marginTop="12dp"
        android:layout_marginEnd="6dp"
        app:cardBackgroundColor="#f7f7f7"
        app:cardCornerRadius="18dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/constraintLayout8"
        app:layout_constraintHorizontal_bias="0.5"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:strokeColor="@color/transparent">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:padding="16dp"
            android:layout_width="match_parent"
            android:layout_height="172dp">
            <ImageView
                android:id="@+id/ivMore1"
                android:padding="10dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/ic_right_blue_arrow"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
            <ImageView
                android:id="@+id/imv1"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:src="@drawable/ic_new_find_device"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
            <TextView
                android:textSize="16sp"
                android:textStyle="normal"
                android:textColor="@color/card_title_color"
                android:gravity="start"
                android:id="@+id/tvTitle1"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="@string/text_find_my_device"
                android:letterSpacing="-0.01"
                app:layout_constraintBottom_toTopOf="@+id/tvSubText1"
                app:layout_constraintStart_toStartOf="parent"
                style="@style/ClashDisplayVariableMedium"/>
            <TextView
                android:textSize="12sp"
                android:textStyle="normal"
                android:textColor="@color/card_message_color"
                android:ellipsize="end"
                android:id="@+id/tvSubText1"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="@string/text_locate_your_lost_device_in_seconds"
                android:maxLines="3"
                android:letterSpacing="-0.01"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                style="@style/RobotoMonoRegular"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </com.google.android.material.card.MaterialCardView>
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/constraintLayout8"
        android:layout_width="0dp"
        android:layout_height="172dp"
        android:layout_marginTop="12dp"
        android:layout_marginStart="6dp"
        app:cardBackgroundColor="#f7f7f7"
        app:cardCornerRadius="18dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.5"
        app:layout_constraintStart_toEndOf="@+id/constraintLayout7"
        app:layout_constraintTop_toTopOf="parent"
        app:strokeColor="@color/transparent">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:padding="16dp"
            android:layout_width="match_parent"
            android:layout_height="172dp">
            <ImageView
                android:id="@+id/imv2"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:src="@drawable/ic_new_focus_mode"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
            <com.google.android.material.materialswitch.MaterialSwitch
                android:id="@+id/ivSwitch"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:thumbTint="@color/white"
                app:trackDecorationTint="@color/custom_switch_track_color"
                app:trackTint="@color/custom_switch_track_color"
                style="@style/Widget.Material3.CompoundButton.MaterialSwitch"/>
            <TextView
                android:textSize="16sp"
                android:textStyle="normal"
                android:textColor="@color/card_title_color"
                android:gravity="start"
                android:id="@+id/tvTitle2"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="@string/text_focus_mode"
                android:letterSpacing="-0.01"
                app:layout_constraintBottom_toTopOf="@+id/tvSubText2"
                app:layout_constraintStart_toStartOf="parent"
                style="@style/ClashDisplayVariableMedium"/>
            <TextView
                android:textSize="12sp"
                android:textStyle="normal"
                android:textColor="@color/card_message_color"
                android:ellipsize="end"
                android:id="@+id/tvSubText2"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="@string/text_locks_controls_for_focused_listening"
                android:maxLines="3"
                android:letterSpacing="-0.01"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                style="@style/RobotoMonoRegular"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </com.google.android.material.card.MaterialCardView>
</androidx.constraintlayout.widget.ConstraintLayout>
