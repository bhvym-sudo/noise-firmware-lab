<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">
    <ImageView
        android:id="@+id/imvLeftBud"
        android:layout_width="wrap_content"
        android:layout_height="0dp"
        android:layout_marginBottom="48dp"
        android:src="0x7f0800f4"
        app:layout_constraintBottom_toTopOf="@+id/imv_right_earbud"
        app:layout_constraintEnd_toEndOf="@+id/imv_right_earbud"
        app:layout_constraintTop_toTopOf="parent"/>
    <ImageView
        android:id="@+id/imvRightBud"
        android:layout_width="wrap_content"
        android:layout_height="0dp"
        android:layout_marginBottom="48dp"
        android:src="0x7f0800fc"
        app:layout_constraintBottom_toTopOf="@+id/imv_left_earbud"
        app:layout_constraintStart_toStartOf="@+id/imv_left_earbud"
        app:layout_constraintTop_toTopOf="parent"/>
    <com.noise.audio.customviews.NoiseChargingProgressView
        android:id="@+id/left_charge_status"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/dimen_16dp"
        app:label="L"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>
    <ImageView
        android:id="@+id/imv_right_earbud"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="0x7f0802de"
        android:layout_marginStart="@dimen/dimen_16dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toEndOf="@+id/left_charge_status"/>
    <com.noise.audio.customviews.NoiseChargingProgressView
        android:id="@+id/right_charge_status"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="@dimen/dimen_16dp"
        app:label="R"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>
    <ImageView
        android:id="@+id/imv_left_earbud"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="0x7f08034e"
        android:layout_marginStart="@dimen/dimen_56dp"
        android:layout_marginEnd="@dimen/dimen_16dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/right_charge_status"
        app:layout_constraintStart_toEndOf="@+id/imv_right_earbud"/>
</androidx.constraintlayout.widget.ConstraintLayout>
