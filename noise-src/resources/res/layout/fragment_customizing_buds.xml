<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:gravity="bottom"
    android:orientation="vertical"
    android:paddingBottom="12dp"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:paddingStart="12dp"
    android:paddingEnd="12dp">
    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardBackgroundColor="@color/white"
        app:cardCornerRadius="30dp"
        app:cardElevation="0dp">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:id="@+id/container"
            android:paddingBottom="20dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <TextView
                android:textSize="@dimen/text_size_22"
                android:textColor="#4c5252"
                android:gravity="center_horizontal"
                android:id="@+id/text_title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginLeft="@dimen/dimen_40dp"
                android:layout_marginTop="40dp"
                android:layout_marginRight="@dimen/dimen_40dp"
                android:text="@string/active_noise_cancellation"
                android:textAllCaps="true"
                android:letterSpacing="-0.01"
                android:layout_marginHorizontal="@dimen/dimen_40dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                style="@style/ClashDisplayVariableMedium"/>
            <ImageView
                android:id="@+id/img_back"
                android:padding="@dimen/dimen_8dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="40dp"
                android:src="0x7f080244"
                android:layout_marginStart="@dimen/dimen_12dp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:tint="@color/back_arrow_color"/>
            <androidx.media3.ui.PlayerView
                android:id="@+id/videoPlayer"
                android:background="@android:color/transparent"
                android:visibility="invisible"
                android:layout_width="match_parent"
                android:layout_height="320dp"
                android:layout_marginTop="@dimen/dimen_16dp"
                app:layout_constraintDimensionRatio="1:1"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/text_title"
                app:show_buffering="never"
                app:show_subtitle_button="false"
                app:shutter_background_color="@android:color/transparent"
                app:surface_type="texture_view"
                app:use_controller="false"/>
            <ImageView
                android:id="@+id/imvMask"
                android:visibility="gone"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:src="@drawable/bg_video_mask_video"
                app:layout_constraintBottom_toBottomOf="@+id/videoPlayer"
                app:layout_constraintEnd_toEndOf="@+id/videoPlayer"
                app:layout_constraintStart_toStartOf="@+id/videoPlayer"
                app:layout_constraintTop_toTopOf="@+id/videoPlayer"/>
            <com.noise.audio.customviews.NoiseImageButton
                android:id="@+id/btn_tap_one"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dimen_16dp"
                android:layout_marginStart="16dp"
                app:drawable="0x7f08038a"
                app:layout_constraintEnd_toStartOf="@+id/btn_tap_twice"
                app:layout_constraintHorizontal_bias="0.5"
                app:layout_constraintHorizontal_chainStyle="spread_inside"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/videoPlayer"
                app:selected="false"
                app:selected_drawable="0x7f08038b"
                app:show_title="true"
                app:text="@string/text_tap_one"
                app:text_color="#4c5252"/>
            <com.noise.audio.customviews.NoiseImageButton
                android:id="@+id/btn_tap_twice"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                app:drawable="0x7f08038e"
                app:layout_constraintEnd_toStartOf="@+id/btn_tap_thrice"
                app:layout_constraintHorizontal_bias="0.5"
                app:layout_constraintStart_toEndOf="@+id/btn_tap_one"
                app:layout_constraintTop_toTopOf="@+id/btn_tap_one"
                app:selected="false"
                app:selected_drawable="0x7f08038f"
                app:show_title="true"
                app:text="@string/text_tap_twice"
                app:text_color="#4c5252"/>
            <com.noise.audio.customviews.NoiseImageButton
                android:id="@+id/btn_tap_thrice"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                app:drawable="0x7f08038c"
                app:layout_constraintEnd_toStartOf="@+id/btn_tap_hold"
                app:layout_constraintHorizontal_bias="0.5"
                app:layout_constraintStart_toEndOf="@+id/btn_tap_twice"
                app:layout_constraintTop_toTopOf="@+id/btn_tap_twice"
                app:selected="false"
                app:selected_drawable="0x7f08038d"
                app:show_title="true"
                app:text="@string/text_tap_thrice"
                app:text_color="#4c5252"/>
            <com.noise.audio.customviews.NoiseImageButton
                android:id="@+id/btn_tap_hold"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="16dp"
                app:drawable="0x7f080388"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintHorizontal_bias="0.5"
                app:layout_constraintStart_toEndOf="@+id/btn_tap_thrice"
                app:layout_constraintTop_toTopOf="@+id/btn_tap_thrice"
                app:selected="false"
                app:selected_drawable="0x7f080389"
                app:show_title="true"
                app:text="@string/text_tap_hold"
                app:text_color="#4c5252"/>
            <com.google.android.material.divider.MaterialDivider
                android:id="@+id/divider"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dimen_24dp"
                android:alpha="0.1"
                app:dividerColor="#7c7972"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/btn_tap_one"/>
            <TextView
                android:textSize="@dimen/text_size_14"
                android:textColor="#4c5252"
                android:id="@+id/label_action"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dimen_24dp"
                android:text="@string/select_an_action_for_tap_amp_hold"
                android:textAllCaps="true"
                android:layout_marginStart="20dp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/divider"
                style="@style/ClashDisplayVariableMedium"/>
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/recycler_view"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dimen_8dp"
                android:layout_marginStart="12dp"
                android:layout_marginEnd="@dimen/dimen_12dp"
                android:nestedScrollingEnabled="false"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/label_action"/>
            <com.noise.audio.customviews.NoiseTextView
                android:textSize="@dimen/text_14sp"
                android:textStyle="bold"
                android:textColor="@color/dark_color"
                android:gravity="center"
                android:id="@+id/text_save_adjustment"
                android:background="@drawable/round_corner_action_bg"
                android:padding="20dp"
                android:layout_width="match_parent"
                android:layout_height="62dp"
                android:layout_marginTop="@dimen/dimen_18dp"
                android:text="@string/text_save_adjustments"
                android:textAllCaps="true"
                android:layout_marginStart="20dp"
                android:layout_marginEnd="20dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/recycler_view"
                style="@style/ClashDisplayVariableRegular"/>
            <androidx.constraintlayout.widget.Group
                android:id="@+id/group"
                android:visibility="visible"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:constraint_referenced_ids="container"/>
            <include
                android:id="@+id/progressBar"
                android:visibility="gone"
                android:layout_width="0dp"
                android:layout_height="0dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                layout="@layout/default_loader"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.cardview.widget.CardView>
</androidx.core.widget.NestedScrollView>
