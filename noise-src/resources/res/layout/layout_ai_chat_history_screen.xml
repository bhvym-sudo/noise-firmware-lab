<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <TextView
        android:textSize="34sp"
        android:textColor="#54656d"
        android:id="@+id/tvNoChatThread"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="@string/text_no_chat_thread_found"
        android:textAlignment="center"
        android:layout_marginStart="@dimen/side_margin"
        android:layout_marginEnd="@dimen/side_margin"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/ClashDisplayVariableMedium"/>
    <TextView
        android:textSize="14sp"
        android:textStyle="bold"
        android:textColor="#090909"
        android:id="@+id/tvStartNewChatBtn"
        android:background="@drawable/start_new_chat_btn_bg"
        android:paddingTop="@dimen/dimen_24dp"
        android:paddingBottom="@dimen/dimen_24dp"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dimen_24dp"
        android:text="@string/text_start_a_new_chat"
        android:textAlignment="center"
        android:layout_marginStart="@dimen/dimen_32dp"
        android:layout_marginEnd="@dimen/dimen_32dp"
        android:paddingVertical="@dimen/dimen_24dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tvNoChatThread"
        style="@style/RobotoMonoRegular"/>
</androidx.constraintlayout.widget.ConstraintLayout>
