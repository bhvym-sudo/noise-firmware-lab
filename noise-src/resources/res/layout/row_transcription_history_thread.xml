<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:background="@drawable/back_modal_light_white"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingStart="12dp">
    <LinearLayout
        android:orientation="vertical"
        android:paddingTop="12dp"
        android:paddingBottom="12dp"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1">
        <TextView
            android:textSize="16sp"
            android:textColor="#4c5252"
            android:ellipsize="end"
            android:id="@+id/tvHeadline"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:maxLines="1"
            style="@style/ClashDisplayVariableMedium"/>
        <TextView
            android:textSize="12sp"
            android:textColor="#879399"
            android:ellipsize="end"
            android:id="@+id/tvPreview"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:maxLines="2"
            style="@style/RobotoMonoRegular"/>
        <TextView
            android:textSize="10sp"
            android:textColor="#4c5252"
            android:id="@+id/tvDate"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            style="@style/RobotoMonoMedium"/>
    </LinearLayout>
    <ImageView
        android:id="@+id/ivArrow"
        android:padding="12dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@drawable/ic_arrow_right_black_icon"/>
    <com.google.android.material.checkbox.MaterialCheckBox
        android:id="@+id/checkSelect"
        android:focusable="false"
        android:visibility="gone"
        android:clickable="false"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="4dp"
        app:buttonTint="@color/black"
        app:strokeColor="@color/checkbox_stroke_color"/>
</LinearLayout>
