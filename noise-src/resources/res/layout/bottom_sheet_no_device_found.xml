<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:tag="layout/bottom_sheet_no_device_found_0"
    android:background="@android:color/transparent"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:background="@drawable/device_failed_to_pair_bg"
        android:paddingLeft="20dp"
        android:paddingTop="32dp"
        android:paddingRight="20dp"
        android:paddingBottom="14dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dimen_12dp"
        android:layout_marginBottom="@dimen/dimen_12dp"
        android:layout_marginStart="@dimen/dimen_12dp"
        android:layout_marginEnd="@dimen/dimen_12dp"
        android:paddingHorizontal="20dp">
        <TextView
            android:textSize="24sp"
            android:textColor="@color/title_color"
            android:gravity="center"
            android:id="@+id/tvTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/text_unable_to_find_device"
            android:textAllCaps="true"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            style="@style/ClashDisplayVariableSemiBold"/>
        <TextView
            android:textSize="14sp"
            android:textColor="@color/title_color"
            android:id="@+id/tvDot1"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="•"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tvTitle"
            style="@style/RobotoMonoRegular"/>
        <TextView
            android:textSize="14sp"
            android:textColor="#4c5252"
            android:id="@+id/tvTip1"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="@string/text_no_device_tip_1"
            android:layout_marginStart="8dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/tvDot1"
            app:layout_constraintTop_toBottomOf="@+id/tvTitle"
            style="@style/RobotoMonoRegular"/>
        <TextView
            android:textSize="14sp"
            android:textColor="@color/title_color"
            android:id="@+id/tvDot2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="•"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tvTip1"
            style="@style/RobotoMonoRegular"/>
        <TextView
            android:textSize="14sp"
            android:textColor="#4c5252"
            android:id="@+id/tvTip2"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/text_no_device_tip_2"
            android:layout_marginStart="8dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/tvDot2"
            app:layout_constraintTop_toBottomOf="@+id/tvTip1"
            style="@style/RobotoMonoRegular"/>
        <TextView
            android:textSize="14sp"
            android:textColor="@color/title_color"
            android:id="@+id/tvDot3"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="•"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tvTip2"
            style="@style/RobotoMonoRegular"/>
        <TextView
            android:textSize="14sp"
            android:textColor="#4c5252"
            android:id="@+id/tvTip3"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/text_no_device_tip_3"
            android:layout_marginStart="8dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/tvDot3"
            app:layout_constraintTop_toBottomOf="@+id/tvTip2"
            style="@style/RobotoMonoRegular"/>
        <TextView
            android:textSize="14sp"
            android:textColor="@color/title_color"
            android:id="@+id/tvDot4"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="•"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tvTip3"
            style="@style/RobotoMonoRegular"/>
        <TextView
            android:textSize="14sp"
            android:textColor="#4c5252"
            android:id="@+id/tvTip4"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/text_no_device_tip_4"
            android:layout_marginStart="8dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/tvDot4"
            app:layout_constraintTop_toBottomOf="@+id/tvTip3"
            style="@style/RobotoMonoRegular"/>
        <com.noise.audio.customviews.NoiseButtonView
            android:textSize="14sp"
            android:textColor="@color/white"
            android:gravity="center"
            android:id="@+id/btnOkay"
            android:background="@drawable/round_corner_continue_button"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="24dp"
            android:text="@string/text_scan_again"
            android:textAllCaps="true"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tvTip4"
            app:textAllCaps="true"
            style="@style/RobotoMonoRegular"/>
        <TextView
            android:textSize="14sp"
            android:textColor="#090909"
            android:id="@+id/tvContactUs"
            android:padding="@dimen/dimen_4dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="@string/text_contact_us"
            android:textAllCaps="true"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/btnOkay"
            style="@style/RobotoMonoMedium"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</RelativeLayout>
