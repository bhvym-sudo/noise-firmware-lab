<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape
            android:shape="rectangle"
            android:useLevel="false"
            android:thickness="1dp">
            <size
                android:height="100dp"
                android:width="100dp"/>
            <corners android:radius="24dp"/>
            <gradient
                android:startColor="#ccdd8ccb"
                android:endColor="#cc668ced"
                android:angle="0"
                android:type="linear"
                android:centerColor="#cc7865e8"/>
        </shape>
    </item>
    <item
        android:top="1dp"
        android:bottom="1dp"
        android:start="1dp"
        android:end="1dp">
        <shape>
            <solid android:color="@color/black"/>
            <corners android:radius="24dp"/>
        </shape>
    </item>
    <item
        android:top="1dp"
        android:bottom="1dp"
        android:start="1dp"
        android:end="1dp">
        <shape>
            <gradient
                android:startColor="#51aa5bff"
                android:endColor="#51406aff"
                android:angle="0"
                android:centerColor="#51491a95"/>
            <corners android:radius="24dp"/>
        </shape>
    </item>
</layer-list>
